@model List<Manufacturing.Models.Shift>

@{
    ViewData["Title"] = "Shift Management";

    var shifts = Model ?? new List<Manufacturing.Models.Shift>();
    int totalShifts = shifts.Count;
    int activeShifts = shifts.Count(s => string.Equals(s.Status, "Active", StringComparison.OrdinalIgnoreCase));
    int inactiveShifts = shifts.Count(s => string.Equals(s.Status, "Inactive", StringComparison.OrdinalIgnoreCase));
    decimal totalCoverageHours = shifts.Where(s => string.Equals(s.Status, "Active", StringComparison.OrdinalIgnoreCase)).Sum(s => s.TotalHours);

    string getStatusBadge(string status)
    {
        if (string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase))
        {
            return "bg-success text-white";
        }
        return "bg-secondary text-white";
    }
}

<div class="container-fluid px-3 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-clock-history text-info me-2"></i>Shift Roster & Schedule Management</h2>
            <p class="text-slate-300 mb-0 opacity-75">Admin Operations: Configure factory shifts, working hours, supervisors, and shift statuses</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-semibold">
                <i class="bi bi-plus-circle-fill me-1"></i> Add New Shift
            </a>
            <a asp-controller="Account" asp-action="Dashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Total Shifts</div>
                            <h3 class="fw-bold mb-0 text-primary">@totalShifts</h3>
                        </div>
                        <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3">
                            <i class="bi bi-clock fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Active Shifts</div>
                            <h3 class="fw-bold mb-0 text-success">@activeShifts</h3>
                        </div>
                        <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                            <i class="bi bi-check-circle-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-secondary">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Inactive Shifts</div>
                            <h3 class="fw-bold mb-0 text-secondary">@inactiveShifts</h3>
                        </div>
                        <div class="p-3 bg-secondary bg-opacity-10 text-secondary rounded-3">
                            <i class="bi bi-pause-circle-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Active Coverage Hours</div>
                            <h3 class="fw-bold mb-0 text-info">@totalCoverageHours.ToString("0.#") hrs</h3>
                        </div>
                        <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                            <i class="bi bi-hourglass-split fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Shifts Data Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-list-task me-2 text-primary"></i>Shift Directory</h5>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 rounded-pill fw-semibold">
                    Total Listed: @totalShifts
                </span>
            </div>
            <div class="input-group" style="max-width: 320px;">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="shiftSearchInput" class="form-control bg-light border-start-0 ps-0" placeholder="Search shift name, code, supervisor..." />
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="shiftTable">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4"># ID</th>
                            <th>Code & Name</th>
                            <th>Working Hours</th>
                            <th>Total Duration</th>
                            <th>Supervisor</th>
                            <th>Description</th>
                            <th class="text-center">Status</th>
                            <th>Created Date</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="shiftTableBody">
                        @if (shifts.Count > 0)
                        {
                            @foreach (var shift in shifts)
                            {
                                <tr class="shift-row">
                                    <td class="ps-4 fw-bold text-muted">#@shift.ShiftId</td>
                                    <td>
                                        <div class="fw-bold text-dark fs-6 shift-name">@shift.ShiftName</div>
                                        <small class="text-primary fw-semibold shift-code"><i class="bi bi-barcode me-1"></i>@shift.ShiftCode</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">
                                            <i class="bi bi-alarm me-1 text-primary"></i>@shift.StartTime.ToString(@"hh\:mm") - @shift.EndTime.ToString(@"hh\:mm")
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-3 py-1 fw-semibold">
                                            <i class="bi bi-hourglass-bottom me-1 text-warning"></i>@shift.TotalHours.ToString("0.#") hrs
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark shift-supervisor">
                                            <i class="bi bi-person-badge-fill me-1 text-secondary"></i>@(string.IsNullOrWhiteSpace(shift.SupervisorName) ? "Unassigned" : shift.SupervisorName)
                                        </div>
                                    </td>
                                    <td>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 200px;" title="@shift.Description">
                                            @(string.IsNullOrWhiteSpace(shift.Description) ? "-" : shift.Description)
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @getStatusBadge(shift.Status) rounded-pill px-3 py-1 fw-medium shift-status">
                                            @shift.Status
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar-event me-1"></i>@(shift.CreatedDate != DateTime.MinValue ? shift.CreatedDate.ToString("dd MMM yyyy") : "-")
                                        </small>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@shift.ShiftId" class="btn btn-outline-primary" title="Edit Shift">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            <a asp-action="ChangeStatus" asp-route-id="@shift.ShiftId" class="btn btn-outline-warning" title="Toggle Status (Active/Inactive)">
                                                <i class="bi bi-arrow-repeat"></i> Toggle Status
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@shift.ShiftId" class="btn btn-outline-danger" title="Delete Shift" onclick="return confirm('Are you sure you want to delete shift @shift.ShiftName (@shift.ShiftCode)?');">
                                                <i class="bi bi-trash-fill"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-clock fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    <h5>No Shifts Registered</h5>
                                    <p class="mb-3">Get started by setting up factory shifts and roster schedules.</p>
                                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
                                        <i class="bi bi-plus-circle-fill me-1"></i> Add New Shift
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('shiftSearchInput');
            const tableRows = document.querySelectorAll('.shift-row');

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const query = this.value.toLowerCase().trim();
                    tableRows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(query) ? '' : 'none';
                    });
                });
            }
        });
    </script>
}
