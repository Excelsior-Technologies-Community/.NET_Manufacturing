@model Manufacturing.Models.MaterialIssue

@{
    ViewData["Title"] = "Issue Raw Material";

    var materialList = ViewBag.MaterialList as List<SelectListItem> ?? new List<SelectListItem>();
    var orderList = ViewBag.OrderList as List<SelectListItem> ?? new List<SelectListItem>();

    var defaultDate = Model?.IssueDate != default && Model?.IssueDate != null 
        ? Model.IssueDate.ToString("yyyy-MM-ddTHH:mm") 
        : DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
}

<div class="container-fluid px-3 py-3">
    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #4338ca 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-indigo px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold" style="background-color: #6366f1;">Material Issue</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Production Manager Portal</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-plus-circle-fill text-indigo-300 me-2 fs-2"></i> Issue Raw Material
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Dispatch raw materials from inventory to an active production order</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Material Issues List
            </a>
        </div>
    </div>

    <!-- Form Card -->
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-file-earmark-plus me-2 text-indigo" style="color: #6366f1;"></i> Material Issue Form
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <input type="hidden" name="MaterialName" value="N/A" />
                        <input type="hidden" name="OrderNo" value="N/A" />
                        <div asp-validation-summary="All" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="ProductionOrderId" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-gear-wide-connected text-primary me-1"></i> Production Order <span class="text-danger">*</span>
                                </label>
                                <select asp-for="ProductionOrderId" class="form-select rounded-3 py-2" asp-items="orderList">
                                    <option value="">-- Select Production Order --</option>
                                </select>
                                <span asp-validation-for="ProductionOrderId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MaterialId" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-boxes text-warning me-1"></i> Raw Material <span class="text-danger">*</span>
                                </label>
                                <select asp-for="MaterialId" class="form-select rounded-3 py-2" asp-items="materialList">
                                    <option value="">-- Select Raw Material --</option>
                                </select>
                                <span asp-validation-for="MaterialId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="IssueQuantity" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-box-seam text-info me-1"></i> Issue Quantity <span class="text-danger">*</span>
                                </label>
                                <input asp-for="IssueQuantity" type="number" min="1" class="form-control rounded-3 py-2" placeholder="e.g. 100" />
                                <span asp-validation-for="IssueQuantity" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="IssueDate" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-calendar-event text-success me-1"></i> Issue Date & Time <span class="text-danger">*</span>
                                </label>
                                <input asp-for="IssueDate" type="datetime-local" value="@defaultDate" class="form-control rounded-3 py-2" />
                                <span asp-validation-for="IssueDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="IssuedBy" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-person-badge text-primary me-1"></i> Issued By (Person / Manager)
                                </label>
                                <input asp-for="IssuedBy" type="text" class="form-control rounded-3 py-2" value="Production Manager" placeholder="e.g. Production Supervisor / Manager Name" />
                                <span asp-validation-for="IssuedBy" class="text-danger small"></span>
                            </div>

                            <!-- Status -->
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-tag text-indigo me-1" style="color: #6366f1;"></i> Status
                                </label>
                                <select asp-for="Status" class="form-select rounded-3 py-2">
                                    <option value="Issued" selected>Issued</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Completed">Completed</option>
                                    <option value="In Progress">In Progress</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Remarks -->
                        <div class="mb-4">
                            <label asp-for="Remarks" class="form-label fw-semibold text-dark">
                                <i class="bi bi-card-text text-secondary me-1"></i> Remarks / Notes
                            </label>
                            <textarea asp-for="Remarks" rows="3" class="form-control rounded-3" placeholder="Add any special notes or batch instructions..."></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>

                        <!-- Form Action Buttons -->
                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" style="background-color: #4338ca; border-color: #4338ca;">
                                <i class="bi bi-check-circle-fill me-1"></i> Issue Material
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
