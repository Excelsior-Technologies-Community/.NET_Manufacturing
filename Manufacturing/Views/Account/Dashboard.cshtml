@model Manufacturing.Models.DashboardViewModel

@{
    ViewData["Title"] = Model.Role + " Dashboard";

    string getRoleBadgeClass(string role)
    {
        switch (role)
        {
            case "Admin": return "bg-danger text-white";
            case "Production Manager": return "bg-primary text-white";
            case "Inventory Manager": return "bg-warning text-dark";
            case "Machine Supervisor": return "bg-info text-dark";
            case "Shift Supervisor": return "bg-secondary text-white";
            case "Machine Operator": return "bg-dark text-white";
            case "Quality Inspector": return "bg-success text-white";
            case "Store Manager": return "bg-indigo text-white";
            default: return "bg-secondary text-white";
        }
    }

    string getRoleIcon(string role)
    {
        switch (role)
        {
            case "Admin": return "bi-shield-fill-check";
            case "Production Manager": return "bi-gear-wide-connected";
            case "Inventory Manager": return "bi-boxes";
            case "Machine Supervisor": return "bi-cpu";
            case "Shift Supervisor": return "bi-clock-history";
            case "Machine Operator": return "bi-tools";
            case "Quality Inspector": return "bi-check-all";
            case "Store Manager": return "bi-shop";
            default: return "bi-person-badge";
        }
    }
}

<div class="container-fluid px-3 py-3">

    <!-- Top Profile & Greeting Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden bg-gradient-dark text-white" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center mb-2">
                        <div class="rounded-circle bg-primary bg-opacity-25 p-3 text-primary me-3 border border-primary border-opacity-50">
                            <i class="bi @getRoleIcon(Model.Role) fs-2"></i>
                        </div>
                        <div>
                            <span class="badge @getRoleBadgeClass(Model.Role) px-3 py-2 rounded-pill fs-7 mb-1 text-uppercase tracking-wider">
                                <i class="bi @getRoleIcon(Model.Role) me-1"></i> @Model.Role
                            </span>
                            <h2 class="fw-bold text-white mb-0">Welcome, @Model.FullName</h2>
                        </div>
                    </div>
                    <p class="text-slate-300 mb-0 opacity-75">
                        <i class="bi bi-person me-1"></i> <strong>Username:</strong> @Model.Username | 
                        <i class="bi bi-envelope me-1"></i> <strong>Email:</strong> @(string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email) | 
                        <i class="bi bi-phone me-1"></i> <strong>Mobile:</strong> @(string.IsNullOrEmpty(Model.Mobile) ? "N/A" : Model.Mobile)
                    </p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a asp-action="Logout" class="btn btn-outline-light rounded-pill px-4 py-2 shadow-sm">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Dynamic KPI Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">@Model.Metric1Label</div>
                            <h3 class="fw-bold mb-0 text-primary">@Model.Metric1Count</h3>
                        </div>
                        <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">@Model.Metric2Label</div>
                            <h3 class="fw-bold mb-0 text-success">@Model.Metric2Count</h3>
                        </div>
                        <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                            <i class="bi bi-check-circle-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">@Model.Metric3Label</div>
                            <h3 class="fw-bold mb-0 text-warning">@Model.Metric3Count</h3>
                        </div>
                        <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3">
                            <i class="bi bi-activity fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">@Model.Metric4Label</div>
                            <h3 class="fw-bold mb-0 text-info">@Model.Metric4Count</h3>
                        </div>
                        <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                            <i class="bi bi-bar-chart-line-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Role-Wise Dynamic Dashboard Panels -->
    @if (Model.Role == "Admin")
    {
        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-lock-fill text-danger me-2"></i>System User Role Matrix</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Role Name</th>
                                        <th class="text-center">Total Staff</th>
                                        <th class="text-center">Active Staff</th>
                                        <th class="text-end">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var stat in Model.RoleStats)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge @getRoleBadgeClass(stat.RoleName) me-2">@stat.RoleName</span>
                                            </td>
                                            <td class="text-center fw-bold">@stat.UserCount</td>
                                            <td class="text-center text-success fw-bold">@stat.ActiveCount</td>
                                            <td class="text-end">
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">Operational</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-sliders me-2 text-primary"></i>Admin Quick Controls</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a asp-controller="Employee" asp-action="Index" class="btn btn-outline-primary btn-lg rounded-3 text-start p-3">
                                <i class="bi bi-person-badge-fill me-2 fs-5 text-indigo"></i>
                                <strong>Employee Directory & HR Management</strong>
                                <div class="small text-muted">Manage workforce profiles, shift roster & attendance</div>
                            </a>
                            <a asp-action="Register" class="btn btn-outline-secondary text-dark btn-lg rounded-3 text-start p-3">
                                <i class="bi bi-person-plus-fill me-2 fs-5 text-primary"></i>
                                <strong>Register New User Account</strong>
                                <div class="small text-muted">Add new user login to manufacturing system</div>
                            </a>
                            <a asp-controller="Machine" asp-action="Index" class="btn btn-outline-info text-dark btn-lg rounded-3 text-start p-3">
                                <i class="bi bi-cpu-fill me-2 fs-5 text-info"></i>
                                <strong>Machine Management & Allocation</strong>
                                <div class="small text-muted">Equipment directory, maintenance schedule & approvals</div>
                            </a>
                            <a asp-controller="RawMaterial" asp-action="Index" class="btn btn-outline-warning text-dark btn-lg rounded-3 text-start p-3">
                                <i class="bi bi-boxes me-2 fs-5 text-warning"></i>
                                <strong>Raw Material Inventory</strong>
                                <div class="small text-muted">Manage stock, suppliers, and low stock alerts</div>
                            </a>
                            <a asp-controller="Shift" asp-action="Index" class="btn btn-outline-secondary text-dark btn-lg rounded-3 text-start p-3">
                                <i class="bi bi-clock-history me-2 fs-5 text-secondary"></i>
                                <strong>Shift Roster & Management</strong>
                                <div class="small text-muted">Configure shift schedules, timing, and supervisors</div>
                            </a>
                            <button class="btn btn-outline-dark btn-lg rounded-3 text-start p-3">
                                <i class="bi bi-shield-check me-2 fs-5"></i>
                                <strong>Security & Audit Logs</strong>
                                <div class="small text-muted">Review active database sessions</div>
                            </button>
                            <button class="btn btn-outline-success btn-lg rounded-3 text-start p-3">
                                <i class="bi bi-file-earmark-spreadsheet me-2 fs-5"></i>
                                <strong>Export System Reports</strong>
                                <div class="small text-muted">Generate dynamic role breakdown PDF/Excel</div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.Role == "Production Manager")
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-primary text-white py-3 rounded-top-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-gear-wide-connected me-2"></i>Production Management Command Center</h5>
                <a asp-controller="MachineAssignment" asp-action="Index" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold">
                    <i class="bi bi-cpu-fill text-primary me-1"></i> Machine Assignments
                </a>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <h6 class="fw-bold text-primary mb-1"><i class="bi bi-play-circle me-1"></i>Active Shifts</h6>
                            <p class="mb-0 text-muted">Supervisors registered: <strong>@Model.Metric2Count</strong></p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <h6 class="fw-bold text-success mb-1"><i class="bi bi-cpu me-1"></i>Machine Operators</h6>
                            <p class="mb-0 text-muted">Active Operators: <strong>@Model.Metric1Count</strong></p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <h6 class="fw-bold text-info mb-1"><i class="bi bi-check-square me-1"></i>Quality Personnel</h6>
                            <p class="mb-0 text-muted">Active Inspectors: <strong>@Model.Metric3Count</strong></p>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="MachineAssignment" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-cpu-fill me-1"></i> Manage Machine Assignments
                    </a>
                    <a asp-controller="MachineAssignment" asp-action="Create" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i> Create Machine Assignment
                    </a>
                    <a asp-controller="ProductionManagement" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-gear-wide-connected me-1"></i> View Production Orders
                    </a>
                </div>
            </div>
        </div>
    }
    else if (Model.Role == "Inventory Manager")
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header text-white py-3 rounded-top-4" style="background: linear-gradient(135deg, #064e3b, #059669);">
                <h5 class="fw-bold mb-0"><i class="bi bi-boxes me-2"></i>Inventory & Stock Control Hub (Manager Portal)</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-shop me-1 text-warning"></i>Store Managers Registered</h6>
                            <h3 class="fw-bold text-success mb-0">@Model.Metric1Count</h3>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-box-seam me-1 text-primary"></i>Inventory Personnel Count</h6>
                            <h3 class="fw-bold text-dark mb-0">@Model.Metric2Count</h3>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-lightning-charge text-warning me-1"></i>Quick Actions & Management Tools</h6>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="MaterialReceipt" asp-action="Index" class="btn btn-success rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-down me-1"></i> Material Receipts (GRN) Log
                    </a>
                    <a asp-controller="MaterialDispatch" asp-action="Index" class="btn btn-outline-success rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-truck me-1"></i> Outward Dispatches Log
                    </a>
                    <a asp-controller="RawMaterial" asp-action="Index" class="btn btn-outline-warning text-dark rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-boxes me-1"></i> Raw Materials List
                    </a>
                    <a asp-controller="MaterialStock" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-box-seam-fill me-1"></i> Material Stock Inventory
                    </a>
                    <a asp-controller="StockVerification" asp-action="Index" class="btn btn-outline-indigo rounded-pill px-4 py-2 fw-semibold" style="color: #6366f1; border-color: #6366f1;">
                        <i class="bi bi-clipboard-check-fill me-1"></i> Audit Stock Verification
                    </a>
                </div>
            </div>
        </div>
    }
    else if (Model.Role == "Machine Supervisor")
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-info text-dark py-3 rounded-top-4">
                <h5 class="fw-bold mb-0"><i class="bi bi-cpu me-2"></i>Machine Line Supervision Board</h5>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info border-0 rounded-3 mb-3">
                    <i class="bi bi-info-circle-fill me-2"></i> You are currently supervising <strong>@Model.Metric1Count</strong> registered Machine Operators.
                </div>
            </div>
        </div>
    }
    else if (Model.Role == "Shift Supervisor")
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-secondary text-white py-3 rounded-top-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2"></i>Shift Operations & Roster Control</h5>
                <a asp-controller="Shift" asp-action="Index" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold">
                    <i class="bi bi-list-task me-1"></i> View Shifts
                </a>
            </div>
            <div class="card-body p-4">
                <p class="mb-3 text-muted">Total Active Shift Members: <strong class="text-dark fs-5">@Model.Metric4Count</strong></p>
                <a asp-controller="Shift" asp-action="Index" class="btn btn-secondary rounded-pill px-4">
                    <i class="bi bi-clock me-1"></i> Manage Factory Shift Rosters
                </a>
            </div>
        </div>
    }
    else if (Model.Role == "Machine Operator")
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-dark text-white py-3 rounded-top-4">
                <h5 class="fw-bold mb-0"><i class="bi bi-tools me-2"></i>Machine Operator Workstation</h5>
            </div>
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h6 class="fw-bold text-success mb-1"><i class="bi bi-lightning-charge-fill me-1"></i>Workstation Status: Ready</h6>
                        <p class="text-muted mb-0">Active Supervisors in System: <strong>@Model.Metric2Count</strong> | Quality Inspectors: <strong>@Model.Metric3Count</strong></p>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.Role == "Quality Inspector")
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-success text-white py-3 rounded-top-4">
                <h5 class="fw-bold mb-0"><i class="bi bi-check-all me-2"></i>Quality Assurance & Inspection Portal</h5>
            </div>
            <div class="card-body p-4">
                <p class="mb-0 text-muted">Active Inspectors: <strong>@Model.Metric1Count</strong> | Operators Under Quality Check: <strong>@Model.Metric2Count</strong></p>
            </div>
        </div>
    }
    else if (Model.Role == "Store Manager")
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-indigo text-white py-3 rounded-top-4" style="background-color: #4f46e5;">
                <h5 class="fw-bold mb-0"><i class="bi bi-shop me-2"></i>Store & Material Management Panel</h5>
            </div>
            <div class="card-body p-4">
                <p class="mb-0 text-muted">Store Managers: <strong>@Model.Metric1Count</strong> | Inventory Managers: <strong>@Model.Metric2Count</strong></p>
            </div>
        </div>
    }

    <!-- Dynamic User Directory Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-table me-2 text-primary"></i>Manufacturing System User Directory</h5>
            <div class="d-flex align-items-center gap-2">
                @if (Model.Role == "Admin")
                {
                    <a asp-controller="User" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                        <i class="bi bi-person-plus-fill me-1"></i> Add User
                    </a>
                    <a asp-controller="User" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3 shadow-sm">
                        <i class="bi bi-sliders me-1"></i> Full User Control Panel
                    </a>
                }
                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">Total: @Model.TotalUsersCount Users</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th># ID</th>
                            <th>Full Name</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Mobile</th>
                            <th>Role</th>
                            <th class="text-center">Status</th>
                            @if (Model.Role == "Admin")
                            {
                                <th class="text-end pe-4">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentUsers != null && Model.RecentUsers.Count > 0)
                        {
                            @foreach (var u in Model.RecentUsers)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">#@u.UserId</td>
                                    <td class="fw-semibold text-dark">@u.FullName</td>
                                    <td><code>@u.Username</code></td>
                                    <td>@(string.IsNullOrEmpty(u.Email) ? "-" : u.Email)</td>
                                    <td>@(string.IsNullOrEmpty(u.Mobile) ? "-" : u.Mobile)</td>
                                    <td>
                                        <span class="badge @getRoleBadgeClass(u.Role) rounded-pill px-3 py-1">@u.Role</span>
                                    </td>
                                    <td class="text-center">
                                        @if (u.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1">Inactive</span>
                                        }
                                    </td>
                                    @if (Model.Role == "Admin")
                                    {
                                        <td class="text-end pe-4">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a asp-controller="User" asp-action="Edit" asp-route-id="@u.UserId" class="btn btn-outline-primary" title="Edit">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <a asp-controller="User" asp-action="ChangeStatus" asp-route-id="@u.UserId" class="btn btn-outline-warning" title="Toggle Active Status">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </a>
                                                <a asp-controller="User" asp-action="Delete" asp-route-id="@u.UserId" class="btn btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to delete user @u.FullName?');">
                                                    <i class="bi bi-trash-fill"></i>
                                                </a>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(Model.Role == "Admin" ? 8 : 7)" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i> No users found in database.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
