@model Manufacturing.Models.ShiftSupervisorDashboardViewModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Shift Supervisor Dashboard";

    var sessionName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? "Shift Supervisor";
    var sessionUsername = HttpContextAccessor.HttpContext?.Session.GetString("Username") ?? "";
    var sessionEmail = HttpContextAccessor.HttpContext?.Session.GetString("Email") ?? "";
}

<div class="container-fluid px-3 py-3">

    <!-- Top Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden text-white" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 40%, #4338ca 100%);">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center mb-2">
                        <div class="rounded-circle bg-indigo bg-opacity-25 p-3 text-white me-3 border border-indigo border-opacity-50" style="background-color: rgba(99, 102, 241, 0.25);">
                            <i class="bi bi-clock-history fs-2"></i>
                        </div>
                        <div>
                            <span class="badge bg-secondary px-3 py-2 rounded-pill fs-7 mb-1 text-uppercase tracking-wider">
                                <i class="bi bi-shield-check me-1"></i> Shift Supervisor
                            </span>
                            <h2 class="fw-bold text-white mb-0">Shift Operations Command Center</h2>
                        </div>
                    </div>
                    <p class="text-slate-300 mb-0 opacity-75">
                        <i class="bi bi-person me-1"></i> <strong>Supervisor:</strong> @sessionName (<code>@@@sessionUsername</code>) | 
                        <i class="bi bi-envelope me-1"></i> <strong>Email:</strong> @(string.IsNullOrEmpty(sessionEmail) ? "N/A" : sessionEmail)
                    </p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <a asp-controller="Shift" asp-action="Create" class="btn btn-light rounded-pill px-3 py-2 fw-semibold shadow-sm text-indigo" style="color: #4338ca;">
                            <i class="bi bi-plus-circle-fill me-1"></i> New Shift
                        </a>
                        <a asp-controller="Attendance" asp-action="Create" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-calendar-plus me-1"></i> Mark Attendance
                        </a>
                        <a asp-controller="LeaveApproval" asp-action="Create" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-calendar-event me-1"></i> Leave Request
                        </a>
                        <a asp-controller="OperatorAssignment" asp-action="Create" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-person-plus-fill me-1"></i> Assign Operator
                        </a>
                        <a asp-controller="MachineAssignment" asp-action="Create" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-cpu-fill me-1"></i> Machine Assignment
                        </a>
                        <a asp-controller="MaintenanceRequest" asp-action="Create" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-tools me-1"></i> Log Maintenance
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Alert if any -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat/KPI Cards Row -->
    <div class="row g-3 mb-4">
        <!-- Active Shifts Card -->
        <div class="col-6 col-md-4 col-lg">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Active Shifts</div>
                            <h3 class="fw-bold mb-0 text-info">@Model.ActiveShiftsCount <span class="fs-6 text-muted font-normal">/ @Model.TotalShifts</span></h3>
                        </div>
                        <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Operators Assigned Card -->
        <div class="col-6 col-md-4 col-lg">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Operator Assignments</div>
                            <h3 class="fw-bold mb-0 text-primary">@Model.OperatorAssignmentsCount</h3>
                        </div>
                        <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3">
                            <i class="bi bi-person-badge-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Machines Card -->
        <div class="col-6 col-md-4 col-lg">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Active Machines</div>
                            <h3 class="fw-bold mb-0 text-success">@Model.ActiveMachinesCount</h3>
                        </div>
                        <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                            <i class="bi bi-cpu-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Orders Card -->
        <div class="col-6 col-md-4 col-lg">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Active Orders</div>
                            <h3 class="fw-bold mb-0 text-warning">@Model.ActiveProductionOrdersCount</h3>
                        </div>
                        <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3">
                            <i class="bi bi-gear-wide-connected fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Maintenance Card -->
        <div class="col-6 col-md-4 col-lg">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-danger">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Pending Maintenance</div>
                            <h3 class="fw-bold mb-0 text-danger">@Model.PendingMaintenanceCount</h3>
                        </div>
                        <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-3">
                            <i class="bi bi-tools fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Shortcuts Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="fw-bold text-dark d-flex align-items-center">
                    <i class="bi bi-lightning-charge-fill text-warning me-2 fs-5"></i> Quick Shift Actions:
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Shift" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-clock-history me-1"></i> Shift Roster
                    </a>
                    <a asp-controller="Attendance" asp-action="Index" class="btn btn-sm btn-outline-indigo rounded-pill px-3" style="color: #6366f1; border-color: #6366f1;">
                        <i class="bi bi-calendar-check me-1"></i> Attendance Roster
                    </a>
                    <a asp-controller="LeaveApproval" asp-action="Index" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3">
                        <i class="bi bi-calendar-event me-1"></i> Leave Approvals
                    </a>
                    <a asp-controller="OperatorAssignment" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        <i class="bi bi-person-badge-fill me-1"></i> All Operator Roster
                    </a>
                    <a asp-controller="MachineAssignment" asp-action="Index" class="btn btn-sm btn-outline-info rounded-pill px-3">
                        <i class="bi bi-cpu-fill me-1"></i> Machine Assignments
                    </a>
                    <a asp-controller="MachineAllocation" asp-action="Index" class="btn btn-sm btn-outline-teal rounded-pill px-3" style="color: #0d9488; border-color: #0d9488;">
                        <i class="bi bi-diagram-3-fill me-1"></i> Machine Allocations
                    </a>
                    <a asp-controller="MaintenanceRequest" asp-action="Index" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                        <i class="bi bi-tools me-1"></i> Maintenance Requests
                    </a>
                    <a asp-controller="ProductionSchedule" asp-action="Index" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                        <i class="bi bi-calendar-week-fill me-1"></i> Production Schedules
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Tables Row -->
    <div class="row g-4 mb-4">
        
        <!-- Shift Roster Section -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-clock-history me-2 text-info"></i> Shift Roster Overview
                        </h5>
                        <small class="text-muted">Active and scheduled shifts</small>
                    </div>
                    <a asp-controller="Shift" asp-action="Index" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold text-primary">
                        View All <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body px-4 pt-2 pb-3">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Shift Name</th>
                                    <th>Timing</th>
                                    <th>Supervisor</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Shifts != null && Model.Shifts.Count > 0)
                                {
                                    foreach (var s in Model.Shifts)
                                    {
                                        <tr>
                                            <td><span class="badge bg-light text-dark border font-monospace px-2 py-1">@s.ShiftCode</span></td>
                                            <td class="fw-semibold">@s.ShiftName</td>
                                            <td class="small text-muted">
                                                <i class="bi bi-clock me-1"></i>@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm") (@s.TotalHours hrs)
                                            </td>
                                            <td class="small">@(string.IsNullOrEmpty(s.SupervisorName) ? "-" : s.SupervisorName)</td>
                                            <td>
                                                @if (s.Status == "Active")
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill"><i class="bi bi-check-circle me-1"></i> Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1 rounded-pill">@s.Status</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">No shifts logged yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Operator Assignments Roster -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-person-badge-fill me-2 text-primary"></i> Operator Assignments Roster
                        </h5>
                        <small class="text-muted">Operators deployed across active shifts</small>
                    </div>
                    <a asp-controller="OperatorAssignment" asp-action="Index" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold text-primary">
                        View All <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body px-4 pt-2 pb-3">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Operator</th>
                                    <th>Shift</th>
                                    <th>Order No</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentOperatorAssignments != null && Model.RecentOperatorAssignments.Count > 0)
                                {
                                    foreach (var op in Model.RecentOperatorAssignments)
                                    {
                                        <tr>
                                            <td class="fw-semibold">
                                                <i class="bi bi-person-circle me-1 text-secondary"></i> @op.EmployeeName
                                            </td>
                                            <td><span class="badge bg-info bg-opacity-10 text-info px-2 py-1">@op.ShiftName</span></td>
                                            <td class="font-monospace small">@op.OrderNo</td>
                                            <td class="small text-muted">@op.AssignedDate.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1 rounded-pill">
                                                    @(string.IsNullOrEmpty(op.Status) ? "Assigned" : op.Status)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">No operator assignments found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Second Row: Production Orders & Maintenance Requests -->
    <div class="row g-4">

        <!-- Active Production Orders -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-gear-wide-connected me-2 text-warning"></i> Production Orders Under Supervision
                        </h5>
                        <small class="text-muted">Current order status & priority</small>
                    </div>
                    <a asp-controller="ProductionManagement" asp-action="Index" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold text-primary">
                        View Orders <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body px-4 pt-2 pb-3">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Order No</th>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ActiveProductionOrders != null && Model.ActiveProductionOrders.Count > 0)
                                {
                                    foreach (var po in Model.ActiveProductionOrders)
                                    {
                                        <tr>
                                            <td class="fw-bold font-monospace text-primary">@po.OrderNo</td>
                                            <td>@po.ProductName</td>
                                            <td>@po.Quantity @po.Unit</td>
                                            <td>
                                                @if (po.Priority == "High")
                                                {
                                                    <span class="badge bg-danger px-2 py-1">High</span>
                                                }
                                                else if (po.Priority == "Medium")
                                                {
                                                    <span class="badge bg-warning text-dark px-2 py-1">Medium</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary px-2 py-1">@po.Priority</span>
                                                }
                                            </td>
                                            <td>
                                                @if (po.Status == "In Progress" || po.Status == "Running")
                                                {
                                                    <span class="badge bg-primary px-2 py-1 rounded-pill"><i class="bi bi-play-circle me-1"></i> @po.Status</span>
                                                }
                                                else if (po.Status == "Approved")
                                                {
                                                    <span class="badge bg-success px-2 py-1 rounded-pill"><i class="bi bi-check-circle me-1"></i> Approved</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary px-2 py-1 rounded-pill">@po.Status</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">No production orders found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Maintenance Requests -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-tools me-2 text-danger"></i> Maintenance Monitoring
                        </h5>
                        <small class="text-muted">Equipment issues requiring attention</small>
                    </div>
                    <a asp-controller="MaintenanceRequest" asp-action="Index" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold text-primary">
                        View All <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body px-4 pt-2 pb-3">
                    @if (Model.RecentMaintenanceRequests != null && Model.RecentMaintenanceRequests.Count > 0)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var mr in Model.RecentMaintenanceRequests)
                            {
                                <div class="list-group-item px-0 py-3 border-bottom">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="fw-bold mb-0 text-dark">
                                            <i class="bi bi-cpu text-secondary me-1"></i> @(string.IsNullOrEmpty(mr.MachineName) ? "Machine #" + mr.MachineId : mr.MachineName)
                                        </h6>
                                        @if (mr.Priority == "High" || mr.Priority == "Urgent")
                                        {
                                            <span class="badge bg-danger rounded-pill px-2 py-1 fs-7">@mr.Priority</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-2 py-1 fs-7">@(string.IsNullOrEmpty(mr.Priority) ? "Normal" : mr.Priority)</span>
                                        }
                                    </div>
                                    <p class="mb-2 text-muted small">@mr.ProblemDescription</p>
                                    <div class="d-flex justify-content-between align-items-center small text-muted">
                                        <span><i class="bi bi-person me-1"></i> By: @mr.RequestedBy</span>
                                        <span class="badge bg-light text-dark border">@mr.Status</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">No maintenance requests pending.</div>
                    }
                </div>
            </div>
        </div>

    </div>

</div>
