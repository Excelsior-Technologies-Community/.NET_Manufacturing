@model Manufacturing.Models.MachineManagerDashboardViewModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Machine Manager Dashboard";

    var sessionName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? "Machine Manager";
    var sessionUsername = HttpContextAccessor.HttpContext?.Session.GetString("Username") ?? "";
    var sessionEmail = HttpContextAccessor.HttpContext?.Session.GetString("Email") ?? "";
}

<div class="container-fluid px-3 py-3">

    <!-- Top Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden text-white" style="background: linear-gradient(135deg, #0f172a 0%, #0e7490 50%, #0284c7 100%);">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <div class="d-flex align-items-center mb-2">
                        <div class="rounded-circle bg-white bg-opacity-20 p-3 text-white me-3 border border-white border-opacity-25">
                            <i class="bi bi-cpu-fill fs-2"></i>
                        </div>
                        <div>
                            <span class="badge bg-cyan text-dark fw-bold px-3 py-2 rounded-pill fs-7 mb-1 text-uppercase tracking-wider" style="background-color: #38bdf8;">
                                <i class="bi bi-shield-check me-1"></i> Machine Manager
                            </span>
                            <h2 class="fw-bold text-white mb-0">Machine Operations Command Center</h2>
                        </div>
                    </div>
                    <p class="text-cyan-100 mb-0 opacity-75">
                        <i class="bi bi-person-fill me-1"></i> <strong>Manager:</strong> @sessionName (<code>@@@sessionUsername</code>) | 
                        <i class="bi bi-envelope-fill me-1"></i> <strong>Email:</strong> @(string.IsNullOrEmpty(sessionEmail) ? "N/A" : sessionEmail)
                    </p>
                </div>
                <div class="col-lg-5 text-lg-end mt-3 mt-lg-0">
                    <div class="d-flex flex-wrap justify-content-lg-end gap-2">
                        <a asp-controller="Machine" asp-action="Create" class="btn btn-light rounded-pill px-3 py-2 fw-semibold shadow-sm text-dark">
                            <i class="bi bi-plus-circle-fill me-1 text-primary"></i> Add Machine
                        </a>
                        <a asp-controller="MachineAssignment" asp-action="Create" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-cpu-fill me-1"></i> Assign Machine
                        </a>
                        <a asp-controller="MachineAllocation" asp-action="Create" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-cpu me-1"></i> Allocate Machine
                        </a>
                        <a asp-controller="MaintenanceRequest" asp-action="Create" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-tools me-1"></i> Request Maintenance
                        </a>
                        <a asp-controller="MachineAvailability" asp-action="Create" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-clock-history me-1"></i> Log Availability
                        </a>
                        <a asp-controller="MachineIssue" asp-action="Create" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i> Report Machine Issue
                        </a>
                        <a asp-controller="ProductionQuantityUpdate" asp-action="Create" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-bar-chart-line-fill me-1"></i> Update Quantity
                        </a>
                        <a asp-controller="ProductionWorkStatus" asp-action="Create" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-activity me-1"></i> Log Work Status
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Alert -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat / KPI Cards Row -->
    <div class="row g-3 mb-4">
        <!-- Total Machines Card -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Total Machines</div>
                            <h3 class="fw-bold mb-0 text-info">@Model.TotalMachinesCount</h3>
                        </div>
                        <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                            <i class="bi bi-cpu-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Machines Card -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Operational / Active</div>
                            <h3 class="fw-bold mb-0 text-success">@Model.ActiveMachinesCount</h3>
                        </div>
                        <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                            <i class="bi bi-check-circle-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Under Maintenance Card -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-danger">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">In Maintenance</div>
                            <h3 class="fw-bold mb-0 text-danger">@Model.MaintenanceMachinesCount</h3>
                        </div>
                        <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-3">
                            <i class="bi bi-tools fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Machine Assignments Card -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Total Assignments</div>
                            <h3 class="fw-bold mb-0 text-primary">@Model.TotalAssignmentsCount</h3>
                        </div>
                        <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3">
                            <i class="bi bi-person-workspace fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Maintenance Requests -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Pending Maintenance</div>
                            <h3 class="fw-bold mb-0 text-warning">@Model.PendingMaintenanceCount</h3>
                        </div>
                        <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3">
                            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Bar -->
    <div class="row g-3 mb-4">
        <div class="col-lg col-md-4 col-sm-6">
            <a asp-controller="Machine" asp-action="Index" class="card border-0 shadow-sm rounded-4 text-decoration-none text-dark bg-white hover-shadow transition p-3">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-info bg-opacity-10 text-info rounded-3 me-3">
                        <i class="bi bi-cpu-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Machine Directory</h6>
                        <small class="text-muted">Manage all equipment</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-lg col-md-4 col-sm-6">
            <a asp-controller="MachineAssignment" asp-action="Index" class="card border-0 shadow-sm rounded-4 text-decoration-none text-dark bg-white hover-shadow transition p-3">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 me-3">
                        <i class="bi bi-gear-wide-connected fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Machine Assignments</h6>
                        <small class="text-muted">Order & Operator tasks</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-lg col-md-4 col-sm-6">
            <a asp-controller="MaintenanceRequest" asp-action="Index" class="card border-0 shadow-sm rounded-4 text-decoration-none text-dark bg-white hover-shadow transition p-3">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-3 me-3">
                        <i class="bi bi-tools fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Maintenance & Repairs</h6>
                        <small class="text-muted">Fault logs & work orders</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-lg col-md-4 col-sm-6">
            <a asp-controller="MachineAvailability" asp-action="Index" class="card border-0 shadow-sm rounded-4 text-decoration-none text-dark bg-white hover-shadow transition p-3">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 me-3">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Machine Availability</h6>
                        <small class="text-muted">Uptime & Status logs</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-lg col-md-4 col-sm-6">
            <a asp-controller="ProductionQuantityUpdate" asp-action="Index" class="card border-0 shadow-sm rounded-4 text-decoration-none text-dark bg-white hover-shadow transition p-3">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-cyan bg-opacity-10 text-info rounded-3 me-3" style="background-color: rgba(6, 182, 212, 0.1);">
                        <i class="bi bi-bar-chart-line-fill fs-3 text-info"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Quantity Updates</h6>
                        <small class="text-muted">Production output logs</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-lg col-md-4 col-sm-6">
            <a asp-controller="ProductionWorkStatus" asp-action="Index" class="card border-0 shadow-sm rounded-4 text-decoration-none text-dark bg-white hover-shadow transition p-3">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3 me-3">
                        <i class="bi bi-activity fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Work Status</h6>
                        <small class="text-muted">Job progress & status</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-lg col-md-4 col-sm-6">
            <a asp-controller="MachineIssue" asp-action="Index" class="card border-0 shadow-sm rounded-4 text-decoration-none text-dark bg-white hover-shadow transition p-3">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-3 me-3">
                        <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Machine Issues</h6>
                        <small class="text-muted">Breakdown & fault logs</small>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Main Grid Content: Machines Table & Maintenance Table -->
    <div class="row g-4 mb-4">
        <!-- Machine Directory Card -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-cpu-fill me-2 text-info"></i> Machine Equipment Overview
                        </h5>
                        <small class="text-muted">List of active and registered machinery</small>
                    </div>
                    <a asp-controller="Machine" asp-action="Index" class="btn btn-sm btn-outline-info rounded-pill px-3">
                        View All <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body px-0 py-2">
                    @if (Model.Machines != null && Model.Machines.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light text-muted fs-7 text-uppercase">
                                    <tr>
                                        <th class="ps-4">Machine</th>
                                        <th>Type</th>
                                        <th>Manufacturer</th>
                                        <th>Status</th>
                                        <th>Allocated To</th>
                                        <th class="pe-4 text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mac in Model.Machines)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark">@mac.MachineName</div>
                                                <small class="text-muted">Code: @mac.MachineCode</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border px-2 py-1 fs-8">@(string.IsNullOrEmpty(mac.MachineType) ? "General" : mac.MachineType)</span>
                                            </td>
                                            <td class="text-secondary fs-7">@(string.IsNullOrEmpty(mac.Manufacturer) ? "N/A" : mac.Manufacturer)</td>
                                            <td>
                                                @if ((mac.Status ?? "").Equals("Active", StringComparison.OrdinalIgnoreCase) || (mac.Status ?? "").Equals("Operational", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 fs-8">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Active
                                                    </span>
                                                }
                                                else if ((mac.Status ?? "").Contains("Maintenance", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 fs-8">
                                                        <i class="bi bi-tools me-1"></i> Maintenance
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1 fs-8">
                                                        @mac.Status
                                                    </span>
                                                }
                                            </td>
                                            <td class="fs-7 text-muted">
                                                @(string.IsNullOrEmpty(mac.AllocatedTo) ? "—" : mac.AllocatedTo)
                                            </td>
                                            <td class="pe-4 text-end">
                                                <a asp-controller="Machine" asp-action="Edit" asp-route-id="@mac.MachineId" class="btn btn-sm btn-light rounded-circle shadow-sm" title="Edit Machine">
                                                    <i class="bi bi-pencil-fill text-primary"></i>
                                                </a>
                                                <a asp-controller="Machine" asp-action="Details" asp-route-id="@mac.MachineId" class="btn btn-sm btn-light rounded-circle shadow-sm ms-1" title="Machine Details">
                                                    <i class="bi bi-eye-fill text-info"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-cpu fs-1 mb-2 text-secondary opacity-50"></i>
                            <p class="mb-0">No machine records registered yet.</p>
                            <a asp-controller="Machine" asp-action="Create" class="btn btn-sm btn-info text-white rounded-pill mt-2">Add First Machine</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Maintenance Requests Card -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-tools me-2 text-danger"></i> Maintenance Alerts
                        </h5>
                        <small class="text-muted">Recent fault reports and service requests</small>
                    </div>
                    <a asp-controller="MaintenanceRequest" asp-action="Index" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                        View All <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body px-0 py-2">
                    @if (Model.RecentMaintenanceRequests != null && Model.RecentMaintenanceRequests.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var maint in Model.RecentMaintenanceRequests)
                            {
                                <div class="list-group-item px-4 py-3 border-bottom border-light">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div class="fw-bold text-dark">
                                            <i class="bi bi-gear-fill me-1 text-secondary"></i> @(string.IsNullOrEmpty(maint.MachineName) ? "Machine #" + maint.MachineId : maint.MachineName)
                                        </div>
                                        <div>
                                            @if ((maint.Priority ?? "").Equals("High", StringComparison.OrdinalIgnoreCase) || (maint.Priority ?? "").Equals("Urgent", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-danger rounded-pill fs-8 me-1">High</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill fs-8 me-1">@maint.Priority</span>
                                            }

                                            @if ((maint.Status ?? "").Equals("Completed", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-success rounded-pill fs-8">Done</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary rounded-pill fs-8">@maint.Status</span>
                                            }
                                        </div>
                                    </div>
                                    <p class="text-secondary small mb-1 text-truncate" style="max-width: 320px;">
                                        @maint.ProblemDescription
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center fs-8 text-muted mt-2">
                                        <span><i class="bi bi-calendar3 me-1"></i>@maint.RequestDate.ToString("yyyy-MM-dd")</span>
                                        <span><i class="bi bi-person me-1"></i>By: @maint.RequestedBy</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-check-circle fs-1 mb-2 text-success opacity-50"></i>
                            <p class="mb-0">No active maintenance requests.</p>
                            <a asp-controller="MaintenanceRequest" asp-action="Create" class="btn btn-sm btn-outline-danger rounded-pill mt-2">Log Maintenance</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary Grid: Recent Machine Assignments & Allocations -->
    <div class="row g-4">
        <!-- Recent Machine Assignments -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-person-workspace me-2 text-primary"></i> Machine Assignments
                        </h5>
                        <small class="text-muted">Operators & Production Order assignments</small>
                    </div>
                    <a asp-controller="MachineAssignment" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        View List <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body px-0 py-2">
                    @if (Model.RecentAssignments != null && Model.RecentAssignments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 fs-7">
                                <thead class="bg-light text-muted text-uppercase fs-8">
                                    <tr>
                                        <th class="ps-4">Machine</th>
                                        <th>Order No</th>
                                        <th>Assigned Employee</th>
                                        <th>Assigned Date</th>
                                        <th class="pe-4 text-end">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var assign in Model.RecentAssignments)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold text-dark">@(string.IsNullOrEmpty(assign.MachineName) ? "Machine #" + assign.MachineId : assign.MachineName)</td>
                                            <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(assign.OrderNo) ? "Order #" + assign.ProductionOrderId : assign.OrderNo)</span></td>
                                            <td class="text-secondary">@(string.IsNullOrEmpty(assign.EmployeeName) ? "N/A" : assign.EmployeeName)</td>
                                            <td>@assign.AssignedDate.ToString("yyyy-MM-dd")</td>
                                            <td class="pe-4 text-end">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 fs-8">
                                                    @(string.IsNullOrEmpty(assign.Status) ? "Active" : assign.Status)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <p class="mb-0">No machine assignment records logged.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Machine Allocations -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-cpu me-2 text-warning"></i> Machine Allocations
                        </h5>
                        <small class="text-muted">Production order allocations to machines</small>
                    </div>
                    <a asp-controller="MachineAllocation" asp-action="Index" class="btn btn-sm btn-outline-warning rounded-pill px-3 text-dark">
                        View List <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body px-0 py-2">
                    @if (Model.RecentAllocations != null && Model.RecentAllocations.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 fs-7">
                                <thead class="bg-light text-muted text-uppercase fs-8">
                                    <tr>
                                        <th class="ps-4">Machine</th>
                                        <th>Order No</th>
                                        <th>Allocation Date</th>
                                        <th class="pe-4 text-end">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var alloc in Model.RecentAllocations)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold text-dark">@(string.IsNullOrEmpty(alloc.MachineName) ? "Machine #" + alloc.MachineId : alloc.MachineName)</td>
                                            <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(alloc.OrderNo) ? "Order #" + alloc.ProductionOrderId : alloc.OrderNo)</span></td>
                                            <td>@alloc.AllocationDate.ToString("yyyy-MM-dd")</td>
                                            <td class="pe-4 text-end">
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1 fs-8">
                                                    @(string.IsNullOrEmpty(alloc.Status) ? "Allocated" : alloc.Status)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <p class="mb-0">No machine allocation records logged.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
