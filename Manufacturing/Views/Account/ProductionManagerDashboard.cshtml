@model Manufacturing.Models.ProductionManagerDashboardViewModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Production Manager Dashboard";

    var sessionName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? "Production Manager";
    var sessionUsername = HttpContextAccessor.HttpContext?.Session.GetString("Username") ?? "";
    var sessionEmail = HttpContextAccessor.HttpContext?.Session.GetString("Email") ?? "";
}

<div class="container-fluid px-3 py-3">

    <!-- Top Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden bg-gradient-dark text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #2563eb 100%);">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center mb-2">
                        <div class="rounded-circle bg-primary bg-opacity-25 p-3 text-white me-3 border border-primary border-opacity-50">
                            <i class="bi bi-gear-wide-connected fs-2"></i>
                        </div>
                        <div>
                            <span class="badge bg-primary px-3 py-2 rounded-pill fs-7 mb-1 text-uppercase tracking-wider">
                                <i class="bi bi-shield-check me-1"></i> Production Manager
                            </span>
                            <h2 class="fw-bold text-white mb-0">Production Management Command Center</h2>
                        </div>
                    </div>
                    <p class="text-slate-300 mb-0 opacity-75">
                        <i class="bi bi-person me-1"></i> <strong>Manager:</strong> @sessionName (<code>@@@sessionUsername</code>) | 
                        <i class="bi bi-envelope me-1"></i> <strong>Email:</strong> @(string.IsNullOrEmpty(sessionEmail) ? "N/A" : sessionEmail)
                    </p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <a asp-controller="ProductionManagement" asp-action="Create" class="btn btn-light rounded-pill px-3 py-2 fw-semibold shadow-sm text-primary">
                            <i class="bi bi-plus-circle-fill me-1"></i> New Order
                        </a>
                        <a asp-controller="ProductionSchedule" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-calendar-week-fill me-1"></i> Schedules
                        </a>
                        <a asp-controller="MachineAssignment" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-cpu-fill me-1"></i> Machines
                        </a>
                        <a asp-controller="MachineRelease" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Machine Releases
                        </a>
                        <a asp-controller="MachineAvailability" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-clock-history me-1"></i> Machine Availability
                        </a>
                        <a asp-controller="MaintenanceRequest" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-tools me-1"></i> Maintenance Requests
                        </a>
                        <a asp-controller="OperatorAssignment" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-person-badge-fill me-1"></i> Operators
                        </a>
                        <a asp-controller="CapacityPlanning" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-bar-chart-steps me-1"></i> Capacity
                        </a>
                        <a asp-controller="MaterialRequirementPlanning" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-boxes me-1"></i> MRP
                        </a>
                        <a asp-controller="MaterialStock" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-box-seam-fill me-1"></i> Stock
                        </a>
                        <a asp-controller="MaterialIssue" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Material Issues
                        </a>
                        <a asp-controller="MaterialReturn" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-box-arrow-in-left me-1"></i> Material Returns
                        </a>
                        <a asp-controller="StockVerification" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-clipboard-check-fill me-1"></i> Stock Audits
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stat/KPI Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-lg">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Total Orders</div>
                            <h3 class="fw-bold mb-0 text-primary">@Model.TotalOrders</h3>
                        </div>
                        <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3">
                            <i class="bi bi-boxes fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Today's Orders</div>
                            <h3 class="fw-bold mb-0 text-info">@Model.TodaysProductionCount</h3>
                        </div>
                        <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                            <i class="bi bi-calendar-event-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Running / Approved</div>
                            <h3 class="fw-bold mb-0 text-success">@Model.RunningOrdersCount</h3>
                        </div>
                        <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                            <i class="bi bi-play-circle-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Pending Approval</div>
                            <h3 class="fw-bold mb-0 text-warning">@Model.PendingOrdersCount</h3>
                        </div>
                        <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3">
                            <i class="bi bi-hourglass-split fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-secondary">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Completed</div>
                            <h3 class="fw-bold mb-0 text-secondary">@Model.CompletedOrdersCount</h3>
                        </div>
                        <div class="p-3 bg-secondary bg-opacity-10 text-secondary rounded-3">
                            <i class="bi bi-check-all fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Actions Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="ProductionManagement" asp-action="Create" class="btn btn-primary rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i> Create Production Order
                    </a>
                    <a asp-controller="ProductionManagement" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-list-task me-1"></i> View All Orders List
                    </a>
                    <a asp-controller="MachineAssignment" asp-action="Index" class="btn btn-outline-info text-dark rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-cpu-fill me-1"></i> Machine Assignments
                    </a>
                    <a asp-controller="MachineAssignment" asp-action="Create" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-plus-lg me-1"></i> Assign Machine
                    </a>
                    <a asp-controller="Shift" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-clock-history me-1"></i> Shift Roster
                    </a>
                    <a asp-controller="CapacityPlanning" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-bar-chart-steps me-1"></i> Capacity Planning
                    </a>
                    <a asp-controller="CapacityPlanning" asp-action="Create" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i> New Capacity Plan
                    </a>
                    <a asp-controller="MaterialRequirementPlanning" asp-action="Index" class="btn btn-outline-info text-dark rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-boxes me-1"></i> Material Requirements (MRP)
                    </a>
                    <a asp-controller="MaterialRequirementPlanning" asp-action="Create" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i> New MRP Requirement
                    </a>
                    <a asp-controller="MaterialStock" asp-action="Index" class="btn btn-outline-warning text-dark rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-box-seam-fill me-1"></i> Material Stock Inventory
                    </a>
                    <a asp-controller="MaterialStock" asp-action="Create" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i> Add Material Stock
                    </a>
                    <a asp-controller="StockVerification" asp-action="Index" class="btn btn-outline-info text-dark rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-clipboard-check-fill me-1"></i> Stock Verification Roster
                    </a>
                    <a asp-controller="StockVerification" asp-action="Create" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i> Perform Stock Audit
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabbed Production Orders Tables -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3">
            <ul class="nav nav-pills card-header-pills" id="productionTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-pill px-4 fw-semibold" id="running-tab" data-bs-toggle="tab" data-bs-target="#running" type="button" role="tab">
                        <i class="bi bi-play-circle-fill me-1 text-success"></i> Running & Approved (@Model.RunningOrdersCount)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 fw-semibold" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
                        <i class="bi bi-hourglass-split me-1 text-warning"></i> Pending (@Model.PendingOrdersCount)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 fw-semibold" id="todays-tab" data-bs-toggle="tab" data-bs-target="#todays" type="button" role="tab">
                        <i class="bi bi-calendar-event me-1 text-info"></i> Today's Orders (@Model.TodaysProductionCount)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 fw-semibold" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed" type="button" role="tab">
                        <i class="bi bi-check-all me-1 text-secondary"></i> Completed (@Model.CompletedOrdersCount)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 fw-semibold" id="all-tab" data-bs-toggle="tab" data-bs-target="#all" type="button" role="tab">
                        <i class="bi bi-boxes me-1 text-primary"></i> All Orders (@Model.TotalOrders)
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-0">
            <div class="tab-content" id="productionTabContent">

                <!-- Running Orders Tab -->
                <div class="tab-pane fade show active" id="running" role="tabpanel">
                    @{ await DisplayOrderTable(Model.RunningOrders, "No running or approved production orders found."); }
                </div>

                <!-- Pending Orders Tab -->
                <div class="tab-pane fade" id="pending" role="tabpanel">
                    @{ await DisplayOrderTable(Model.PendingOrders, "No pending production orders."); }
                </div>

                <!-- Today's Orders Tab -->
                <div class="tab-pane fade" id="todays" role="tabpanel">
                    @{ await DisplayOrderTable(Model.TodaysOrders, "No production orders scheduled for today."); }
                </div>

                <!-- Completed Orders Tab -->
                <div class="tab-pane fade" id="completed" role="tabpanel">
                    @{ await DisplayOrderTable(Model.CompletedOrders, "No completed production orders yet."); }
                </div>

                <!-- All Recent Orders Tab -->
                <div class="tab-pane fade" id="all" role="tabpanel">
                    @{ await DisplayOrderTable(Model.RecentOrders, "No production orders available in system."); }
                </div>

            </div>
        </div>
    </div>
</div>

@{
    async Task DisplayOrderTable(List<Manufacturing.Models.ProductionOrder> orders, string emptyMsg)
    {
        if (orders == null || orders.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-opacity-50"></i>
                <p class="mb-0 fs-6">@emptyMsg</p>
            </div>
            return;
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th># Order No</th>
                        <th>Product Name</th>
                        <th>Quantity & Unit</th>
                        <th>Start - End Date</th>
                        <th>Priority</th>
                        <th class="text-center">Status</th>
                        <th>Created By</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in orders)
                    {
                        string prioBadge = item.Priority?.Trim() switch
                        {
                            "Critical" => "bg-danger text-white",
                            "High" => "bg-danger text-white bg-opacity-75",
                            "Medium" => "bg-warning text-dark",
                            "Low" => "bg-info text-dark",
                            _ => "bg-secondary text-white"
                        };

                        string statusBadge = item.Status?.Trim() switch
                        {
                            "Approved" => "bg-success text-white",
                            "Completed" => "bg-success bg-opacity-10 text-success border border-success",
                            "In Progress" or "Running" => "bg-primary bg-opacity-10 text-primary border border-primary",
                            "Pending" => "bg-warning bg-opacity-10 text-warning border border-warning",
                            "Cancelled" => "bg-danger bg-opacity-10 text-danger border border-danger",
                            _ => "bg-dark bg-opacity-10 text-dark border border-dark"
                        };

                        <tr>
                            <td class="fw-bold text-primary">
                                <i class="bi bi-hash"></i>@item.OrderNo
                            </td>
                            <td class="fw-semibold text-dark">@item.ProductName</td>
                            <td><span class="fw-bold">@item.Quantity</span> <small class="text-muted">@item.Unit</small></td>
                            <td>
                                <small class="d-block text-muted"><i class="bi bi-calendar-play me-1"></i>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd-MMM-yyyy") : "-")</small>
                                <small class="d-block text-muted"><i class="bi bi-calendar-check me-1"></i>@(item.EndDate.HasValue ? item.EndDate.Value.ToString("dd-MMM-yyyy") : "-")</small>
                            </td>
                            <td>
                                <span class="badge @prioBadge rounded-pill px-3 py-1">@item.Priority</span>
                            </td>
                            <td class="text-center">
                                <span class="badge @statusBadge rounded-pill px-3 py-1">@item.Status</span>
                            </td>
                            <td><small class="text-muted">@item.CreatedBy</small></td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    @if (item.Status == "Pending")
                                    {
                                        <a asp-controller="ProductionManagement" asp-action="Approve" asp-route-id="@item.ProductionOrderId" class="btn btn-outline-success btn-sm rounded-pill px-2" title="Approve Order">
                                            <i class="bi bi-check-lg"></i> Approve
                                        </a>
                                    }
                                    <a asp-controller="ProductionManagement" asp-action="Edit" asp-route-id="@item.ProductionOrderId" class="btn btn-outline-primary btn-sm rounded-pill px-2" title="Edit Order">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
