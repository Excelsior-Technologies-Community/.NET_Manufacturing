@model List<Manufacturing.Models.MaterialReturn>

@{
    ViewData["Title"] = "Material Return Management";

    var returns = Model ?? new List<Manufacturing.Models.MaterialReturn>();
    int totalReturns = returns.Count;
    long totalReturnedQty = returns.Sum(r => (long)r.ReturnQuantity);
    int processedCount = returns.Count(r => string.Equals(r.Status, "Returned", StringComparison.OrdinalIgnoreCase) || string.Equals(r.Status, "Approved", StringComparison.OrdinalIgnoreCase) || string.Equals(r.Status, "Completed", StringComparison.OrdinalIgnoreCase));
    int pendingCount = returns.Count(r => string.Equals(r.Status, "Pending", StringComparison.OrdinalIgnoreCase) || string.Equals(r.Status, "Draft", StringComparison.OrdinalIgnoreCase));

    string getStatusBadgeClass(string? status)
    {
        switch (status?.Trim().ToLower())
        {
            case "returned":
            case "approved":
            case "completed":
                return "bg-success text-white";
            case "pending":
            case "draft":
            case "under review":
                return "bg-warning text-dark";
            case "rejected":
            case "cancelled":
                return "bg-danger text-white";
            default:
                return "bg-secondary text-white";
        }
    }
}

<div class="container-fluid px-3 py-3">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #172554 50%, #1d4ed8 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Inventory & Returns</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Production Manager Portal</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-box-arrow-in-left text-blue-300 me-2 fs-2"></i> Material Return Roster
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Production Manager Control: Manage unused raw material returns back to inventory</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-light rounded-pill px-4 py-2 shadow-sm fw-semibold text-primary">
                <i class="bi bi-plus-circle-fill me-1"></i> Return Raw Material
            </a>
            <a asp-controller="Account" asp-action="ProductionManagerDashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Stat/KPI Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Returns</div>
                        <div class="fs-3 fw-bold text-primary mb-0">@totalReturns</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-arrow-return-left fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Qty Returned</div>
                        <div class="fs-3 fw-bold text-info mb-0">@totalReturnedQty.ToString("N0")</div>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-box-seam-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Processed / Approved</div>
                        <div class="fs-3 fw-bold text-success mb-0">@processedCount</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Pending Review</div>
                        <div class="fs-3 fw-bold text-warning mb-0">@pendingCount</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center border-bottom-0 gap-3">
            <div>
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-list-stars me-2 text-primary"></i> Material Returns Directory
                </h5>
                <small class="text-muted">Showing all recorded raw material return transactions</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm rounded-pill overflow-hidden border" style="max-width: 280px;">
                    <span class="input-group-text bg-white border-0 pe-1"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-0 shadow-none ps-2" placeholder="Search returns...">
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="materialReturnTable">
                <thead class="bg-light text-muted uppercase fs-7 border-top">
                    <tr>
                        <th class="ps-4 py-3">Return ID</th>
                        <th class="py-3">Production Order</th>
                        <th class="py-3">Material Name</th>
                        <th class="py-3 text-end">Return Quantity</th>
                        <th class="py-3">Return Date</th>
                        <th class="py-3">Returned By</th>
                        <th class="py-3">Status</th>
                        <th class="py-3">Remarks</th>
                        <th class="pe-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (returns.Any())
                    {
                        @foreach (var item in returns)
                        {
                            <tr>
                                <td class="ps-4 py-3 fw-bold text-dark">
                                    <span class="badge bg-light text-dark border px-2 py-1 rounded-3">
                                        #MR-@item.ReturnId.ToString("D4")
                                    </span>
                                </td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                            <i class="bi bi-gear-wide-connected fs-6"></i>
                                        </div>
                                        <div>
                                            <span class="fw-semibold text-dark d-block">@(string.IsNullOrEmpty(item.OrderNo) ? $"Order #{item.ProductionOrderId}" : item.OrderNo)</span>
                                            <small class="text-muted">Order ID: @item.ProductionOrderId</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                            <i class="bi bi-box-seam fs-6"></i>
                                        </div>
                                        <div>
                                            <span class="fw-semibold text-dark d-block">@(string.IsNullOrEmpty(item.MaterialName) ? $"Material #{item.MaterialId}" : item.MaterialName)</span>
                                            <small class="text-muted">Material ID: @item.MaterialId</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 text-end fw-bold text-dark">
                                    <span class="fs-6 text-primary">@item.ReturnQuantity.ToString("N0")</span>
                                    <small class="text-muted d-block fs-7">Units</small>
                                </td>
                                <td class="py-3">
                                    <span class="fw-semibold text-dark d-block">@item.ReturnDate.ToString("yyyy-MM-dd")</span>
                                    <small class="text-muted">@item.ReturnDate.ToString("HH:mm")</small>
                                </td>
                                <td class="py-3">
                                    <span class="badge bg-light text-dark border px-2 py-1 rounded-pill fw-normal">
                                        <i class="bi bi-person me-1 text-primary"></i> @(string.IsNullOrEmpty(item.ReturnedBy) ? "System / N/A" : item.ReturnedBy)
                                    </span>
                                </td>
                                <td class="py-3">
                                    <span class="badge @getStatusBadgeClass(item.Status) rounded-pill px-3 py-1 fs-7 fw-semibold">
                                        @(string.IsNullOrEmpty(item.Status) ? "Returned" : item.Status)
                                    </span>
                                </td>
                                <td class="py-3 text-muted fs-7 max-w-xs text-truncate" style="max-width: 180px;">
                                    @(string.IsNullOrEmpty(item.Remarks) ? "-" : item.Remarks)
                                </td>
                                <td class="pe-4 py-3 text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.ReturnId" class="btn btn-outline-info rounded-start-pill px-2" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.ReturnId" class="btn btn-outline-warning px-2" title="Edit Return">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger rounded-end-pill px-2" title="Delete Return" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.ReturnId">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Modal -->
                                    <div class="modal fade" id="deleteModal-@item.ReturnId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold text-danger">Confirm Deletion</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body text-start py-3">
                                                    <p class="mb-1">Are you sure you want to delete Material Return <strong>#MR-@item.ReturnId.ToString("D4")</strong>?</p>
                                                </div>
                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                    <a asp-action="Delete" asp-route-id="@item.ReturnId" class="btn btn-danger rounded-pill px-3">Delete Return</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <div class="py-4">
                                    <i class="bi bi-box-arrow-in-left fs-1 text-muted opacity-50 d-block mb-3"></i>
                                    <h5>No Material Returns Found</h5>
                                    <p class="mb-3">No material return transactions have been recorded yet.</p>
                                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
                                        <i class="bi bi-plus-circle me-1"></i> Record Material Return
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const table = document.getElementById('materialReturnTable');

            if (searchInput && table) {
                searchInput.addEventListener('keyup', function () {
                    const filter = searchInput.value.toLowerCase();
                    const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

                    for (let i = 0; i < rows.length; i++) {
                        const rowText = rows[i].textContent.toLowerCase();
                        if (rowText.includes(filter)) {
                            rows[i].style.display = '';
                        } else {
                            rows[i].style.display = 'none';
                        }
                    }
                });
            }
        });
    </script>
}
