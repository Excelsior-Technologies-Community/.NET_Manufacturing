@model Manufacturing.Models.MaterialDispatch

@{
    ViewData["Title"] = $"Edit Material Dispatch DISP-{Model?.DispatchId.ToString("D4")} - Inventory Manager";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">
            <!-- Navigation Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-warning text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Inventory Manager Portal</span>
                        <span class="badge bg-primary text-white px-3 py-1 rounded-pill fs-7">Edit Ticket DISP-@Model?.DispatchId.ToString("D4")</span>
                    </div>
                    <h3 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-pencil-square text-primary me-2"></i> Edit Material Dispatch Record
                    </h3>
                    <p class="text-muted mb-0 small">Update existing raw material dispatch details and audit status.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Back to Roster
                </a>
            </div>

            <!-- Form Card -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="card-header text-white p-4" style="background: linear-gradient(135deg, #064e3b 0%, #047857 50%, #059669 100%);">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h5 class="fw-bold mb-1"><i class="bi bi-pencil-fill me-2 text-warning"></i> Modify Dispatch Ticket DISP-@Model?.DispatchId.ToString("D4")</h5>
                            <p class="mb-0 opacity-85 small">Update quantity, status, authorizer, destination or notes below.</p>
                        </div>
                        <i class="bi bi-truck fs-1 opacity-50"></i>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" method="post" id="editDispatchForm">
                        <div asp-validation-summary="All" class="alert alert-danger rounded-3 mb-4"></div>

                        <!-- Primary Key & Hidden Non-Form Fields to ensure ModelState.IsValid passes -->
                        <input type="hidden" asp-for="DispatchId" />
                        <input type="hidden" asp-for="MaterialName" value="@(string.IsNullOrEmpty(Model?.MaterialName) ? "N/A" : Model.MaterialName)" />
                        <input type="hidden" asp-for="OrderNo" value="@(string.IsNullOrEmpty(Model?.OrderNo) ? "N/A" : Model.OrderNo)" />
                        <input type="hidden" asp-for="CreatedDate" value="@(Model?.CreatedDate != DateTime.MinValue ? Model?.CreatedDate.ToString("yyyy-MM-ddTHH:mm:ss") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss"))" />

                        <div class="row g-3">
                            <!-- Raw Material Selection -->
                            <div class="col-12 col-md-6">
                                <label asp-for="MaterialId" class="form-label fw-semibold text-dark">Raw Material <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-boxes"></i></span>
                                    <select asp-for="MaterialId" asp-items="@ViewBag.MaterialList" class="form-select border-start-0 py-2 rounded-end-3" id="materialSelect" required>
                                        <option value="">-- Select Raw Material --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="MaterialId" class="text-danger small"></span>
                            </div>

                            <!-- Production Order Selection -->
                            <div class="col-12 col-md-6">
                                <label asp-for="ProductionOrderId" class="form-label fw-semibold text-dark">Production Order (Optional)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-gear-wide"></i></span>
                                    <select asp-for="ProductionOrderId" asp-items="@ViewBag.OrderList" class="form-select border-start-0 py-2 rounded-end-3" id="orderSelect">
                                        <option value="">-- General / Direct Dispatch --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="ProductionOrderId" class="text-danger small"></span>
                            </div>

                            <!-- Dispatch Quantity -->
                            <div class="col-12 col-md-6">
                                <label asp-for="DispatchQuantity" class="form-label fw-semibold text-dark">Dispatch Quantity <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-123"></i></span>
                                    <input asp-for="DispatchQuantity" type="number" min="1" class="form-control border-start-0 py-2 rounded-end-3" placeholder="Enter quantity" id="dispatchQtyInput" required />
                                </div>
                                <span asp-validation-for="DispatchQuantity" class="text-danger small"></span>
                            </div>

                            <!-- Dispatch Date & Time -->
                            <div class="col-12 col-md-6">
                                <label asp-for="DispatchDate" class="form-label fw-semibold text-dark">Dispatch Date & Time <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-calendar-event"></i></span>
                                    <input asp-for="DispatchDate" type="datetime-local" class="form-control border-start-0 py-2 rounded-end-3" value="@(Model?.DispatchDate != DateTime.MinValue ? Model?.DispatchDate.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))" required />
                                </div>
                                <span asp-validation-for="DispatchDate" class="text-danger small"></span>
                            </div>

                            <!-- Destination -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Destination" class="form-label fw-semibold text-dark">Destination Location / Department</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="Destination" class="form-control border-start-0 py-2 rounded-end-3" placeholder="e.g. Assembly Line A / Workshop B" value="@(string.IsNullOrEmpty(Model?.Destination) ? "Main Warehouse" : Model.Destination)" />
                                </div>
                                <span asp-validation-for="Destination" class="text-danger small"></span>
                            </div>

                            <!-- Dispatched By -->
                            <div class="col-12 col-md-6">
                                <label asp-for="DispatchedBy" class="form-label fw-semibold text-dark">Dispatched By (Authorizer)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="DispatchedBy" class="form-control border-start-0 py-2 rounded-end-3" placeholder="e.g. John Doe (Store Manager)" value="@(string.IsNullOrEmpty(Model?.DispatchedBy) ? "Inventory Manager" : Model.DispatchedBy)" />
                                </div>
                                <span asp-validation-for="DispatchedBy" class="text-danger small"></span>
                            </div>

                            <!-- Status -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold text-dark">Dispatch Status</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-tag"></i></span>
                                    <select asp-for="Status" class="form-select border-start-0 py-2 rounded-end-3">
                                        <option value="Dispatched">Dispatched</option>
                                        <option value="In Transit">In Transit</option>
                                        <option value="Delivered">Delivered</option>
                                        <option value="Completed">Completed</option>
                                        <option value="Pending">Pending</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <!-- Remarks -->
                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold text-dark">Remarks / Audit Notes</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-chat-left-text"></i></span>
                                    <textarea asp-for="Remarks" class="form-control border-start-0 py-2 rounded-end-3" rows="3" placeholder="Add any operational remarks or special instructions...">@(string.IsNullOrEmpty(Model?.Remarks) ? "N/A" : Model.Remarks)</textarea>
                                </div>
                                <span asp-validation-for="Remarks" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Form Submit / Cancel Buttons -->
                        <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4 py-2 border">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-semibold">
                                <i class="bi bi-check-circle me-1"></i> Update Dispatch Record
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
