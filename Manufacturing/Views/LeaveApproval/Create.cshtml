@model Manufacturing.Models.LeaveRequest

@{
    ViewData["Title"] = "New Leave Request";
}

<div class="container-fluid px-3 py-3">
    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-indigo text-white px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold" style="background-color: #6366f1;">Leave Approval</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Submit Request</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-calendar-plus text-indigo me-2 fs-2" style="color: #a5b4fc;"></i> New Leave Request
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Submit or record a new leave application for employee time-off approval</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Leave Roster
            </a>
        </div>
    </div>

    <!-- Main Card Form -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-file-earmark-plus me-2 text-indigo" style="color: #6366f1;"></i> Leave Request Form
                    </h5>
                    <small class="text-muted">Enter leave request details below</small>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>

                        <!-- Employee Select -->
                        <div class="mb-3">
                            <label asp-for="EmployeeId" class="form-label fw-semibold text-dark">
                                Select Employee <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person-fill text-indigo" style="color: #6366f1;"></i></span>
                                <select asp-for="EmployeeId" class="form-select" asp-items="@ViewBag.EmployeeList" required>
                                    <option value="">-- Select Employee --</option>
                                </select>
                            </div>
                            <span asp-validation-for="EmployeeId" class="text-danger fs-8"></span>
                        </div>

                        <!-- Leave Type & Status -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="LeaveType" class="form-label fw-semibold text-dark">
                                    Leave Type <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-tag-fill text-indigo" style="color: #6366f1;"></i></span>
                                    <select asp-for="LeaveType" class="form-select" required>
                                        <option value="">-- Select Type --</option>
                                        <option value="Casual Leave">Casual Leave (CL)</option>
                                        <option value="Sick Leave">Sick Leave (SL)</option>
                                        <option value="Earned Leave">Earned Leave (EL)</option>
                                        <option value="Emergency Leave">Emergency Leave</option>
                                        <option value="Maternity/Paternity Leave">Maternity/Paternity Leave</option>
                                        <option value="Unpaid Leave">Unpaid Leave</option>
                                    </select>
                                </div>
                                <span asp-validation-for="LeaveType" class="text-danger fs-8"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold text-dark">
                                    Status
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-check-circle-fill text-indigo" style="color: #6366f1;"></i></span>
                                    <select asp-for="Status" class="form-select">
                                        <option value="Pending">Pending</option>
                                        <option value="Approved">Approved</option>
                                        <option value="Rejected">Rejected</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Status" class="text-danger fs-8"></span>
                            </div>
                        </div>

                        <!-- Dates Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FromDate" class="form-label fw-semibold text-dark">
                                    From Date <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-calendar-event text-indigo" style="color: #6366f1;"></i></span>
                                    <input asp-for="FromDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                </div>
                                <span asp-validation-for="FromDate" class="text-danger fs-8"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ToDate" class="form-label fw-semibold text-dark">
                                    To Date <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-calendar-event text-indigo" style="color: #6366f1;"></i></span>
                                    <input asp-for="ToDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                </div>
                                <span asp-validation-for="ToDate" class="text-danger fs-8"></span>
                            </div>
                        </div>

                        <!-- Requested Date & Approved By -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="RequestedDate" class="form-label fw-semibold text-dark">
                                    Requested Date <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-clock me-1 text-indigo" style="color: #6366f1;"></i></span>
                                    <input asp-for="RequestedDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                </div>
                                <span asp-validation-for="RequestedDate" class="text-danger fs-8"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ApprovedBy" class="form-label fw-semibold text-dark">
                                    Approved / Supervisor Name
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person-check-fill text-indigo" style="color: #6366f1;"></i></span>
                                    <input asp-for="ApprovedBy" type="text" class="form-control" placeholder="e.g. Shift Supervisor" />
                                </div>
                                <span asp-validation-for="ApprovedBy" class="text-danger fs-8"></span>
                            </div>
                        </div>

                        <!-- Reason -->
                        <div class="mb-3">
                            <label asp-for="Reason" class="form-label fw-semibold text-dark">
                                Reason for Leave
                            </label>
                            <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Provide explanation or reason for leave request..."></textarea>
                            <span asp-validation-for="Reason" class="text-danger fs-8"></span>
                        </div>

                        <!-- Remarks -->
                        <div class="mb-4">
                            <label asp-for="Remarks" class="form-label fw-semibold text-dark">
                                Remarks / Notes
                            </label>
                            <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Additional remarks or instructions..."></textarea>
                            <span asp-validation-for="Remarks" class="text-danger fs-8"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-indigo text-white rounded-pill px-5 shadow-sm" style="background-color: #4338ca;">
                                <i class="bi bi-check-circle-fill me-1"></i> Submit Leave Request
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
