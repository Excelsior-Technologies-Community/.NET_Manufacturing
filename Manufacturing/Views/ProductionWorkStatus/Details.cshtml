@model Manufacturing.Models.ProductionWorkStatus

@{
    ViewData["Title"] = "Production Work Status Details";

    string getStatusBadgeClass(string status)
    {
        switch (status?.Trim())
        {
            case "Assigned": return "bg-primary text-white";
            case "Running": case "In Progress": return "bg-success text-white";
            case "Paused": return "bg-warning text-dark";
            case "Completed": return "bg-info text-dark";
            case "Cancelled": return "bg-danger text-white";
            default: return "bg-secondary text-white";
        }
    }
}

<div class="container-fluid px-3 py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0284c7 100%);">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-info text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Shop Floor Tracking</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-activity text-info me-2 fs-2"></i> Work Status Entry #@Model.WorkStatusId
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Comprehensive breakdown of job status, assigned assets, and production timestamps</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model.WorkStatusId" class="btn btn-warning rounded-pill px-4 py-2 fw-semibold text-dark">
                <i class="bi bi-pencil-square me-1"></i> Edit Entry
            </a>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Roster
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Main Details Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-info-circle me-2 text-primary"></i> Work Status Summary
                    </h5>
                    <span class="badge @getStatusBadgeClass(Model.Status) rounded-pill px-4 py-2 fs-6">
                        @Model.Status
                    </span>
                </div>
                <div class="card-body p-4">
                    <!-- Workflow Quick Action Bar -->
                    <div class="p-3 bg-light rounded-3 border mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <span class="fw-bold text-dark me-2">Quick Actions:</span>
                            <span class="text-muted small">Update status directly from details view</span>
                        </div>
                        <div class="d-flex gap-2">
                            @if (Model.Status == "Assigned" || string.IsNullOrEmpty(Model.Status))
                            {
                                <a asp-action="Start" asp-route-id="@Model.WorkStatusId" class="btn btn-success rounded-pill px-3">
                                    <i class="bi bi-play-fill me-1"></i> Start Production
                                </a>
                            }
                            else if (Model.Status == "Running" || Model.Status == "In Progress")
                            {
                                <a asp-action="Pause" asp-route-id="@Model.WorkStatusId" class="btn btn-warning text-dark rounded-pill px-3">
                                    <i class="bi bi-pause-fill me-1"></i> Pause Production
                                </a>
                                <a asp-action="Complete" asp-route-id="@Model.WorkStatusId" class="btn btn-info rounded-pill px-3">
                                    <i class="bi bi-check-all me-1"></i> Complete Production
                                </a>
                            }
                            else if (Model.Status == "Paused")
                            {
                                <a asp-action="Resume" asp-route-id="@Model.WorkStatusId" class="btn btn-success rounded-pill px-3">
                                    <i class="bi bi-play-circle me-1"></i> Resume Production
                                </a>
                                <a asp-action="Complete" asp-route-id="@Model.WorkStatusId" class="btn btn-info rounded-pill px-3">
                                    <i class="bi bi-check-all me-1"></i> Complete Production
                                </a>
                            }
                            else if (Model.Status == "Completed")
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 fs-7 rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i> Job Completed
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Details Grid -->
                    <div class="row g-4 mb-4">
                        <div class="col-md-6 col-lg-3">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Work Status ID</small>
                                <div class="fs-5 fw-bold text-dark">#@Model.WorkStatusId</div>
                            </div>
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Production Order</small>
                                <div class="fs-5 fw-bold text-primary">
                                    <i class="bi bi-hash me-1"></i>@(string.IsNullOrEmpty(Model.OrderNo) ? Model.ProductionOrderId.ToString() : Model.OrderNo)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Assigned Machine</small>
                                <div class="fs-5 fw-bold text-info">
                                    <i class="bi bi-cpu me-1"></i>@(string.IsNullOrEmpty(Model.MachineName) ? Model.MachineId.ToString() : Model.MachineName)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Operator / Employee</small>
                                <div class="fs-5 fw-bold text-dark">
                                    <i class="bi bi-person-badge me-1 text-secondary"></i>@(string.IsNullOrEmpty(Model.EmployeeName) ? Model.EmployeeId.ToString() : Model.EmployeeName)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Production Event Timeline Grid -->
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-clock-history me-1 text-primary"></i> Execution Event Timeline
                    </h6>
                    <div class="row g-4 mb-4">
                        <div class="col-md-6 col-lg-3">
                            <div class="p-3 border rounded-3 bg-white shadow-sm border-start border-4 border-success">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Start Event</small>
                                <div class="fw-bold text-dark">
                                    <i class="bi bi-play-circle text-success me-1"></i>
                                    @(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd-MMM-yyyy") : "Not Started")
                                </div>
                                <small class="text-muted">
                                    @(Model.StartTime.HasValue ? Model.StartTime.Value.ToString(@"hh\:mm") : "-")
                                </small>
                            </div>
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <div class="p-3 border rounded-3 bg-white shadow-sm border-start border-4 border-warning">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Pause Event</small>
                                <div class="fw-bold text-dark">
                                    <i class="bi bi-pause-circle text-warning me-1"></i>
                                    @(Model.PauseDate.HasValue ? Model.PauseDate.Value.ToString("dd-MMM-yyyy") : "Not Paused")
                                </div>
                                <small class="text-muted">
                                    @(Model.PauseTime.HasValue ? Model.PauseTime.Value.ToString(@"hh\:mm") : "-")
                                </small>
                            </div>
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <div class="p-3 border rounded-3 bg-white shadow-sm border-start border-4 border-primary">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Resume Event</small>
                                <div class="fw-bold text-dark">
                                    <i class="bi bi-arrow-repeat text-primary me-1"></i>
                                    @(Model.ResumeDate.HasValue ? Model.ResumeDate.Value.ToString("dd-MMM-yyyy") : "Not Resumed")
                                </div>
                                <small class="text-muted">
                                    @(Model.ResumeTime.HasValue ? Model.ResumeTime.Value.ToString(@"hh\:mm") : "-")
                                </small>
                            </div>
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <div class="p-3 border rounded-3 bg-white shadow-sm border-start border-4 border-info">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Completion Event</small>
                                <div class="fw-bold text-dark">
                                    <i class="bi bi-check-circle text-info me-1"></i>
                                    @(Model.CompletionDate.HasValue ? Model.CompletionDate.Value.ToString("dd-MMM-yyyy") : "Not Completed")
                                </div>
                                <small class="text-muted">
                                    @(Model.CompletionTime.HasValue ? Model.CompletionTime.Value.ToString(@"hh\:mm") : "-")
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Remarks & Created Date -->
                    <div class="row g-4 mb-4">
                        <div class="col-md-8">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Remarks & Operational Notes</small>
                                <p class="mb-0 text-dark fs-6" style="white-space: pre-line;">
                                    @(string.IsNullOrEmpty(Model.Remarks) ? "No operational remarks provided." : Model.Remarks)
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Created Date</small>
                                <div class="fs-6 fw-semibold text-muted">
                                    <i class="bi bi-calendar-check me-1 text-primary"></i>
                                    @(Model.CreatedDate != DateTime.MinValue ? Model.CreatedDate.ToString("dd-MMM-yyyy hh:mm tt") : "-")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Delete" asp-route-id="@Model.WorkStatusId" class="btn btn-outline-danger rounded-pill px-4" onclick="return confirm('Are you sure you want to delete this work status entry?');">
                            <i class="bi bi-trash-fill me-1"></i> Delete Entry
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back to Roster</a>
                            <a asp-action="Edit" asp-route-id="@Model.WorkStatusId" class="btn btn-primary rounded-pill px-4 fw-semibold">
                                <i class="bi bi-pencil-square me-1"></i> Edit Entry
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
