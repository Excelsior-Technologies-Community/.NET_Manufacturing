@model List<Manufacturing.Models.ProductionWorkStatus>

@{
    ViewData["Title"] = "Production Work Status Roster";

    var workList = Model ?? new List<Manufacturing.Models.ProductionWorkStatus>();
    int totalRecords = workList.Count;
    int assignedCount = workList.Count(w => w.Status == "Assigned");
    int runningCount = workList.Count(w => w.Status == "Running" || w.Status == "In Progress");
    int pausedCount = workList.Count(w => w.Status == "Paused");
    int completedCount = workList.Count(w => w.Status == "Completed");

    string getStatusBadgeClass(string status)
    {
        switch (status?.Trim())
        {
            case "Assigned": return "bg-primary text-white";
            case "Running": case "In Progress": return "bg-success text-white";
            case "Paused": return "bg-warning text-dark";
            case "Completed": return "bg-info text-dark";
            case "Cancelled": return "bg-danger text-white";
            default: return "bg-secondary text-white";
        }
    }
}

<div class="container-fluid px-3 py-3">
    <!-- TempData Success Alert -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0284c7 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-info text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Shop Floor Tracking</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Real-time Execution</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-activity text-info me-2 fs-2"></i> Production Work Status
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Track machine activity, monitor operator logs, pause/resume execution, and mark completed jobs</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-light rounded-pill px-4 py-2 shadow-sm fw-semibold text-primary">
                <i class="bi bi-plus-circle-fill me-1"></i> New Work Status Entry
            </a>
            <a asp-controller="Account" asp-action="Dashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Entries</div>
                        <div class="fs-3 fw-bold text-primary mb-0">@totalRecords</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-list-task fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Running Jobs</div>
                        <div class="fs-3 fw-bold text-success mb-0">@runningCount</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-play-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Paused Jobs</div>
                        <div class="fs-3 fw-bold text-warning mb-0">@pausedCount</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-pause-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Completed</div>
                        <div class="fs-3 fw-bold text-info mb-0">@completedCount</div>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Production Work Status Data Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-table me-2 text-primary"></i> Work Status Roster
            </h5>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">Total: @totalRecords Records</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th># ID</th>
                            <th>Production Order</th>
                            <th>Machine</th>
                            <th>Operator / Employee</th>
                            <th>Start Date / Time</th>
                            <th class="text-center">Status</th>
                            <th>Remarks</th>
                            <th class="text-center">Workflow Control</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (workList.Count > 0)
                        {
                            @foreach (var item in workList)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">#@item.WorkStatusId</td>
                                    <td class="fw-semibold text-primary">
                                        <i class="bi bi-hash"></i>@(string.IsNullOrEmpty(item.OrderNo) ? item.ProductionOrderId.ToString() : item.OrderNo)
                                    </td>
                                    <td class="fw-semibold text-dark">
                                        <i class="bi bi-cpu me-1 text-info"></i>@(string.IsNullOrEmpty(item.MachineName) ? item.MachineId.ToString() : item.MachineName)
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark">
                                            <i class="bi bi-person-badge me-1 text-secondary"></i>@(string.IsNullOrEmpty(item.EmployeeName) ? item.EmployeeId.ToString() : item.EmployeeName)
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.StartDate.HasValue)
                                        {
                                            <small class="text-muted d-block">
                                                <i class="bi bi-calendar-event me-1 text-primary"></i>@item.StartDate.Value.ToString("dd-MMM-yyyy")
                                            </small>
                                            if (item.StartTime.HasValue)
                                            {
                                                <small class="text-muted d-block">
                                                    <i class="bi bi-clock me-1 text-secondary"></i>@item.StartTime.Value.ToString(@"hh\:mm")
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Not Started</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @getStatusBadgeClass(item.Status) rounded-pill px-3 py-1">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 180px;" title="@item.Remarks">
                                            @(string.IsNullOrEmpty(item.Remarks) ? "-" : item.Remarks)
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            @if (item.Status == "Assigned" || string.IsNullOrEmpty(item.Status))
                                            {
                                                <a asp-action="Start" asp-route-id="@item.WorkStatusId" class="btn btn-outline-success" title="Start Production">
                                                    <i class="bi bi-play-fill me-1"></i> Start
                                                </a>
                                            }
                                            else if (item.Status == "Running" || item.Status == "In Progress")
                                            {
                                                <a asp-action="Pause" asp-route-id="@item.WorkStatusId" class="btn btn-outline-warning" title="Pause Production">
                                                    <i class="bi bi-pause-fill me-1"></i> Pause
                                                </a>
                                                <a asp-action="Complete" asp-route-id="@item.WorkStatusId" class="btn btn-outline-info" title="Complete Production">
                                                    <i class="bi bi-check-all me-1"></i> Complete
                                                </a>
                                            }
                                            else if (item.Status == "Paused")
                                            {
                                                <a asp-action="Resume" asp-route-id="@item.WorkStatusId" class="btn btn-outline-success" title="Resume Production">
                                                    <i class="bi bi-play-circle me-1"></i> Resume
                                                </a>
                                                <a asp-action="Complete" asp-route-id="@item.WorkStatusId" class="btn btn-outline-info" title="Complete Production">
                                                    <i class="bi bi-check-all me-1"></i> Complete
                                                </a>
                                            }
                                            else if (item.Status == "Completed")
                                            {
                                                <span class="badge bg-light text-success border px-2 py-1">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Done
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.WorkStatusId" class="btn btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.WorkStatusId" class="btn btn-outline-primary" title="Edit Entry">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.WorkStatusId" class="btn btn-outline-danger" title="Delete Entry" onclick="return confirm('Are you sure you want to delete this work status entry?');">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-activity fs-1 d-block mb-2 text-opacity-50"></i>
                                    <p class="mb-0 fs-6">No production work status entries found in database.</p>
                                    <a asp-action="Create" class="btn btn-sm btn-primary rounded-pill mt-3">
                                        <i class="bi bi-plus-circle me-1"></i> Create First Entry
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
