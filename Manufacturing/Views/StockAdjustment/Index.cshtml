@model List<Manufacturing.Models.StockAdjustment>

@{
    ViewData["Title"] = "Stock Adjustments - Inventory Manager Portal";

    var adjustments = Model ?? new List<Manufacturing.Models.StockAdjustment>();

    int totalAdjustments = adjustments.Count;
    int addCount = adjustments.Count(a => string.Equals(a.AdjustmentType, "Add", StringComparison.OrdinalIgnoreCase) ||
                                          string.Equals(a.AdjustmentType, "Increase", StringComparison.OrdinalIgnoreCase));
    int deductCount = adjustments.Count(a => string.Equals(a.AdjustmentType, "Deduct", StringComparison.OrdinalIgnoreCase) ||
                                             string.Equals(a.AdjustmentType, "Decrease", StringComparison.OrdinalIgnoreCase) ||
                                             string.Equals(a.AdjustmentType, "Scrap", StringComparison.OrdinalIgnoreCase) ||
                                             string.Equals(a.AdjustmentType, "Damaged", StringComparison.OrdinalIgnoreCase));
    long netAdjustmentVolume = adjustments.Sum(a =>
        (string.Equals(a.AdjustmentType, "Deduct", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(a.AdjustmentType, "Decrease", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(a.AdjustmentType, "Scrap", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(a.AdjustmentType, "Damaged", StringComparison.OrdinalIgnoreCase))
        ? -1L * a.AdjustmentQuantity
        : (long)a.AdjustmentQuantity);

    string getStatusBadgeClass(string? status)
    {
        switch (status?.Trim().ToLower())
        {
            case "adjusted":
            case "approved":
            case "completed":
                return "bg-success text-white";
            case "pending":
            case "processing":
                return "bg-warning text-dark";
            case "rejected":
            case "cancelled":
                return "bg-danger text-white";
            default:
                return "bg-secondary text-white";
        }
    }

    string getTypeBadgeClass(string? type)
    {
        switch (type?.Trim().ToLower())
        {
            case "add":
            case "increase":
                return "bg-success bg-opacity-10 text-success border border-success border-opacity-25";
            case "deduct":
            case "decrease":
                return "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25";
            case "scrap":
            case "damaged":
                return "bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25";
            case "correction":
            default:
                return "bg-info bg-opacity-10 text-info border border-info border-opacity-25";
        }
    }
}

<div class="container-fluid px-4 py-4">
    <!-- TempData Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Top Navigation Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow text-white" style="background: linear-gradient(135deg, #064e3b 0%, #047857 50%, #059669 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Inventory Manager Portal</span>
                <span class="badge bg-white bg-opacity-25 text-white px-3 py-1 rounded-pill fs-7">Stock Variance & Audit Ledger</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-sliders text-warning me-2 fs-2"></i> Stock Adjustment Management
            </h2>
            <p class="text-emerald-100 mb-0 opacity-85">
                Inventory Manager Control Hub: Log physical stock audit variances, scrap deductions, and stock adjustments.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-warning rounded-pill px-4 py-2 shadow-sm fw-bold text-dark">
                <i class="bi bi-plus-circle-fill me-1"></i> New Stock Adjustment
            </a>
            <button type="button" onclick="exportAdjustmentCSV()" class="btn btn-light rounded-pill px-4 py-2 shadow-sm fw-semibold text-emerald-900">
                <i class="bi bi-file-earmark-spreadsheet me-1 text-success"></i> Export CSV
            </button>
            <a asp-controller="Account" asp-action="Dashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Inventory Dashboard
            </a>
        </div>
    </div>

    <!-- Inventory Manager KPI Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Adjustments</div>
                        <div class="fs-3 fw-bold text-success mb-0" id="statTotalAdjustments">@totalAdjustments</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-sliders fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Positive Additions</div>
                        <div class="fs-3 fw-bold text-primary mb-0" id="statAddCount">@addCount</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-plus-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-danger">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Deductions / Scrap</div>
                        <div class="fs-3 fw-bold text-danger mb-0" id="statDeductCount">@deductCount</div>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-dash-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Net Volume Impact</div>
                        <div class="fs-3 fw-bold @(netAdjustmentVolume >= 0 ? "text-success" : "text-danger") mb-0" id="statNetVolume">
                            @(netAdjustmentVolume >= 0 ? "+" : "")@netAdjustmentVolume.ToString("N0")
                        </div>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-boxes fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stock Adjustment Control Panel & Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-list-columns-reverse text-success fs-5"></i>
                <h5 class="fw-bold text-dark mb-0">Stock Adjustment Audit Log</h5>
                <span class="badge bg-light text-dark rounded-pill border ms-1" id="visibleRowCount">@totalAdjustments Record(s)</span>
            </div>

            <!-- Toolbar Controls -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Search Box -->
                <div class="input-group input-group-sm rounded-pill overflow-hidden border" style="max-width: 280px;">
                    <span class="input-group-text bg-white border-0 ps-3">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" id="adjustmentSearchInput" class="form-control border-0 shadow-none ps-1" placeholder="Search adjustments..." onkeyup="filterAdjustments()" />
                </div>

                <!-- Type Filter -->
                <select id="typeFilterSelect" class="form-select form-select-sm rounded-pill border px-3" style="width: auto;" onchange="filterAdjustments()">
                    <option value="">All Types</option>
                    <option value="Add">Add</option>
                    <option value="Deduct">Deduct</option>
                    <option value="Scrap">Scrap</option>
                    <option value="Damaged">Damaged</option>
                    <option value="Correction">Correction</option>
                </select>

                <!-- Status Filter -->
                <select id="statusFilterSelect" class="form-select form-select-sm rounded-pill border px-3" style="width: auto;" onchange="filterAdjustments()">
                    <option value="">All Statuses</option>
                    <option value="Adjusted">Adjusted</option>
                    <option value="Approved">Approved</option>
                    <option value="Pending">Pending</option>
                    <option value="Rejected">Rejected</option>
                </select>

                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="resetFilters()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            @if (adjustments.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-inbox text-muted display-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark">No Stock Adjustment Records Found</h5>
                    <p class="text-muted small mb-3">There are currently no stock adjustment entries recorded in the database.</p>
                    <a asp-action="Create" class="btn btn-success rounded-pill px-4 py-2">
                        <i class="bi bi-plus-circle-fill me-2"></i> Log New Stock Adjustment
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="adjustmentTable">
                        <thead class="bg-light text-muted small text-uppercase fw-semibold border-bottom">
                            <tr>
                                <th class="ps-4 py-3">Adjustment ID</th>
                                <th class="py-3">Raw Material</th>
                                <th class="py-3 text-end">Current Stock</th>
                                <th class="py-3 text-end">Adjustment Qty</th>
                                <th class="py-3">Type</th>
                                <th class="py-3">Adjustment Date</th>
                                <th class="py-3">Reason</th>
                                <th class="py-3">Adjusted By</th>
                                <th class="py-3">Status</th>
                                <th class="pe-4 py-3 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in adjustments)
                            {
                                var statusClass = getStatusBadgeClass(item.Status);
                                var typeClass = getTypeBadgeClass(item.AdjustmentType);
                                var adjustedByText = string.IsNullOrEmpty(item.AdjustedBy) ? "Inventory Manager" : item.AdjustedBy;
                                var reasonText = string.IsNullOrEmpty(item.Reason) ? "Audit Discrepancy" : item.Reason;
                                var isDeduct = string.Equals(item.AdjustmentType, "Deduct", StringComparison.OrdinalIgnoreCase) ||
                                               string.Equals(item.AdjustmentType, "Decrease", StringComparison.OrdinalIgnoreCase) ||
                                               string.Equals(item.AdjustmentType, "Scrap", StringComparison.OrdinalIgnoreCase) ||
                                               string.Equals(item.AdjustmentType, "Damaged", StringComparison.OrdinalIgnoreCase);

                                <tr class="adjustment-row"
                                    data-id="@item.AdjustmentId"
                                    data-material="@item.MaterialName"
                                    data-type="@(item.AdjustmentType ?? "Add")"
                                    data-status="@(item.Status ?? "Adjusted")"
                                    data-reason="@reasonText"
                                    data-by="@adjustedByText"
                                    data-search="@item.AdjustmentId @item.MaterialName @item.AdjustmentType @reasonText @adjustedByText @item.Status @item.Remarks">
                                    
                                    <td class="ps-4 py-3 fw-bold text-success">
                                        <i class="bi bi-hash text-muted me-1"></i>ADJ-@item.AdjustmentId.ToString("D4")
                                    </td>
                                    
                                    <td class="py-3">
                                        <div class="fw-bold text-dark">
                                            <i class="bi bi-box-seam me-1 text-warning"></i>@(string.IsNullOrEmpty(item.MaterialName) ? $"Material #{item.MaterialId}" : item.MaterialName)
                                        </div>
                                        <small class="text-muted">ID: #@item.MaterialId</small>
                                    </td>

                                    <td class="py-3 text-end fw-semibold text-muted">
                                        @item.CurrentStock.ToString("N0")
                                    </td>

                                    <td class="py-3 text-end fw-bold fs-6 @(isDeduct ? "text-danger" : "text-success")">
                                        @(isDeduct ? "-" : "+")@item.AdjustmentQuantity.ToString("N0")
                                    </td>

                                    <td class="py-3">
                                        <span class="badge @typeClass px-3 py-1 rounded-pill fw-semibold small">
                                            <i class="bi @(isDeduct ? "bi-arrow-down-right" : "bi-arrow-up-right") me-1"></i>
                                            @(string.IsNullOrEmpty(item.AdjustmentType) ? "Add" : item.AdjustmentType)
                                        </span>
                                    </td>

                                    <td class="py-3">
                                        <div class="small fw-semibold text-dark">@item.AdjustmentDate.ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted">@item.AdjustmentDate.ToString("hh:mm tt")</small>
                                    </td>

                                    <td class="py-3">
                                        <span class="small fw-medium text-dark">
                                            <i class="bi bi-info-circle me-1 text-primary"></i>@reasonText
                                        </span>
                                    </td>

                                    <td class="py-3">
                                        <span class="small text-dark">
                                            <i class="bi bi-person-circle me-1 text-success"></i>@adjustedByText
                                        </span>
                                    </td>

                                    <td class="py-3">
                                        <span class="badge @statusClass px-3 py-1 rounded-pill fw-semibold small">
                                            @(string.IsNullOrEmpty(item.Status) ? "Adjusted" : item.Status)
                                        </span>
                                    </td>

                                    <td class="pe-4 py-3 text-end">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.AdjustmentId" class="btn btn-sm btn-outline-success rounded-start-pill" title="View Audit Details">
                                                <i class="bi bi-eye-fill me-1"></i> Details
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.AdjustmentId" class="btn btn-sm btn-outline-primary" title="Edit Adjustment">
                                                <i class="bi bi-pencil-square me-1"></i> Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.AdjustmentId" class="btn btn-sm btn-outline-danger rounded-end-pill" title="Delete Adjustment" onclick="return confirm('Are you sure you want to delete Stock Adjustment ADJ-@item.AdjustmentId.ToString("D4")?');">
                                                <i class="bi bi-trash-fill me-1"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="card-footer bg-light py-3 px-4 border-top text-muted small d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-shield-check text-success me-1"></i> Inventory Manager Control Panel | Stock Adjustment Audit System
            </div>
            <div>
                Total Logged Adjustments: <strong class="text-dark">@totalAdjustments Entry(ies)</strong>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterAdjustments() {
            const searchValue = document.getElementById('adjustmentSearchInput').value.toLowerCase().trim();
            const typeValue = document.getElementById('typeFilterSelect').value.toLowerCase().trim();
            const statusValue = document.getElementById('statusFilterSelect').value.toLowerCase().trim();
            const rows = document.querySelectorAll('.adjustment-row');

            let visibleCount = 0;

            rows.forEach(row => {
                const searchText = (row.getAttribute('data-search') || '').toLowerCase();
                const rowType = (row.getAttribute('data-type') || '').toLowerCase();
                const rowStatus = (row.getAttribute('data-status') || '').toLowerCase();

                const matchesSearch = !searchValue || searchText.includes(searchValue);
                const matchesType = !typeValue || rowType.includes(typeValue);
                const matchesStatus = !statusValue || rowStatus.includes(statusValue);

                if (matchesSearch && matchesType && matchesStatus) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const visibleBadge = document.getElementById('visibleRowCount');
            if (visibleBadge) {
                visibleBadge.textContent = visibleCount + ' Record(s)';
            }
        }

        function resetFilters() {
            document.getElementById('adjustmentSearchInput').value = '';
            document.getElementById('typeFilterSelect').value = '';
            document.getElementById('statusFilterSelect').value = '';
            filterAdjustments();
        }

        function exportAdjustmentCSV() {
            const rows = document.querySelectorAll('.adjustment-row');
            if (!rows.length) {
                alert('No adjustment data available to export.');
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,Adjustment ID,Raw Material,Type,Status,Reason,Adjusted By\n";

            rows.forEach(row => {
                const id = row.getAttribute('data-id');
                const material = '"' + (row.getAttribute('data-material') || '').replace(/"/g, '""') + '"';
                const type = '"' + (row.getAttribute('data-type') || '').replace(/"/g, '""') + '"';
                const status = '"' + (row.getAttribute('data-status') || '').replace(/"/g, '""') + '"';
                const reason = '"' + (row.getAttribute('data-reason') || '').replace(/"/g, '""') + '"';
                const by = '"' + (row.getAttribute('data-by') || '').replace(/"/g, '""') + '"';

                csvContent += `ADJ-${id},${material},${type},${status},${reason},${by}\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `stock_adjustments_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
}
