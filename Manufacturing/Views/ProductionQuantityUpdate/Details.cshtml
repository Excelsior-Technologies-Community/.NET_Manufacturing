@model Manufacturing.Models.ProductionQuantityUpdate

@{
    ViewData["Title"] = $"Quantity Details PQU-#{Model?.QuantityUpdateId.ToString("D4")} - Machine Manager Portal";

    double completionPct = (Model?.PlannedQuantity ?? 0) > 0 
        ? Math.Min(100, Math.Round(((double)(Model?.ProducedQuantity ?? 0) / Model.PlannedQuantity) * 100, 1))
        : 0;

    double rejectionPct = (Model?.ProducedQuantity ?? 0) + (Model?.RejectedQuantity ?? 0) > 0
        ? Math.Round(((double)(Model?.RejectedQuantity ?? 0) / ((Model?.ProducedQuantity ?? 0) + (Model?.RejectedQuantity ?? 0))) * 100, 1)
        : 0;
}

<div class="container-fluid px-3 py-3">
    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #0e7490 50%, #0284c7 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-info text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Machine Manager Audit</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Ref: PQU-#@Model?.QuantityUpdateId.ToString("D4")</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-info-circle-fill text-info me-2 fs-2"></i> Production Quantity Update Details
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Machine Manager Audit Ledger: Comprehensive breakdown of output metrics, order completion, and operator details.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.QuantityUpdateId" class="btn btn-warning text-dark rounded-pill px-4 py-2 fw-semibold shadow-sm">
                <i class="bi bi-pencil-fill me-1"></i> Edit Record
            </a>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Ledger
            </a>
        </div>
    </div>

    <!-- Main Grid Content -->
    <div class="row g-4">
        <!-- Left Column: KPI Stats & Overview Card -->
        <div class="col-12 col-lg-8">
            <!-- Output Progress Meter Card -->
            <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="text-uppercase text-muted fw-bold fs-7">Production Progress Metric</span>
                            <h4 class="fw-bold text-dark mb-0">@completionPct% Target Completion</h4>
                        </div>
                        <div>
                            @if ((Model?.RemainingQuantity ?? 0) <= 0)
                            {
                                <span class="badge bg-success text-white fs-6 px-3 py-2 rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i> Target Achieved
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill">
                                    <i class="bi bi-hourglass-split me-1"></i> @Model?.RemainingQuantity Units Pending
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="progress rounded-pill mb-2" style="height: 14px;">
                        <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" role="progressbar" style="width: @completionPct%;" aria-valuenow="@completionPct" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>0 units</span>
                        <span>Produced: @Model?.ProducedQuantity.ToString("N0") / Planned: @Model?.PlannedQuantity.ToString("N0")</span>
                        <span>Planned Target: @Model?.PlannedQuantity.ToString("N0")</span>
                    </div>
                </div>
            </div>

            <!-- Key Metrics Grid -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-sm-3">
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-4 border-primary">
                        <small class="text-muted text-uppercase fw-semibold fs-8">Planned Target</small>
                        <div class="fs-4 fw-bold text-primary mb-0">@Model?.PlannedQuantity.ToString("N0")</div>
                        <small class="text-muted fs-8">Total units ordered</small>
                    </div>
                </div>
                <div class="col-6 col-sm-3">
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-4 border-success">
                        <small class="text-muted text-uppercase fw-semibold fs-8">Produced Units</small>
                        <div class="fs-4 fw-bold text-success mb-0">@Model?.ProducedQuantity.ToString("N0")</div>
                        <small class="text-muted fs-8">Good quality output</small>
                    </div>
                </div>
                <div class="col-6 col-sm-3">
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-4 border-danger">
                        <small class="text-muted text-uppercase fw-semibold fs-8">Rejected Units</small>
                        <div class="fs-4 fw-bold text-danger mb-0">@Model?.RejectedQuantity.ToString("N0")</div>
                        <small class="text-muted fs-8">@rejectionPct% defect rate</small>
                    </div>
                </div>
                <div class="col-6 col-sm-3">
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-4 border-warning">
                        <small class="text-muted text-uppercase fw-semibold fs-8">Remaining Units</small>
                        <div class="fs-4 fw-bold text-warning-emphasis mb-0">@Model?.RemainingQuantity.ToString("N0")</div>
                        <small class="text-muted fs-8">Left to produce</small>
                    </div>
                </div>
            </div>

            <!-- Detailed Breakdown Card -->
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-transparent border-0 p-4 pb-0">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-file-earmark-text text-info me-2"></i> Production Record Audit Details
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle mb-0">
                            <tbody>
                                <tr class="border-bottom">
                                    <th class="ps-0 text-muted fw-normal py-3" style="width: 35%;">Log Reference ID</th>
                                    <td class="pe-0 py-3 fw-bold text-dark">PQU-#@Model?.QuantityUpdateId.ToString("D4")</td>
                                </tr>
                                <tr class="border-bottom">
                                    <th class="ps-0 text-muted fw-normal py-3">Production Order</th>
                                    <td class="pe-0 py-3">
                                        <span class="badge bg-light text-dark border px-3 py-2 font-monospace fs-7">
                                            <i class="bi bi-hash me-1 text-primary"></i>@(string.IsNullOrEmpty(Model?.OrderNo) ? "Order #" + Model?.ProductionOrderId : Model?.OrderNo)
                                        </span>
                                    </td>
                                </tr>
                                <tr class="border-bottom">
                                    <th class="ps-0 text-muted fw-normal py-3">Assigned Machine</th>
                                    <td class="pe-0 py-3 fw-semibold text-dark">
                                        <i class="bi bi-cpu-fill text-info me-2"></i>@(string.IsNullOrEmpty(Model?.MachineName) ? "Machine #" + Model?.MachineId : Model?.MachineName)
                                    </td>
                                </tr>
                                <tr class="border-bottom">
                                    <th class="ps-0 text-muted fw-normal py-3">Operator / Employee</th>
                                    <td class="pe-0 py-3 text-secondary">
                                        <i class="bi bi-person-circle text-primary me-2"></i>@(string.IsNullOrEmpty(Model?.EmployeeName) ? "Employee #" + Model?.EmployeeId : Model?.EmployeeName)
                                    </td>
                                </tr>
                                <tr class="border-bottom">
                                    <th class="ps-0 text-muted fw-normal py-3">Log Update Date</th>
                                    <td class="pe-0 py-3 text-dark fw-semibold">
                                        <i class="bi bi-calendar3 text-muted me-2"></i>@Model?.UpdateDate.ToString("dd MMMM yyyy")
                                    </td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-muted fw-normal py-3">System Entry Date</th>
                                    <td class="pe-0 py-3 text-muted">
                                        <i class="bi bi-clock-history me-2"></i>@(Model?.CreatedDate != DateTime.MinValue ? Model?.CreatedDate.ToString("yyyy-MM-dd HH:mm") : "N/A")
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Remarks Card & Sidebar Info -->
        <div class="col-12 col-lg-4">
            <!-- Remarks Card -->
            <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
                <div class="card-header bg-transparent border-0 p-4 pb-0">
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="bi bi-chat-left-text text-info me-2"></i> Remarks & Shift Notes
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (string.IsNullOrWhiteSpace(Model?.Remarks))
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-chat-square-dots fs-2 opacity-50 mb-2"></i>
                            <p class="mb-0">No shift remarks logged for this update.</p>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 bg-light rounded-3 text-dark border-start border-4 border-info">
                            <p class="mb-0 text-break" style="white-space: pre-line;">@Model?.Remarks</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Audit System Card -->
            <div class="card border-0 shadow-sm rounded-4 text-white p-4" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 rounded-circle bg-white bg-opacity-10 me-3 text-info">
                        <i class="bi bi-shield-check fs-2"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-white mb-0">Verified Output Audit</h6>
                        <small class="text-slate-400 opacity-75">Machine Manager System</small>
                    </div>
                </div>
                <p class="text-slate-300 small mb-3 opacity-75">
                    This quantity update record has been logged in the Machine Operations ledger. You can update or delete this entry if corrections are required.
                </p>
                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.QuantityUpdateId" class="btn btn-warning text-dark rounded-pill fw-semibold">
                        <i class="bi bi-pencil-fill me-1"></i> Edit This Entry
                    </a>
                    <button type="button" class="btn btn-outline-danger rounded-pill" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        <i class="bi bi-trash-fill me-1"></i> Delete Record
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 bg-danger bg-opacity-10 text-danger rounded-top-4">
                <h5 class="modal-title fw-bold" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-2">Are you sure you want to delete this Production Quantity Update record?</p>
                <div class="card bg-light border-0 p-3 mb-0 rounded-3">
                    <div><strong>Ref:</strong> PQU-#@Model?.QuantityUpdateId.ToString("D4")</div>
                    <div><strong>Order:</strong> @Model?.OrderNo</div>
                    <div><strong>Machine:</strong> @Model?.MachineName</div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <a asp-action="Delete" asp-route-id="@Model?.QuantityUpdateId" class="btn btn-danger rounded-pill px-4">
                    Delete Record
                </a>
            </div>
        </div>
    </div>
</div>
