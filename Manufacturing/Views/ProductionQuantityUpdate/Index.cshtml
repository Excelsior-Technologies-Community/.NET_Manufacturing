@model List<Manufacturing.Models.ProductionQuantityUpdate>

@{
    ViewData["Title"] = "Production Quantity Updates - Machine Manager Portal";

    var updates = Model ?? new List<Manufacturing.Models.ProductionQuantityUpdate>();
    int totalUpdates = updates.Count;
    int totalPlanned = updates.Sum(x => x.PlannedQuantity);
    int totalProduced = updates.Sum(x => x.ProducedQuantity);
    int totalRejected = updates.Sum(x => x.RejectedQuantity);
    int totalRemaining = updates.Sum(x => x.RemainingQuantity);
}

<div class="container-fluid px-3 py-3">
    <!-- TempData Success Alert -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-2 fs-4 text-success"></i>
                <div>
                    <strong>Success!</strong> @TempData["Success"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #0e7490 50%, #0284c7 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-info text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Machine Manager Portal</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Production Output Ledger</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-bar-chart-line-fill text-info me-2 fs-2"></i> Production Quantity Updates
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Machine Manager Hub: Log machine output, track target vs produced units, monitor defect rejections, and review order progress.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-light rounded-pill px-4 py-2 shadow-sm fw-semibold text-primary">
                <i class="bi bi-plus-circle-fill me-1 text-info"></i> Update Quantity
            </a>
            <a asp-controller="Account" asp-action="MachineManagerDashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Log Entries</div>
                        <div class="fs-3 fw-bold text-info mb-0">@totalUpdates</div>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-journal-text fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Planned</div>
                        <div class="fs-3 fw-bold text-primary mb-0">@totalPlanned.ToString("N0")</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-bullseye fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Produced</div>
                        <div class="fs-3 fw-bold text-success mb-0">@totalProduced.ToString("N0")</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-check2-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-danger">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Rejected</div>
                        <div class="fs-3 fw-bold text-danger mb-0">@totalRejected.ToString("N0")</div>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-x-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="card-header bg-transparent border-0 p-4 pb-2 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h5 class="fw-bold text-dark mb-0 d-flex align-items-center">
                    <i class="bi bi-list-task me-2 text-info"></i> Quantity Log Roster
                </h5>
                <p class="text-muted small mb-0">Detailed breakdown of machine production logs and operator entries</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm style-search" style="width: 250px;">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="tableSearchInput" class="form-control border-start-0 bg-light" placeholder="Search order, machine..." />
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            @if (!updates.Any())
            {
                <div class="text-center py-5">
                    <div class="rounded-circle bg-light d-inline-flex p-4 mb-3">
                        <i class="bi bi-inbox fs-1 text-muted"></i>
                    </div>
                    <h5 class="fw-semibold text-dark">No Production Updates Found</h5>
                    <p class="text-muted mb-3">No quantity update logs have been submitted yet.</p>
                    <a asp-action="Create" class="btn btn-info text-white rounded-pill px-4">
                        <i class="bi bi-plus-circle me-1"></i> Log First Update
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="quantityUpdateTable">
                        <thead class="bg-light text-muted fs-7 text-uppercase border-bottom">
                            <tr>
                                <th class="ps-4">Log Ref / Date</th>
                                <th>Order No</th>
                                <th>Machine</th>
                                <th>Operator</th>
                                <th class="text-center">Planned</th>
                                <th class="text-center">Produced</th>
                                <th class="text-center">Rejected</th>
                                <th class="text-center">Remaining</th>
                                <th>Remarks</th>
                                <th class="pe-4 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in updates)
                            {
                                double completionPct = item.PlannedQuantity > 0 ? ((double)item.ProducedQuantity / item.PlannedQuantity) * 100 : 0;
                                string pctBadgeClass = completionPct >= 100 ? "bg-success" : completionPct >= 50 ? "bg-info text-dark" : "bg-warning text-dark";

                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">PQU-#@item.QuantityUpdateId.ToString("D4")</div>
                                        <div class="small text-muted">
                                            <i class="bi bi-calendar3 me-1"></i>@item.UpdateDate.ToString("yyyy-MM-dd")
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1 font-monospace">
                                            <i class="bi bi-hash me-1 text-secondary"></i>@(string.IsNullOrEmpty(item.OrderNo) ? "Order #" + item.ProductionOrderId : item.OrderNo)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark d-flex align-items-center">
                                            <i class="bi bi-cpu-fill text-info me-2"></i>
                                            @(string.IsNullOrEmpty(item.MachineName) ? "Machine #" + item.MachineId : item.MachineName)
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-secondary small">
                                            <i class="bi bi-person-circle me-1"></i>
                                            @(string.IsNullOrEmpty(item.EmployeeName) ? "Employee #" + item.EmployeeId : item.EmployeeName)
                                        </div>
                                    </td>
                                    <td class="text-center fw-semibold text-dark">
                                        @item.PlannedQuantity.ToString("N0")
                                    </td>
                                    <td class="text-center fw-bold text-success">
                                        @item.ProducedQuantity.ToString("N0")
                                    </td>
                                    <td class="text-center fw-semibold text-danger">
                                        @item.RejectedQuantity.ToString("N0")
                                    </td>
                                    <td class="text-center">
                                        @if (item.RemainingQuantity <= 0)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                                <i class="bi bi-check-all me-1"></i> Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1">
                                                @item.RemainingQuantity.ToString("N0") units
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="text-truncate text-secondary small" style="max-width: 180px;" title="@item.Remarks">
                                            @(string.IsNullOrWhiteSpace(item.Remarks) ? "—" : item.Remarks)
                                        </div>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.QuantityUpdateId" class="btn btn-light rounded-start-circle shadow-sm" title="View Details">
                                                <i class="bi bi-eye-fill text-info"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.QuantityUpdateId" class="btn btn-light shadow-sm" title="Edit Record">
                                                <i class="bi bi-pencil-fill text-primary"></i>
                                            </a>
                                            <button type="button" class="btn btn-light rounded-end-circle shadow-sm text-danger" title="Delete Record" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.QuantityUpdateId">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </div>

                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade text-start" id="deleteModal-@item.QuantityUpdateId" tabindex="-1" aria-labelledby="deleteModalLabel-@item.QuantityUpdateId" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <div class="modal-header border-0 bg-danger bg-opacity-10 text-danger rounded-top-4">
                                                        <h5 class="modal-title fw-bold" id="deleteModalLabel-@item.QuantityUpdateId">
                                                            <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Delete
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <p class="mb-2">Are you sure you want to delete this Production Quantity Update record?</p>
                                                        <div class="card bg-light border-0 p-3 mb-0 rounded-3">
                                                            <div><strong>Ref:</strong> PQU-#@item.QuantityUpdateId.ToString("D4")</div>
                                                            <div><strong>Order:</strong> @item.OrderNo</div>
                                                            <div><strong>Machine:</strong> @item.MachineName</div>
                                                            <div><strong>Produced Qty:</strong> @item.ProducedQuantity</div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                                        <a asp-action="Delete" asp-route-id="@item.QuantityUpdateId" class="btn btn-danger rounded-pill px-4">
                                                            Delete Record
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        
        <div class="card-footer bg-transparent border-top p-3 text-muted fs-7 d-flex justify-content-between align-items-center">
            <div><i class="bi bi-shield-check text-success me-1"></i> Machine Manager Control Ledger | Production Quantity System</div>
            <div>Total Records: <strong>@totalUpdates</strong></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var searchInput = document.getElementById('tableSearchInput');
            var table = document.getElementById('quantityUpdateTable');

            if (searchInput && table) {
                searchInput.addEventListener('keyup', function () {
                    var filter = searchInput.value.toLowerCase();
                    var rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

                    for (var i = 0; i < rows.length; i++) {
                        var text = rows[i].textContent || rows[i].innerText;
                        if (text.toLowerCase().indexOf(filter) > -1) {
                            rows[i].style.display = '';
                        } else {
                            rows[i].style.display = 'none';
                        }
                    }
                });
            }
        });
    </script>
}
