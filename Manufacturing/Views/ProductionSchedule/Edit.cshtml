@model Manufacturing.Models.ProductionSchedules

@{
    ViewData["Title"] = "Edit Production Schedule";
}

<div class="container-fluid px-3 py-3">
    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #2563eb 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Edit Mode</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Schedule #@Model.ScheduleId</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-pencil-square text-warning me-2 fs-2"></i> Modify Production Schedule
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Production Manager: Adjust planned dates, operational status, and priority for this schedule</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Details" asp-route-id="@Model.ScheduleId" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-eye-fill me-1"></i> View Details
            </a>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Schedules
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-sliders text-warning me-2"></i> Update Schedule Information
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="ScheduleId" />

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="ProductionOrderId" class="form-label fw-semibold">Production Order <span class="text-danger">*</span></label>
                                <select asp-for="ProductionOrderId" asp-items="@ViewBag.OrderList" class="form-select rounded-3 py-2" required>
                                    <option value="">-- Select Production Order --</option>
                                </select>
                                <span asp-validation-for="ProductionOrderId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-semibold">Start Date <span class="text-danger">*</span></label>
                                <input asp-for="StartDate" type="date" class="form-control rounded-3 py-2" value="@Model.StartDate.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-semibold">End Date <span class="text-danger">*</span></label>
                                <input asp-for="EndDate" type="date" class="form-control rounded-3 py-2" value="@Model.EndDate.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Priority" class="form-label fw-semibold">Priority Level</label>
                                <select asp-for="Priority" class="form-select rounded-3 py-2">
                                    <option value="Low">Low</option>
                                    <option value="Medium">Medium</option>
                                    <option value="High">High</option>
                                    <option value="Critical">Critical</option>
                                </select>
                                <span asp-validation-for="Priority" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold">Schedule Status</label>
                                <select asp-for="Status" class="form-select rounded-3 py-2">
                                    <option value="Scheduled">Scheduled</option>
                                    <option value="In Progress">In Progress</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Delayed">Delayed</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold">Remarks & Notes</label>
                                <textarea asp-for="Remarks" class="form-control rounded-3" rows="3" maxlength="500" placeholder="Enter notes or updates regarding schedule execution..."></textarea>
                                <span asp-validation-for="Remarks" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">Cancel</a>
                            <button type="submit" class="btn btn-warning rounded-pill px-4 py-2 fw-semibold text-dark">
                                <i class="bi bi-check-circle-fill me-1"></i> Update Schedule
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
