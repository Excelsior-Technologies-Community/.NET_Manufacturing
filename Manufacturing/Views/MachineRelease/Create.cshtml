@model Manufacturing.Models.MachineRelease

@{
    ViewData["Title"] = "Release Machine - Machine Manager Portal";

    var machineList = ViewBag.MachineList as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var orderList = ViewBag.OrderList as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container-fluid px-4 py-4">
    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0d9488 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-teal text-white px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold" style="background-color: #0d9488;">Machine Manager Portal</span>
                <span class="badge bg-white bg-opacity-25 text-white px-3 py-1 rounded-pill fs-7">Equipment Offboarding</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-plus-circle-fill text-info me-2 fs-2"></i> Log Machine Release
            </h2>
            <p class="text-slate-300 mb-0 opacity-85">
                Record machine release information, running hours, status, and release authorization.
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 shadow-sm fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Releases
            </a>
        </div>
    </div>

    <!-- Main Card Container -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center">
                        <i class="bi bi-card-checklist text-primary me-2"></i> Equipment Release Entry Form
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="createReleaseForm">
                        <!-- Hidden inputs for display properties to satisfy ASP.NET Core model validation -->
                        <input type="hidden" asp-for="MachineName" value="@(Model?.MachineName ?? "N/A")" />
                        <input type="hidden" asp-for="OrderNo" value="@(Model?.OrderNo ?? "N/A")" />

                        <div class="row g-4">
                            <!-- Machine Selection -->
                            <div class="col-md-6">
                                <label asp-for="MachineId" class="form-label fw-semibold text-dark">
                                    Machine <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-cpu text-info"></i>
                                    </span>
                                    <select asp-for="MachineId" asp-items="machineList" class="form-select border-start-0 py-2">
                                        <option value="">-- Select Machine --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="MachineId" class="text-danger fs-7"></span>
                            </div>

                            <!-- Production Order Selection -->
                            <div class="col-md-6">
                                <label asp-for="ProductionOrderId" class="form-label fw-semibold text-dark">
                                    Production Order <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-journal-text text-primary"></i>
                                    </span>
                                    <select asp-for="ProductionOrderId" asp-items="orderList" class="form-select border-start-0 py-2">
                                        <option value="">-- Select Production Order --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="ProductionOrderId" class="text-danger fs-7"></span>
                            </div>

                            <!-- Release Date & Time -->
                            <div class="col-md-6">
                                <label asp-for="ReleaseDate" class="form-label fw-semibold text-dark">
                                    Release Date & Time <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-calendar-event text-success"></i>
                                    </span>
                                    <input asp-for="ReleaseDate" type="datetime-local" class="form-control border-start-0 py-2" value="@(Model != null && Model.ReleaseDate != default && Model.ReleaseDate != DateTime.MinValue ? Model.ReleaseDate.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))" />
                                </div>
                                <span asp-validation-for="ReleaseDate" class="text-danger fs-7"></span>
                            </div>

                            <!-- Released By -->
                            <div class="col-md-6">
                                <label asp-for="ReleasedBy" class="form-label fw-semibold text-dark">
                                    Released By (Manager / Supervisor)
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-person-badge text-warning"></i>
                                    </span>
                                    <input asp-for="ReleasedBy" type="text" class="form-control border-start-0 py-2" placeholder="e.g. Machine Manager" value="@(string.IsNullOrEmpty(Model?.ReleasedBy) ? "Machine Manager" : Model.ReleasedBy)" />
                                </div>
                                <span asp-validation-for="ReleasedBy" class="text-danger fs-7"></span>
                            </div>

                            <!-- Running Hours -->
                            <div class="col-md-6">
                                <label asp-for="RunningHours" class="form-label fw-semibold text-dark">
                                    Running Hours (Hours)
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-clock-history text-info"></i>
                                    </span>
                                    <input asp-for="RunningHours" type="number" step="0.1" min="0" class="form-control border-start-0 py-2" placeholder="e.g. 8.5" />
                                </div>
                                <span asp-validation-for="RunningHours" class="text-danger fs-7"></span>
                            </div>

                            <!-- Release Status -->
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold text-dark">
                                    Release Status
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-shield-check text-success"></i>
                                    </span>
                                    <select asp-for="Status" class="form-select border-start-0 py-2">
                                        <option value="Released">Released</option>
                                        <option value="Completed">Completed</option>
                                        <option value="Pending">Pending</option>
                                        <option value="Maintenance">Maintenance</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Status" class="text-danger fs-7"></span>
                            </div>

                            <!-- Remarks -->
                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold text-dark">
                                    Remarks / Operating Notes
                                </label>
                                <textarea asp-for="Remarks" rows="4" class="form-control py-2" placeholder="Enter equipment condition upon release, job highlights, or handoff notes..."></textarea>
                                <span asp-validation-for="Remarks" class="text-danger fs-7"></span>
                            </div>
                        </div>

                        <!-- Form Actions Footer -->
                        <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-success rounded-pill px-5 py-2 fw-bold shadow-sm">
                                <i class="bi bi-check-circle-fill me-1"></i> Release Machine
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
