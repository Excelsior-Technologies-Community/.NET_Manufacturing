@model Manufacturing.Models.MachineIssue

@{
    ViewData["Title"] = $"Issue Details #ISS-{Model.IssueId:D4} - Machine Manager Portal";

    string getPriorityBadge(string? priority)
    {
        switch (priority?.Trim().ToLower())
        {
            case "critical":
                return "bg-danger text-white";
            case "high":
                return "bg-warning text-dark";
            case "medium":
                return "bg-info text-dark";
            case "low":
                return "bg-secondary text-white";
            default:
                return "bg-light text-dark border";
        }
    }

    string getStatusBadge(string? status)
    {
        switch (status?.Trim().ToLower())
        {
            case "resolved":
            case "closed":
                return "bg-success text-white";
            case "in progress":
                return "bg-primary text-white";
            case "open":
                return "bg-warning text-dark";
            case "on hold":
                return "bg-info text-dark";
            default:
                return "bg-secondary text-white";
        }
    }
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-10 col-lg-9">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden mb-4">
            <!-- Header Banner -->
            <div class="card-header text-white p-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #d97706 100%);">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Ticket ISS-@Model.IssueId.ToString("D4")</span>
                            <span class="badge @getStatusBadge(Model.Status) rounded-pill px-3 py-1 fs-7">@Model.Status</span>
                            <span class="badge @getPriorityBadge(Model.Priority) rounded-pill px-3 py-1 fs-7">@Model.Priority Priority</span>
                        </div>
                        <h3 class="fw-bold mb-1 d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill text-warning me-2 fs-2"></i> @(string.IsNullOrEmpty(Model.MachineName) ? $"Machine #{Model.MachineId}" : Model.MachineName) Issue Details
                        </h3>
                        <p class="mb-0 text-white-50 fs-6">Equipment Breakdown & Fault Inspection Log</p>
                    </div>
                    <div class="mt-3 mt-md-0 d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.IssueId" class="btn btn-warning rounded-pill px-4 fw-bold text-dark shadow-sm">
                            <i class="bi bi-pencil-fill me-1"></i> Edit Issue
                        </a>
                        <a asp-action="Index" class="btn btn-outline-light rounded-pill px-3">
                            <i class="bi bi-arrow-left me-1"></i> Back to Roster
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card Body Details -->
            <div class="card-body p-4 p-md-5">
                <div class="row g-4 mb-4">
                    <!-- Left Column: Equipment & Order Context -->
                    <div class="col-md-6">
                        <div class="card border-0 bg-light rounded-4 p-4 h-100">
                            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                <i class="bi bi-cpu text-info me-2"></i> Equipment & Order Context
                            </h5>
                            <dl class="row mb-0 fs-6">
                                <dt class="col-sm-5 text-muted fw-semibold mb-2">Target Machine:</dt>
                                <dd class="col-sm-7 fw-bold text-dark mb-2">@(string.IsNullOrEmpty(Model.MachineName) ? $"Machine #{Model.MachineId}" : Model.MachineName)</dd>

                                <dt class="col-sm-5 text-muted fw-semibold mb-2">Machine ID:</dt>
                                <dd class="col-sm-7 text-secondary mb-2">#@Model.MachineId</dd>

                                <dt class="col-sm-5 text-muted fw-semibold mb-2">Production Order:</dt>
                                <dd class="col-sm-7 text-dark mb-2">
                                    <span class="badge bg-white text-dark border px-2 py-1">
                                        <i class="bi bi-hash me-1"></i>@(string.IsNullOrEmpty(Model.OrderNo) ? $"Order #{Model.ProductionOrderId}" : Model.OrderNo)
                                    </span>
                                </dd>

                                <dt class="col-sm-5 text-muted fw-semibold mb-2">Order ID:</dt>
                                <dd class="col-sm-7 text-secondary mb-2">#@Model.ProductionOrderId</dd>

                                <dt class="col-sm-5 text-muted fw-semibold mb-0">Issue Category:</dt>
                                <dd class="col-sm-7 mb-0">
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 fs-7">
                                        @(string.IsNullOrEmpty(Model.IssueType) ? "General Fault" : Model.IssueType)
                                    </span>
                                </dd>
                            </dl>
                        </div>
                    </div>

                    <!-- Right Column: Incident & Reporter Information -->
                    <div class="col-md-6">
                        <div class="card border-0 bg-light rounded-4 p-4 h-100">
                            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                <i class="bi bi-person-badge text-warning me-2"></i> Reporter & Incident Timeline
                            </h5>
                            <dl class="row mb-0 fs-6">
                                <dt class="col-sm-5 text-muted fw-semibold mb-2">Reported By:</dt>
                                <dd class="col-sm-7 fw-semibold text-dark mb-2">
                                    <i class="bi bi-person-circle me-1 text-secondary"></i>@(string.IsNullOrEmpty(Model.ReportedBy) ? "Machine Operator" : Model.ReportedBy)
                                </dd>

                                <dt class="col-sm-5 text-muted fw-semibold mb-2">Issue Date:</dt>
                                <dd class="col-sm-7 text-dark mb-2">
                                    <i class="bi bi-calendar-event me-1 text-danger"></i>@Model.IssueDate.ToString("dd MMMM yyyy")
                                </dd>

                                <dt class="col-sm-5 text-muted fw-semibold mb-2">Priority Level:</dt>
                                <dd class="col-sm-7 mb-2">
                                    <span class="badge @getPriorityBadge(Model.Priority) rounded-pill px-3 py-1 fs-7 fw-semibold">
                                        @Model.Priority
                                    </span>
                                </dd>

                                <dt class="col-sm-5 text-muted fw-semibold mb-2">Resolution Status:</dt>
                                <dd class="col-sm-7 mb-2">
                                    <span class="badge @getStatusBadge(Model.Status) rounded-pill px-3 py-1 fs-7 fw-semibold">
                                        @Model.Status
                                    </span>
                                </dd>

                                <dt class="col-sm-5 text-muted fw-semibold mb-2">Resolved Date:</dt>
                                <dd class="col-sm-7 text-dark mb-2">
                                    @if (Model.ResolvedDate.HasValue)
                                    {
                                        <span class="text-success fw-semibold"><i class="bi bi-check-circle me-1"></i>@Model.ResolvedDate.Value.ToString("dd MMMM yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic">Pending Resolution</span>
                                    }
                                </dd>

                                <dt class="col-sm-5 text-muted fw-semibold mb-0">System Logged Date:</dt>
                                <dd class="col-sm-7 text-secondary mb-0">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <!-- Problem Description Section -->
                <div class="card border-0 bg-white shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold text-dark mb-2">
                        <i class="bi bi-file-earmark-text text-danger me-2"></i> Problem & Fault Description
                    </h5>
                    <p class="text-dark fs-6 mb-0 p-3 bg-light rounded-3 border">
                        @(string.IsNullOrEmpty(Model.ProblemDescription) ? "No detailed problem description provided." : Model.ProblemDescription)
                    </p>
                </div>

                <!-- Remarks Section -->
                <div class="card border-0 bg-white shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold text-dark mb-2">
                        <i class="bi bi-journal-text text-primary me-2"></i> Operational Remarks & Actions Taken
                    </h5>
                    <p class="text-dark fs-6 mb-0 p-3 bg-light rounded-3 border">
                        @(string.IsNullOrEmpty(Model.Remarks) ? "No remarks or resolution notes recorded yet." : Model.Remarks)
                    </p>
                </div>

                <!-- Actions Footer Bar -->
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-3 px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back to Roster
                    </a>

                    <div class="d-flex gap-2">
                        @if (!string.Equals(Model.Status, "Resolved", StringComparison.OrdinalIgnoreCase) && !string.Equals(Model.Status, "Closed", StringComparison.OrdinalIgnoreCase))
                        {
                            <a asp-action="Resolve" asp-route-id="@Model.IssueId" onclick="return confirm('Mark issue ISS-@Model.IssueId.ToString("D4") as Resolved?');" class="btn btn-success btn-lg rounded-3 px-4 fw-bold shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Mark as Resolved
                            </a>
                        }
                        <a asp-action="Edit" asp-route-id="@Model.IssueId" class="btn btn-warning btn-lg rounded-3 px-4 fw-bold text-dark shadow-sm">
                            <i class="bi bi-pencil-fill me-1"></i> Edit Issue
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.IssueId" onclick="return confirm('Are you sure you want to delete this machine issue ticket?');" class="btn btn-outline-danger btn-lg rounded-3 px-4">
                            <i class="bi bi-trash me-1"></i> Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
