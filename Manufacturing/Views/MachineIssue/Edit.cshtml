@model Manufacturing.Models.MachineIssue

@{
    ViewData["Title"] = "Edit Machine Issue - Machine Manager Portal";
    var machineList = ViewBag.MachineList as List<SelectListItem> ?? new List<SelectListItem>();
    var orderList = ViewBag.OrderList as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #d97706 100%);">
                <h3 class="fw-bold mb-1"><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Machine Issue #@Model.IssueId</h3>
                <p class="mb-0 text-white-50 fs-6">Update breakdown details, ticket status, priority, or resolution timestamp</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="IssueId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <!-- Machine & Production Order Row -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MachineId" class="form-label fw-semibold">Target Machine <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-cpu"></i></span>
                                <select asp-for="MachineId" asp-items="machineList" class="form-select form-select-lg" required>
                                    <option value="">-- Select Machine --</option>
                                </select>
                            </div>
                            <span asp-validation-for="MachineId" class="text-danger fs-7"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ProductionOrderId" class="form-label fw-semibold">Associated Production Order <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-hash"></i></span>
                                <select asp-for="ProductionOrderId" asp-items="orderList" class="form-select form-select-lg" required>
                                    <option value="">-- Select Production Order --</option>
                                </select>
                            </div>
                            <span asp-validation-for="ProductionOrderId" class="text-danger fs-7"></span>
                        </div>
                    </div>

                    <!-- Reported By & Issue Date Row -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ReportedBy" class="form-label fw-semibold">Reported By Personnel</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person-badge"></i></span>
                                <input asp-for="ReportedBy" class="form-control" placeholder="Enter reporter's full name or ID..." />
                            </div>
                            <span asp-validation-for="ReportedBy" class="text-danger fs-7"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="IssueDate" class="form-label fw-semibold">Issue Occurrence Date <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="IssueDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" required />
                            </div>
                            <span asp-validation-for="IssueDate" class="text-danger fs-7"></span>
                        </div>
                    </div>

                    <!-- Issue Type, Priority & Status Row -->
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="IssueType" class="form-label fw-semibold">Issue Category / Type</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-tag"></i></span>
                                <select asp-for="IssueType" class="form-select">
                                    <option value="Mechanical Breakdown">Mechanical Breakdown</option>
                                    <option value="Electrical Failure">Electrical Failure</option>
                                    <option value="Hydraulic Leak">Hydraulic Leak</option>
                                    <option value="Sensor / PLC Fault">Sensor / PLC Fault</option>
                                    <option value="Tooling / Blade Wear">Tooling / Blade Wear</option>
                                    <option value="Calibration Error">Calibration Error</option>
                                    <option value="Overheating">Overheating</option>
                                    <option value="Other">Other Operational Issue</option>
                                </select>
                            </div>
                            <span asp-validation-for="IssueType" class="text-danger fs-7"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="Priority" class="form-label fw-semibold">Priority Level</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-flag"></i></span>
                                <select asp-for="Priority" class="form-select">
                                    <option value="Medium">Medium</option>
                                    <option value="High">High</option>
                                    <option value="Critical">Critical</option>
                                    <option value="Low">Low</option>
                                </select>
                            </div>
                            <span asp-validation-for="Priority" class="text-danger fs-7"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">Ticket Status</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-activity"></i></span>
                                <select asp-for="Status" class="form-select">
                                    <option value="Open">Open</option>
                                    <option value="In Progress">In Progress</option>
                                    <option value="Resolved">Resolved</option>
                                    <option value="On Hold">On Hold</option>
                                </select>
                            </div>
                            <span asp-validation-for="Status" class="text-danger fs-7"></span>
                        </div>
                    </div>

                    <!-- Problem Description Textarea -->
                    <div class="mb-3">
                        <label asp-for="ProblemDescription" class="form-label fw-semibold">Problem Description <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-file-earmark-text"></i></span>
                            <textarea asp-for="ProblemDescription" class="form-control" rows="3" placeholder="Describe the fault symptoms, error codes, noise, leakage, or breakdown details..." required></textarea>
                        </div>
                        <span asp-validation-for="ProblemDescription" class="text-danger fs-7"></span>
                    </div>

                    <!-- Remarks & Resolution Date Row -->
                    <div class="row">
                        <div class="col-md-8 mb-4">
                            <label asp-for="Remarks" class="form-label fw-semibold">Action Taken / Remarks</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-journal-text"></i></span>
                                <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Optional notes, temporary workarounds, parts required..."></textarea>
                            </div>
                            <span asp-validation-for="Remarks" class="text-danger fs-7"></span>
                        </div>

                        <div class="col-md-4 mb-4">
                            <label asp-for="ResolvedDate" class="form-label fw-semibold">Resolved Date (If Fixed)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-calendar-check"></i></span>
                                <input asp-for="ResolvedDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                            </div>
                            <span asp-validation-for="ResolvedDate" class="text-danger fs-7"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-3 px-4">
                            <i class="bi bi-arrow-left me-1"></i> Back to Roster
                        </a>
                        <button type="submit" class="btn btn-warning btn-lg rounded-3 px-5 fw-bold shadow-sm text-dark">
                            <i class="bi bi-check-circle me-1"></i> Update Machine Issue
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
