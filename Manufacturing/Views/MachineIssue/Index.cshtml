@model List<Manufacturing.Models.MachineIssue>

@{
    ViewData["Title"] = "Machine Issues - Machine Manager Portal";

    var issues = Model ?? new List<Manufacturing.Models.MachineIssue>();

    int totalIssues = issues.Count;
    int openCount = issues.Count(i => string.Equals(i.Status, "Open", StringComparison.OrdinalIgnoreCase));
    int inProgressCount = issues.Count(i => string.Equals(i.Status, "In Progress", StringComparison.OrdinalIgnoreCase));
    int resolvedCount = issues.Count(i => string.Equals(i.Status, "Resolved", StringComparison.OrdinalIgnoreCase) ||
                                           string.Equals(i.Status, "Closed", StringComparison.OrdinalIgnoreCase));

    string getPriorityBadge(string? priority)
    {
        switch (priority?.Trim().ToLower())
        {
            case "critical":
                return "bg-danger text-white";
            case "high":
                return "bg-warning text-dark";
            case "medium":
                return "bg-info text-dark";
            case "low":
                return "bg-secondary text-white";
            default:
                return "bg-light text-dark border";
        }
    }

    string getStatusBadge(string? status)
    {
        switch (status?.Trim().ToLower())
        {
            case "resolved":
            case "closed":
                return "bg-success text-white";
            case "in progress":
                return "bg-primary text-white";
            case "open":
                return "bg-warning text-dark";
            case "on hold":
                return "bg-info text-dark";
            default:
                return "bg-secondary text-white";
        }
    }
}

<div class="container-fluid px-4 py-4">
    <!-- TempData Success Alert -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Top Navigation Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #d97706 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Machine Manager Portal</span>
                <span class="badge bg-white bg-opacity-25 text-white px-3 py-1 rounded-pill fs-7">Equipment Breakdowns & Issues</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill text-warning me-2 fs-2"></i> Machine Issue Management
            </h2>
            <p class="text-slate-300 mb-0 opacity-85">
                Machine Manager Control Hub: Monitor machinery fault reports, track breakdown tickets, assign priorities, and log resolution status.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-warning rounded-pill px-4 py-2 shadow-sm fw-bold text-dark">
                <i class="bi bi-plus-circle-fill me-1"></i> Report New Issue
            </a>
            <button type="button" onclick="exportIssuesCSV()" class="btn btn-light rounded-pill px-4 py-2 shadow-sm fw-semibold text-dark">
                <i class="bi bi-file-earmark-spreadsheet me-1 text-success"></i> Export CSV
            </button>
            <a asp-controller="Account" asp-action="MachineManagerDashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Machine Manager KPI Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Issues</div>
                        <div class="fs-3 fw-bold text-warning mb-0">@totalIssues</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-danger">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Open Tickets</div>
                        <div class="fs-3 fw-bold text-danger mb-0">@openCount</div>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-bug-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">In Progress</div>
                        <div class="fs-3 fw-bold text-primary mb-0">@inProgressCount</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-gear-wide-connected fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Resolved / Closed</div>
                        <div class="fs-3 fw-bold text-success mb-0">@resolvedCount</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter and Search Controls -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-5 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="issuesSearchInput" class="form-control bg-light border-start-0 rounded-end-pill py-2" placeholder="Search machine, issue type, description..." />
                    </div>
                </div>

                <div class="col-6 col-md-3 col-lg-3">
                    <select id="statusFilter" class="form-select rounded-pill py-2">
                        <option value="">All Statuses</option>
                        <option value="Open">Open</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Resolved">Resolved</option>
                        <option value="On Hold">On Hold</option>
                    </select>
                </div>

                <div class="col-6 col-md-2 col-lg-3">
                    <select id="priorityFilter" class="form-select rounded-pill py-2">
                        <option value="">All Priorities</option>
                        <option value="Critical">Critical</option>
                        <option value="High">High</option>
                        <option value="Medium">Medium</option>
                        <option value="Low">Low</option>
                    </select>
                </div>

                <div class="col-12 col-md-2 col-lg-2 text-end">
                    <button type="button" onclick="resetFilters()" class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm w-100">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
            <h5 class="fw-bold mb-0 text-dark d-flex align-items-center">
                <i class="bi bi-table text-warning me-2"></i> Machinery Issue Roster
            </h5>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fs-7 fw-normal" id="recordCountBadge">
                Showing @totalIssues entries
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="issuesTable">
                <thead class="bg-light text-uppercase fs-7 text-muted border-top">
                    <tr>
                        <th class="ps-4 py-3">Ticket ID</th>
                        <th class="py-3">Machine Name</th>
                        <th class="py-3">Production Order</th>
                        <th class="py-3">Issue Type</th>
                        <th class="py-3">Problem Description</th>
                        <th class="py-3 text-center">Priority</th>
                        <th class="py-3 text-center">Status</th>
                        <th class="py-3">Reported By / Date</th>
                        <th class="pe-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (issues.Any())
                    {
                        foreach (var item in issues)
                        {
                            <tr class="issue-row">
                                <td class="ps-4 fw-bold text-dark">
                                    <span class="badge bg-light text-dark border px-2 py-1 font-monospace">
                                        ISS-@item.IssueId.ToString("D4")
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark d-flex align-items-center">
                                        <i class="bi bi-cpu text-info me-2"></i> @(string.IsNullOrEmpty(item.MachineName) ? $"Machine #{item.MachineId}" : item.MachineName)
                                    </div>
                                    <small class="text-muted">ID: @item.MachineId</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-hash me-1"></i>@(string.IsNullOrEmpty(item.OrderNo) ? $"Order #{item.ProductionOrderId}" : item.OrderNo)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 fs-8">
                                        @(string.IsNullOrEmpty(item.IssueType) ? "General Fault" : item.IssueType)
                                    </span>
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block fw-medium text-dark" style="max-width: 220px;" title="@item.ProblemDescription">
                                        @item.ProblemDescription
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @getPriorityBadge(item.Priority) rounded-pill px-3 py-1 fs-7 fw-semibold">
                                        @item.Priority
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @getStatusBadge(item.Status) rounded-pill px-3 py-2 fs-7 fw-semibold">
                                        @item.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="text-dark small fw-medium">
                                        <i class="bi bi-person me-1 text-secondary"></i>@(string.IsNullOrEmpty(item.ReportedBy) ? "Machine Operator" : item.ReportedBy)
                                    </div>
                                    <small class="text-muted"><i class="bi bi-calendar-event me-1"></i>@item.IssueDate.ToString("dd MMM yyyy")</small>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.IssueId" class="btn btn-outline-info rounded-start-pill px-3" title="View Issue Details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        @if (!string.Equals(item.Status, "Resolved", StringComparison.OrdinalIgnoreCase) && !string.Equals(item.Status, "Closed", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <a asp-action="Resolve" asp-route-id="@item.IssueId" onclick="return confirm('Mark issue ISS-@item.IssueId.ToString("D4") as Resolved?');" class="btn btn-outline-success px-3" title="Resolve Issue">
                                                <i class="bi bi-check2-circle"></i> Resolve
                                            </a>
                                        }
                                        <a asp-action="Edit" asp-route-id="@item.IssueId" class="btn btn-outline-warning px-3" title="Edit Ticket">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.IssueId" onclick="return confirm('Are you sure you want to delete machine issue ISS-@item.IssueId.ToString("D4")?');" class="btn btn-outline-danger rounded-end-pill px-3" title="Delete Ticket">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-check-circle fs-1 text-success opacity-50 d-block mb-3"></i>
                                    <h5 class="fw-bold">No Machine Issues Reported</h5>
                                    <p class="small mb-3">All equipment is operating smoothly. No active breakdown tickets logged.</p>
                                    <a asp-action="Create" class="btn btn-warning btn-sm rounded-pill px-4 py-2 text-dark fw-bold">
                                        <i class="bi bi-plus-circle-fill me-1"></i> Log First Machine Issue
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-light py-3 border-0">
            <div class="d-flex justify-content-between align-items-center text-muted small">
                <div>
                    <i class="bi bi-shield-check text-success me-1"></i> Machine Manager Portal | Equipment Issue Tracking System
                </div>
                <div>
                    Updated: @DateTime.Now.ToString("dd MMM yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('issuesSearchInput');
            const statusFilter = document.getElementById('statusFilter');
            const priorityFilter = document.getElementById('priorityFilter');

            if (searchInput && statusFilter && priorityFilter) {
                searchInput.addEventListener('keyup', filterTable);
                statusFilter.addEventListener('change', filterTable);
                priorityFilter.addEventListener('change', filterTable);
            }
        });

        function filterTable() {
            const search = document.getElementById('issuesSearchInput').value.toLowerCase();
            const status = document.getElementById('statusFilter').value.toLowerCase();
            const priority = document.getElementById('priorityFilter').value.toLowerCase();
            const rows = document.querySelectorAll('.issue-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const matchesSearch = text.includes(search);
                const matchesStatus = status === '' || text.includes(status);
                const matchesPriority = priority === '' || text.includes(priority);

                if (matchesSearch && matchesStatus && matchesPriority) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const badge = document.getElementById('recordCountBadge');
            if (badge) {
                badge.textContent = `Showing ${visibleCount} entries`;
            }
        }

        function resetFilters() {
            document.getElementById('issuesSearchInput').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('priorityFilter').value = '';
            filterTable();
        }

        function exportIssuesCSV() {
            const rows = document.querySelectorAll('#issuesTable tr');
            let csv = [];

            rows.forEach(row => {
                let cols = row.querySelectorAll('td, th');
                let rowData = [];
                cols.forEach((col, idx) => {
                    if (idx < cols.length - 1) { // Skip actions column
                        let text = col.innerText.replace(/(\r\n|\n|\r)/gm, ' ').trim();
                        text = text.replace(/"/g, '""');
                        rowData.push(`"${text}"`);
                    }
                });
                if (rowData.length > 0) {
                    csv.push(rowData.join(','));
                }
            });

            const csvFile = new Blob([csv.join('\n')], { type: 'text/csv' });
            const downloadLink = document.createElement('a');
            downloadLink.download = `Machine_Issues_${new Date().toISOString().slice(0, 10)}.csv`;
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = 'none';
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}
