@model Manufacturing.Models.OperatorAssignment

@{
    ViewData["Title"] = "Edit Operator Assignment";

    var orderList = ViewBag.OrderList as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var employeeList = ViewBag.EmployeeList as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var shiftList = ViewBag.ShiftList as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container-fluid px-3 py-3">
    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #4338ca 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-indigo text-white px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold" style="background-color: #6366f1;">Production Operations</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Edit Record</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-pencil-square text-indigo me-2 fs-2" style="color: #a5b4fc;"></i> Edit Operator Assignment #@Model.OperatorAssignmentId
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Update shift assignment details, operator allocation, status and notes</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Roster
            </a>
        </div>
    </div>

    <!-- Form Card -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-transparent border-0 p-4 pb-0">
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="bi bi-sliders text-indigo me-2" style="color: #4338ca;"></i> Update Assignment #@Model.OperatorAssignmentId
                    </h5>
                    <p class="text-muted small mb-0">Modify order allocation, employee assignment, shift or operational remarks</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="OperatorAssignmentId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="ProductionOrderId" class="form-label fw-semibold">Production Order <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 rounded-start-3">
                                        <i class="bi bi-hash text-muted"></i>
                                    </span>
                                    <select asp-for="ProductionOrderId" asp-items="orderList" class="form-select border-start-0 rounded-end-3" required>
                                        <option value="">-- Select Production Order --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="ProductionOrderId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="EmployeeId" class="form-label fw-semibold">Machine Operator / Employee <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 rounded-start-3">
                                        <i class="bi bi-person-fill text-muted"></i>
                                    </span>
                                    <select asp-for="EmployeeId" asp-items="employeeList" class="form-select border-start-0 rounded-end-3" required>
                                        <option value="">-- Select Operator / Staff --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="ShiftId" class="form-label fw-semibold">Target Shift <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 rounded-start-3">
                                        <i class="bi bi-clock-history text-muted"></i>
                                    </span>
                                    <select asp-for="ShiftId" asp-items="shiftList" class="form-select border-start-0 rounded-end-3" required>
                                        <option value="">-- Select Shift --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="ShiftId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="AssignedDate" class="form-label fw-semibold">Assigned Date <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 rounded-start-3">
                                        <i class="bi bi-calendar3 text-muted"></i>
                                    </span>
                                    <input asp-for="AssignedDate" type="date" class="form-control border-start-0 rounded-end-3" value="@Model.AssignedDate.ToString("yyyy-MM-dd")" required />
                                </div>
                                <span asp-validation-for="AssignedDate" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold">Assignment Status</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 rounded-start-3">
                                        <i class="bi bi-flag-fill text-muted"></i>
                                    </span>
                                    <select asp-for="Status" class="form-select border-start-0 rounded-end-3">
                                        <option value="Assigned">Assigned</option>
                                        <option value="In Progress">In Progress</option>
                                        <option value="Completed">Completed</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold">Assignment Remarks & Instructions</label>
                                <textarea asp-for="Remarks" class="form-control rounded-3" rows="3" maxlength="500"></textarea>
                                <span asp-validation-for="Remarks" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-semibold">Cancel</a>
                            <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold text-dark">
                                <i class="bi bi-save-fill me-1"></i> Update Assignment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
