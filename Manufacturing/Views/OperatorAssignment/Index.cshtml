@model List<Manufacturing.Models.OperatorAssignment>

@{
    ViewData["Title"] = "Operator Assignment Roster";

    var assignments = Model ?? new List<Manufacturing.Models.OperatorAssignment>();
    int totalAssignments = assignments.Count;
    int assignedCount = assignments.Count(a => a.Status == "Assigned");
    int inProgressCount = assignments.Count(a => a.Status == "In Progress" || a.Status == "Active" || a.Status == "Running");
    int completedCount = assignments.Count(a => a.Status == "Completed");

    string getStatusBadgeClass(string status)
    {
        switch (status?.Trim())
        {
            case "Assigned": return "bg-primary text-white";
            case "In Progress": case "Active": case "Running": return "bg-info text-dark";
            case "Completed": return "bg-success text-white";
            case "On Leave": case "Maintenance": return "bg-warning text-dark";
            case "Cancelled": return "bg-danger text-white";
            default: return "bg-secondary text-white";
        }
    }
}

<div class="container-fluid px-3 py-3">
    <!-- TempData Success Alert -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #4338ca 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-indigo text-white px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold" style="background-color: #6366f1;">Production Operations</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Manager Portal</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-person-workspace text-indigo me-2 fs-2" style="color: #a5b4fc;"></i> Operator Assignment Roster
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Production Manager Control: Assign machine operators to production orders, manage shift rosters, and monitor work allocations</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-light rounded-pill px-4 py-2 shadow-sm fw-semibold text-indigo" style="color: #4338ca;">
                <i class="bi bi-plus-circle-fill me-1"></i> New Operator Assignment
            </a>
            <a asp-controller="Account" asp-action="ProductionManagerDashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-indigo" style="border-left-color: #6366f1 !important;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Assignments</div>
                        <div class="fs-3 fw-bold text-indigo mb-0" style="color: #4338ca;">@totalAssignments</div>
                    </div>
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #e0e7ff; color: #4338ca;">
                        <i class="bi bi-person-badge fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Active Assigned</div>
                        <div class="fs-3 fw-bold text-primary mb-0">@assignedCount</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">In Progress</div>
                        <div class="fs-3 fw-bold text-info mb-0">@inProgressCount</div>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-arrow-repeat fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Completed</div>
                        <div class="fs-3 fw-bold text-success mb-0">@completedCount</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-check2-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white">
        <div class="card-header bg-transparent border-0 p-4 pb-0">
            <div class="row g-3 align-items-center justify-content-between">
                <div class="col-12 col-md-5">
                    <div class="input-group search-box">
                        <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control bg-light border-start-0 rounded-end-pill py-2" placeholder="Search order no, operator name, shift...">
                    </div>
                </div>
                <div class="col-12 col-md-7 d-flex justify-content-md-end gap-2">
                    <select id="statusFilter" class="form-select rounded-pill w-auto py-2">
                        <option value="">All Statuses</option>
                        <option value="Assigned">Assigned</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-plus-lg me-1"></i> Add Assignment
                    </a>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            @if (!assignments.Any())
            {
                <div class="text-center py-5">
                    <div class="rounded-circle bg-light d-inline-flex p-4 mb-3 text-muted">
                        <i class="bi bi-person-badge fs-1"></i>
                    </div>
                    <h5 class="fw-bold text-dark">No Operator Assignments Found</h5>
                    <p class="text-muted mb-4">Start allocating machine operators and technical staff to active production orders.</p>
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-plus-circle-fill me-1"></i> Assign First Operator
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="assignmentsTable">
                        <thead class="table-light rounded-3 text-secondary fs-7 text-uppercase fw-bold">
                            <tr>
                                <th class="ps-3 py-3" style="width: 70px;">ID</th>
                                <th class="py-3">Production Order</th>
                                <th class="py-3">Operator Name</th>
                                <th class="py-3">Shift</th>
                                <th class="py-3">Assigned Date</th>
                                <th class="py-3">Status</th>
                                <th class="py-3">Remarks</th>
                                <th class="text-end pe-3 py-3" style="width: 140px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var item in assignments)
                            {
                                <tr class="assignment-row">
                                    <td class="ps-3 fw-bold text-muted">#@item.OperatorAssignmentId</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="badge bg-indigo bg-opacity-10 text-indigo rounded-pill me-2 px-2 py-1 fw-bold" style="color: #4338ca; background-color: #e0e7ff;">
                                                <i class="bi bi-hash me-1"></i>@item.OrderNo
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 me-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                                <i class="bi bi-person-fill fs-6"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark mb-0">@(string.IsNullOrEmpty(item.EmployeeName) ? "Employee #" + item.EmployeeId : item.EmployeeName)</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">
                                            <i class="bi bi-clock-history text-info me-1"></i> @(string.IsNullOrEmpty(item.ShiftName) ? "Shift #" + item.ShiftId : item.ShiftName)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="text-muted fw-semibold fs-7">
                                            <i class="bi bi-calendar-event me-1 text-primary"></i> @item.AssignedDate.ToString("yyyy-MM-dd")
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @getStatusBadgeClass(item.Status) rounded-pill px-3 py-2 fs-7 fw-bold">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td style="max-width: 220px;">
                                        <span class="text-truncate d-inline-block text-muted small" style="max-width: 200px;" title="@item.Remarks">
                                            @(string.IsNullOrWhiteSpace(item.Remarks) ? "-" : item.Remarks)
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group shadow-sm rounded-pill overflow-hidden" role="group">
                                            <a asp-action="Details" asp-route-id="@item.OperatorAssignmentId" class="btn btn-sm btn-light text-primary py-1 px-2" title="View Details">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.OperatorAssignmentId" class="btn btn-sm btn-light text-warning py-1 px-2" title="Edit Assignment">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a href="javascript:void(0);" onclick="confirmDelete(@item.OperatorAssignmentId)" class="btn btn-sm btn-light text-danger py-1 px-2" title="Delete Assignment">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal for Delete Confirmation -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-danger text-white border-0 py-3">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <i class="bi bi-trash text-danger display-3 mb-3 d-block"></i>
                <h5 class="fw-bold text-dark mb-2">Are you sure you want to delete this assignment?</h5>
                <p class="text-muted mb-0">This operation cannot be undone. The operator assignment record will be permanently deleted.</p>
            </div>
            <div class="modal-footer border-0 bg-light p-3 justify-content-center gap-2">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <a id="confirmDeleteBtn" href="#" class="btn btn-danger rounded-pill px-4">Yes, Delete</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Table Filter & Search Logic
        document.getElementById('searchInput')?.addEventListener('keyup', filterTable);
        document.getElementById('statusFilter')?.addEventListener('change', filterTable);

        function filterTable() {
            const searchValue = document.getElementById('searchInput').value.toLowerCase();
            const statusValue = document.getElementById('statusFilter').value.toLowerCase();
            const rows = document.querySelectorAll('#assignmentsTable tbody tr');

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const statusBadge = row.querySelector('td:nth-child(6)')?.textContent.toLowerCase() || '';

                const matchesSearch = text.includes(searchValue);
                const matchesStatus = !statusValue || statusBadge.includes(statusValue);

                if (matchesSearch && matchesStatus) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function confirmDelete(id) {
            document.getElementById('confirmDeleteBtn').href = '/OperatorAssignment/Delete/' + id;
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}
