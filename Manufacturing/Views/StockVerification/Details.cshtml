@model Manufacturing.Models.StockVerification

@{
    ViewData["Title"] = "Stock Verification Audit Details";

    string getStatusBadgeClass(string? status)
    {
        switch (status?.Trim().ToLower())
        {
            case "verified":
            case "approved":
            case "completed":
            case "matched":
                return "bg-success text-white";
            case "pending":
            case "under review":
            case "draft":
                return "bg-warning text-dark";
            case "discrepancy":
            case "adjusted":
            case "rejected":
                return "bg-danger text-white";
            default:
                return "bg-info text-white";
        }
    }

    var diffClass = Model.DifferenceStock == 0 ? "bg-success bg-opacity-10 text-success border-success" 
                   : (Model.DifferenceStock < 0 ? "bg-danger bg-opacity-10 text-danger border-danger" 
                   : "bg-warning bg-opacity-10 text-dark border-warning");
    
    var diffIcon = Model.DifferenceStock == 0 ? "bi-check-circle-fill" 
                  : (Model.DifferenceStock < 0 ? "bi-arrow-down-circle-fill" 
                  : "bi-arrow-up-circle-fill");
}

<div class="container-fluid px-3 py-3">
    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #4f46e5 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-indigo px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold" style="background-color: #6366f1;">Stock Audit Details</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Audit Record #SV-@Model.VerificationId.ToString("D4")</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-clipboard-check-fill text-indigo-300 me-2 fs-2"></i> Stock Verification Audit #@Model.VerificationId
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Production Manager Control: Comprehensive breakdown of raw material physical vs system stock audit</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model.VerificationId" class="btn btn-warning rounded-pill px-4 py-2 shadow-sm fw-semibold text-dark">
                <i class="bi bi-pencil-square me-1"></i> Edit Audit Record
            </a>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Audit Directory
            </a>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-file-earmark-text-fill me-2 text-indigo" style="color: #6366f1;"></i> Stock Verification Summary
                    </h5>
                    <span class="badge @getStatusBadgeClass(Model.Status) rounded-pill px-3 py-2 fs-7 fw-bold">
                        @(string.IsNullOrEmpty(Model.Status) ? "Verified" : Model.Status)
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4 mb-4">
                        <!-- Audit ID -->
                        <div class="col-md-6 col-lg-4">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-uppercase text-muted fw-bold d-block fs-7 mb-1">Audit Reference ID</small>
                                <div class="fs-5 fw-bold text-dark">#SV-@Model.VerificationId.ToString("D4")</div>
                            </div>
                        </div>

                        <!-- Raw Material Name & ID -->
                        <div class="col-md-6 col-lg-8">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-uppercase text-muted fw-bold d-block fs-7 mb-1">Audited Raw Material</small>
                                <div class="fs-5 fw-bold text-indigo" style="color: #4f46e5;">
                                    <i class="bi bi-boxes me-2"></i>@(string.IsNullOrEmpty(Model.MaterialName) ? $"Raw Material #{Model.MaterialId}" : Model.MaterialName)
                                    <span class="badge bg-secondary bg-opacity-10 text-muted ms-2 fs-7 fw-normal border">ID: @Model.MaterialId</span>
                                </div>
                            </div>
                        </div>

                        <!-- System Stock -->
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border h-100 border-start border-4 border-info">
                                <small class="text-uppercase text-muted fw-bold d-block fs-7 mb-1">System Recorded Stock</small>
                                <div class="fs-4 fw-bold text-info">
                                    <i class="bi bi-pc-display me-1"></i>@Model.SystemStock.ToString("N0") <span class="fs-6 text-muted fw-normal">Units</span>
                                </div>
                            </div>
                        </div>

                        <!-- Physical Stock -->
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border h-100 border-start border-4 border-primary">
                                <small class="text-uppercase text-muted fw-bold d-block fs-7 mb-1">Physical Audited Stock</small>
                                <div class="fs-4 fw-bold text-primary">
                                    <i class="bi bi-box-seam-fill me-1"></i>@Model.PhysicalStock.ToString("N0") <span class="fs-6 text-muted fw-normal">Units</span>
                                </div>
                            </div>
                        </div>

                        <!-- Variance / Difference -->
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border h-100 border-start border-4 @(Model.DifferenceStock == 0 ? "border-success" : (Model.DifferenceStock < 0 ? "border-danger" : "border-warning"))">
                                <small class="text-uppercase text-muted fw-bold d-block fs-7 mb-1">Stock Variance / Difference</small>
                                <div>
                                    <span class="badge @diffClass border px-3 py-2 rounded-pill fs-6 fw-bold">
                                        <i class="bi @diffIcon me-1"></i>
                                        @(Model.DifferenceStock > 0 ? "+" + Model.DifferenceStock.ToString("N0") : Model.DifferenceStock.ToString("N0")) Units
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Verification Date -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-uppercase text-muted fw-bold d-block fs-7 mb-1">Verification Date & Time</small>
                                <div class="fs-6 fw-semibold text-dark">
                                    <i class="bi bi-calendar-event me-2 text-primary"></i>@Model.VerificationDate.ToString("yyyy-MM-dd HH:mm")
                                </div>
                            </div>
                        </div>

                        <!-- Verified By -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-uppercase text-muted fw-bold d-block fs-7 mb-1">Auditor / Verified By</small>
                                <div class="fs-6 fw-semibold text-dark">
                                    <i class="bi bi-person-badge-fill me-2 text-indigo" style="color: #6366f1;"></i>@(string.IsNullOrEmpty(Model.VerifiedBy) ? "Production Manager" : Model.VerifiedBy)
                                </div>
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-uppercase text-muted fw-bold d-block fs-7 mb-1">Audit Status</small>
                                <div>
                                    <span class="badge @getStatusBadgeClass(Model.Status) rounded-pill px-3 py-1 fs-7 fw-semibold">
                                        @(string.IsNullOrEmpty(Model.Status) ? "Verified" : Model.Status)
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Created Date -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-uppercase text-muted fw-bold d-block fs-7 mb-1">Record Created Timestamp</small>
                                <div class="fs-6 fw-semibold text-muted">
                                    <i class="bi bi-clock-history me-2"></i>@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")
                                </div>
                            </div>
                        </div>

                        <!-- Remarks -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-uppercase text-muted fw-bold d-block fs-7 mb-1">Remarks & Discrepancy Notes</small>
                                <p class="mb-0 text-dark fs-6" style="white-space: pre-line;">
                                    @(string.IsNullOrEmpty(Model.Remarks) ? "No remarks or notes recorded for this audit." : Model.Remarks)
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Footer Action Buttons -->
                    <div class="d-flex justify-content-between align-items-center border-top pt-3">
                        <a asp-action="Delete" asp-route-id="@Model.VerificationId" class="btn btn-outline-danger rounded-pill px-4" onclick="return confirm('Are you sure you want to delete this stock verification record?');">
                            <i class="bi bi-trash-fill me-1"></i> Delete Audit Record
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Back to List</a>
                            <a asp-action="Edit" asp-route-id="@Model.VerificationId" class="btn btn-primary rounded-pill px-4 shadow-sm" style="background-color: #4f46e5; border-color: #4f46e5;">
                                <i class="bi bi-pencil-square me-1"></i> Edit Audit Record
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
