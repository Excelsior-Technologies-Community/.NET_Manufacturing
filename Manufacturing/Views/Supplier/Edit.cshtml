@model Manufacturing.Models.Supplier

@{
    ViewData["Title"] = "Edit Supplier - " + Model.SupplierName;
}

<div class="container-fluid px-4 py-3">
    <div class="card bg-dark text-white border-0 shadow-lg mb-4 rounded-4 overflow-hidden position-relative" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
        <div class="card-body p-4 position-relative z-1">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-25 p-3 text-warning me-3 border border-warning border-opacity-25">
                        <i class="bi bi-pencil-square fs-2"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold text-white mb-1">Edit Supplier Profile</h2>
                        <p class="text-white-50 mb-0">Update contact records, GST numbers, address, and status for <strong>@Model.SupplierName</strong></p>
                    </div>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> Back to Suppliers List
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 border-bottom px-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-pencil-fill text-warning fs-5"></i>
                            <h5 class="fw-bold text-dark mb-0">Supplier Record ID: #@Model.SupplierId</h5>
                        </div>
                        <span class="badge bg-light text-secondary border font-monospace px-3 py-2">Code: @Model.SupplierCode</span>
                    </div>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="SupplierId" />
                        <div asp-validation-summary="All" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                        <div class="border-bottom pb-3 mb-4">
                            <h6 class="fw-bold text-primary text-uppercase mb-1">
                                <i class="bi bi-building me-1"></i> Section 1: Basic Vendor Information
                            </h6>
                            <p class="text-muted small mb-0">Modify official supplier code and business name</p>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="SupplierCode" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-upc-scan text-primary me-1"></i> Supplier Code <span class="text-danger">*</span>
                                </label>
                                <input asp-for="SupplierCode" class="form-control rounded-3 py-2 font-monospace" required />
                                <span asp-validation-for="SupplierCode" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SupplierName" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-building-check text-success me-1"></i> Supplier / Company Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="SupplierName" class="form-control rounded-3 py-2" required />
                                <span asp-validation-for="SupplierName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="border-bottom pb-3 mb-4 mt-4">
                            <h6 class="fw-bold text-primary text-uppercase mb-1">
                                <i class="bi bi-person-lines-fill me-1"></i> Section 2: Contact Person & Communication
                            </h6>
                            <p class="text-muted small mb-0">Update primary representative telephone and email</p>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="ContactPerson" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-person text-info me-1"></i> Contact Person
                                </label>
                                <input asp-for="ContactPerson" class="form-control rounded-3 py-2" />
                                <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Mobile" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-telephone text-primary me-1"></i> Mobile / Phone Number
                                </label>
                                <input asp-for="Mobile" class="form-control rounded-3 py-2" />
                                <span asp-validation-for="Mobile" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Email" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-envelope text-danger me-1"></i> Email Address
                                </label>
                                <input asp-for="Email" type="email" class="form-control rounded-3 py-2" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="border-bottom pb-3 mb-4 mt-4">
                            <h6 class="fw-bold text-primary text-uppercase mb-1">
                                <i class="bi bi-geo-alt me-1"></i> Section 3: Location & GST Identification
                            </h6>
                            <p class="text-muted small mb-0">Update location details, status, and GST identification</p>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="City" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-geo text-danger me-1"></i> City / Region
                                </label>
                                <input asp-for="City" class="form-control rounded-3 py-2" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="GSTNumber" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-receipt text-warning me-1"></i> GST Identification Number (GSTIN)
                                </label>
                                <input asp-for="GSTNumber" class="form-control rounded-3 py-2 font-monospace text-uppercase" />
                                <span asp-validation-for="GSTNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-shield-check text-success me-1"></i> Vendor Status <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Status" class="form-select rounded-3 py-2" required>
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                    <option value="Pending">Pending Approval</option>
                                    <option value="Suspended">Suspended</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-semibold text-dark">
                                    <i class="bi bi-house-door text-muted me-1"></i> Full Postal Address
                                </label>
                                <textarea asp-for="Address" class="form-control rounded-3" rows="2"></textarea>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="border-bottom pb-3 mb-4 mt-4">
                            <h6 class="fw-bold text-primary text-uppercase mb-1">
                                <i class="bi bi-chat-left-text me-1"></i> Section 4: Vendor Remarks & Contract Notes
                            </h6>
                            <p class="text-muted small mb-0">Contract notes and payment terms</p>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Remarks" class="form-label fw-semibold text-dark">
                                <i class="bi bi-pencil-square me-1"></i> Remarks / Vendor Category Notes
                            </label>
                            <textarea asp-for="Remarks" class="form-control rounded-3" rows="3"></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>

                        <div class="d-flex align-items-center justify-content-end gap-3 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4 py-2 fw-semibold">Cancel</a>
                            <button type="submit" class="btn btn-warning rounded-pill px-5 py-2 fw-semibold shadow-sm">
                                <i class="bi bi-check-circle-fill me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
