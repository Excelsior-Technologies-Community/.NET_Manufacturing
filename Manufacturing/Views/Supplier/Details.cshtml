@model Manufacturing.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details - " + Model.SupplierName;
}

<div class="container-fluid px-4 py-3">
    <!-- Executive Header Banner -->
    <div class="card bg-dark text-white border-0 shadow-lg mb-4 rounded-4 overflow-hidden position-relative" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
        <div class="card-body p-4 position-relative z-1">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-info bg-opacity-25 p-3 text-info me-3 border border-info border-opacity-25">
                        <i class="bi bi-building fs-2"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="fw-bold text-white mb-0">@Model.SupplierName</h2>
                            <span class="badge bg-light text-dark font-monospace px-3 py-1 fs-7">@Model.SupplierCode</span>
                        </div>
                        <p class="text-white-50 mb-0 mt-1">Vendor Master Profile & Comprehensive Commercial Directory</p>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.SupplierId" class="btn btn-warning rounded-pill px-4 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-pencil-square me-1"></i> Edit Profile
                    </a>
                    <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> Back to Suppliers
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Status Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 text-center">
                    <span class="text-muted small text-uppercase d-block mb-1">Account Status</span>
                    @if (Model.Status == "Active")
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2 fs-6">
                            <i class="bi bi-check-circle-fill me-1"></i> Active Supplier
                        </span>
                    }
                    else if (Model.Status == "Inactive")
                    {
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-3 py-2 fs-6">
                            <i class="bi bi-dash-circle me-1"></i> Inactive
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-2 fs-6">
                            <i class="bi bi-clock me-1"></i> @(Model.Status ?? "Pending")
                        </span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 text-center">
                    <span class="text-muted small text-uppercase d-block mb-1">Primary Location</span>
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-geo-alt text-danger me-1"></i>@(string.IsNullOrEmpty(Model.City) ? "N/A" : Model.City)</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 text-center">
                    <span class="text-muted small text-uppercase d-block mb-1">GST Registration</span>
                    <h6 class="fw-bold font-monospace text-primary mb-0">@(string.IsNullOrEmpty(Model.GSTNumber) ? "NOT REGISTERED" : Model.GSTNumber)</h6>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 text-center">
                    <span class="text-muted small text-uppercase d-block mb-1">Registration Date</span>
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-calendar3 text-muted me-1"></i>@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</h6>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Information Cards -->
    <div class="row g-4 mb-4">
        <!-- Primary Contact Card -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 h-100 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-person-bounding-box text-primary fs-5"></i>
                        <h5 class="fw-bold text-dark mb-0">Contact & Representative Details</h5>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="list-group list-group-flush border-0">
                        <div class="list-group-item bg-transparent px-0 py-3 d-flex align-items-center justify-content-between">
                            <span class="text-muted fw-semibold"><i class="bi bi-person text-primary me-2"></i>Contact Person:</span>
                            <span class="fw-bold text-dark fs-6">@(string.IsNullOrEmpty(Model.ContactPerson) ? "Not Provided" : Model.ContactPerson)</span>
                        </div>
                        <div class="list-group-item bg-transparent px-0 py-3 d-flex align-items-center justify-content-between">
                            <span class="text-muted fw-semibold"><i class="bi bi-telephone text-success me-2"></i>Mobile / Phone:</span>
                            <span class="fw-bold text-dark font-monospace">@(string.IsNullOrEmpty(Model.Mobile) ? "Not Provided" : Model.Mobile)</span>
                        </div>
                        <div class="list-group-item bg-transparent px-0 py-3 d-flex align-items-center justify-content-between">
                            <span class="text-muted fw-semibold"><i class="bi bi-envelope text-danger me-2"></i>Email Address:</span>
                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <a href="mailto:@Model.Email" class="fw-bold text-primary text-decoration-none">@Model.Email</a>
                            }
                            else
                            {
                                <span class="text-muted italic">Not Provided</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Location & Tax Card -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 h-100 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt-fill text-danger fs-5"></i>
                        <h5 class="fw-bold text-dark mb-0">Location & Commercial Tax Info</h5>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="list-group list-group-flush border-0">
                        <div class="list-group-item bg-transparent px-0 py-3 d-flex align-items-center justify-content-between">
                            <span class="text-muted fw-semibold"><i class="bi bi-geo text-danger me-2"></i>City / District:</span>
                            <span class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.City) ? "N/A" : Model.City)</span>
                        </div>
                        <div class="list-group-item bg-transparent px-0 py-3 d-flex align-items-center justify-content-between">
                            <span class="text-muted fw-semibold"><i class="bi bi-receipt-cutoff text-warning me-2"></i>GST Identification Number:</span>
                            <span class="badge bg-dark font-monospace text-white px-3 py-2 fs-7">@(string.IsNullOrEmpty(Model.GSTNumber) ? "N/A" : Model.GSTNumber)</span>
                        </div>
                        <div class="list-group-item bg-transparent px-0 py-3">
                            <span class="text-muted fw-semibold d-block mb-1"><i class="bi bi-house-door text-muted me-2"></i>Full Address:</span>
                            <div class="p-3 bg-light rounded-3 text-dark font-monospace small border">
                                @(string.IsNullOrEmpty(Model.Address) ? "No physical address recorded." : Model.Address)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Remarks & Notes Card -->
        <div class="col-12">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-chat-left-text-fill text-indigo fs-5" style="color: #6366f1;"></i>
                        <h5 class="fw-bold text-dark mb-0">Procurement & Contract Notes</h5>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="p-3 bg-light rounded-3 text-dark border">
                        <i class="bi bi-quote text-muted me-2 fs-5"></i>
                        <span>@(string.IsNullOrEmpty(Model.Remarks) ? "No specific notes or contract remarks recorded for this vendor." : Model.Remarks)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
