@model IEnumerable<Manufacturing.Models.Supplier>

@{
    ViewData["Title"] = "Supplier Directory";
    var totalSuppliers = Model?.Count() ?? 0;
    var activeSuppliers = Model?.Count(s => s.Status == "Active") ?? 0;
    var inactiveSuppliers = Model?.Count(s => s.Status != "Active") ?? 0;
    var citiesCount = Model?.Select(s => s.City).Where(c => !string.IsNullOrEmpty(c)).Distinct().Count() ?? 0;
}

<div class="container-fluid px-4 py-3">
    <div class="card bg-dark text-white border-0 shadow-lg mb-4 rounded-4 overflow-hidden position-relative" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
        <div class="card-body p-4 position-relative z-1">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-25 p-3 text-primary me-3 border border-primary border-opacity-25">
                        <i class="bi bi-truck fs-2"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold text-white mb-1">Supplier Directory</h2>
                        <p class="text-white-50 mb-0">Manage vendor profiles, contact information, GST registers, and procurement contracts</p>
                    </div>
                </div>
                <div>
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm text-nowrap">
                        <i class="bi bi-plus-lg me-1"></i> Add New Supplier
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted fw-semibold small text-uppercase">Total Vendors</span>
                            <h3 class="fw-bold text-dark mb-0 mt-1">@totalSuppliers</h3>
                        </div>
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                            <i class="bi bi-building fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted fw-semibold small text-uppercase">Active Suppliers</span>
                            <h3 class="fw-bold text-success mb-0 mt-1">@activeSuppliers</h3>
                        </div>
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                            <i class="bi bi-check-circle fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted fw-semibold small text-uppercase">Inactive / Pending</span>
                            <h3 class="fw-bold text-warning mb-0 mt-1">@inactiveSuppliers</h3>
                        </div>
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                            <i class="bi bi-clock-history fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted fw-semibold small text-uppercase">Cities Covered</span>
                            <h3 class="fw-bold text-info mb-0 mt-1">@citiesCount</h3>
                        </div>
                        <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info">
                            <i class="bi bi-geo-alt fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 px-4">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-table text-primary fs-5"></i>
                <h5 class="fw-bold text-dark mb-0">Registered Suppliers Master List</h5>
            </div>
            <div class="d-flex align-items-center gap-2" style="max-width: 380px; width: 100%;">
                <div class="input-group search-box">
                    <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control bg-light border-start-0 rounded-end-pill ps-0" placeholder="Search supplier code, name, city, GST..." />
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted display-4"></i>
                    <p class="text-muted mt-3 mb-0">No supplier records found in database.</p>
                    <a asp-action="Create" class="btn btn-outline-primary rounded-pill px-4 mt-3">
                        <i class="bi bi-plus-lg me-1"></i> Register First Supplier
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="supplierTable">
                        <thead class="bg-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4 py-3">Code & Supplier</th>
                                <th class="py-3">Contact Person</th>
                                <th class="py-3">Phone & Email</th>
                                <th class="py-3">City & GST Number</th>
                                <th class="py-3">Status</th>
                                <th class="py-3">Created Date</th>
                                <th class="text-end pe-4 py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 me-3 fw-bold small text-center" style="width: 40px; height: 40px; line-height: 24px;">
                                                <i class="bi bi-truck"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@item.SupplierName</div>
                                                <small class="badge bg-light text-secondary border rounded-pill me-1">@item.SupplierCode</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        @if (!string.IsNullOrEmpty(item.ContactPerson))
                                        {
                                            <div class="fw-semibold text-dark">@item.ContactPerson</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted italic">N/A</span>
                                        }
                                    </td>
                                    <td class="py-3">
                                        <div><i class="bi bi-telephone me-1 text-muted"></i>@(string.IsNullOrEmpty(item.Mobile) ? "N/A" : item.Mobile)</div>
                                        @if (!string.IsNullOrEmpty(item.Email))
                                        {
                                            <small class="text-muted"><i class="bi bi-envelope me-1"></i>@item.Email</small>
                                        }
                                    </td>
                                    <td class="py-3">
                                        <div class="fw-semibold text-dark"><i class="bi bi-geo-alt text-danger me-1"></i>@(string.IsNullOrEmpty(item.City) ? "N/A" : item.City)</div>
                                        @if (!string.IsNullOrEmpty(item.GSTNumber))
                                        {
                                            <small class="badge bg-secondary bg-opacity-10 text-secondary border font-monospace">GST: @item.GSTNumber</small>
                                        }
                                    </td>
                                    <td class="py-3">
                                        @if (item.Status == "Active")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2">
                                                <i class="bi bi-check-circle-fill me-1"></i> Active
                                            </span>
                                        }
                                        else if (item.Status == "Inactive")
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-3 py-2">
                                                <i class="bi bi-dash-circle me-1"></i> Inactive
                                            </span>
                                        }
                                        else if (item.Status == "Suspended")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-2">
                                                <i class="bi bi-exclamation-octagon-fill me-1"></i> Suspended
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-2">
                                                <i class="bi bi-clock me-1"></i> @(item.Status ?? "Pending")
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3 text-muted small">
                                        <i class="bi bi-calendar3 me-1"></i>@item.CreatedDate.ToString("yyyy-MM-dd")
                                    </td>
                                    <td class="text-end pe-4 py-3">
                                        <div class="btn-group shadow-sm rounded-pill overflow-hidden" role="group">
                                            <a asp-action="Details" asp-route-id="@item.SupplierId" class="btn btn-sm btn-outline-info px-3" title="View Supplier Details">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.SupplierId" class="btn btn-sm btn-outline-warning px-3" title="Edit Supplier Profile">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.SupplierId" class="btn btn-sm btn-outline-danger px-3" title="Delete Supplier" onclick="return confirm('Are you sure you want to delete supplier \'@item.SupplierName\'?');">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const table = document.getElementById('supplierTable');

            if (searchInput && table) {
                searchInput.addEventListener('keyup', function () {
                    const filter = this.value.toLowerCase();
                    const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

                    for (let i = 0; i < rows.length; i++) {
                        const text = rows[i].textContent.toLowerCase();
                        if (text.indexOf(filter) > -1) {
                            rows[i].style.display = '';
                        } else {
                            rows[i].style.display = 'none';
                        }
                    }
                });
            }
        });
    </script>
}
