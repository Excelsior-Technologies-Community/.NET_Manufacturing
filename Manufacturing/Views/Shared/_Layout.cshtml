@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var isLoggedIn = HttpContextAccessor.HttpContext?.Session.GetString("UserId") != null;
    var sessionName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? "User";
    var sessionRole = HttpContextAccessor.HttpContext?.Session.GetString("Role") ?? "Staff";
    var sessionUsername = HttpContextAccessor.HttpContext?.Session.GetString("Username") ?? "";

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string getRoleBadgeClass(string role)
    {
        switch (role)
        {
            case "Admin": return "bg-danger text-white";
            case "Production Manager": return "bg-primary text-white";
            case "Inventory Manager": return "bg-warning text-dark";
            case "Machine Supervisor": return "bg-info text-dark";
            case "Shift Supervisor": return "bg-secondary text-white";
            case "Machine Operator": return "bg-dark text-white";
            case "Quality Inspector": return "bg-success text-white";
            case "Store Manager": return "bg-indigo text-white";
            default: return "bg-secondary text-white";
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Manufacturing Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Manufacturing.styles.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    @if (isLoggedIn)
    {
        <!-- Mobile Sidebar Overlay -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- Top Header Navigation -->
        <header class="sticky-top z-3">
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm border-bottom border-dark-subtle py-2">
                <div class="container-fluid px-3 px-lg-4">
                    <div class="d-flex align-items-center">
                        <!-- Sidebar Toggle Button (Mobile/Tablet) -->
                        <button class="btn btn-outline-light d-lg-none me-3 rounded-3" type="button" id="sidebarToggle" aria-label="Toggle Sidebar">
                            <i class="bi bi-list fs-4"></i>
                        </button>

                        <a class="navbar-brand fw-bold text-white fs-4 d-flex align-items-center mb-0" asp-area="" asp-controller="Account" asp-action="@(sessionRole == "Production Manager" ? "ProductionManagerDashboard" : "Dashboard")">
                            <i class="bi bi-gear-wide-connected text-primary me-2 fs-3"></i> Manufacturing Portal
                        </a>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <span class="badge @getRoleBadgeClass(sessionRole) rounded-pill px-3 py-2 fs-7 d-none d-sm-inline-block">
                            <i class="bi bi-shield-check me-1"></i> @sessionRole
                        </span>
                        <div class="dropdown">
                            <button class="btn btn-outline-light btn-sm rounded-pill px-3 dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-5 text-primary"></i>
                                <span class="fw-semibold">@sessionName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold text-dark">@sessionName</div>
                                    <small class="text-muted">@@@sessionUsername (@sessionRole)</small>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="@(sessionRole == "Production Manager" ? "ProductionManagerDashboard" : "Dashboard")">
                                        <i class="bi bi-speedometer2 me-2 text-primary"></i> Dashboard
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="ProductionManagement" asp-action="Index">
                                        <i class="bi bi-gear-wide-connected me-2 text-primary"></i> Production Orders
                                    </a>
                                </li>
                                @if (sessionRole == "Admin" || sessionRole == "Inventory Manager" || sessionRole == "Store Manager")
                                {
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="RawMaterial" asp-action="Index">
                                            <i class="bi bi-boxes me-2 text-warning"></i> Raw Materials
                                        </a>
                                    </li>
                                }
                                @if (sessionRole == "Admin")
                                {
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="User" asp-action="Index">
                                            <i class="bi bi-people me-2 text-info"></i> User Directory
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Employee" asp-action="Index">
                                            <i class="bi bi-person-badge me-2 text-primary"></i> Employee Directory
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Machine" asp-action="Index">
                                        <i class="bi bi-cpu me-2 text-info"></i> Machine Directory
                                    </a>
                                </li>
                                @if (sessionRole == "Admin")
                                {
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Department" asp-action="Index">
                                            <i class="bi bi-building-gear me-2 text-success"></i> Department Directory
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Shift" asp-action="Index">
                                        <i class="bi bi-clock-history me-2 text-info"></i> Shift Management
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="MachineAssignment" asp-action="Index">
                                        <i class="bi bi-cpu-fill me-2 text-primary"></i> Machine Assignments
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="OperatorAssignment" asp-action="Index">
                                        <i class="bi bi-person-badge-fill me-2 text-indigo" style="color: #6366f1;"></i> Operator Assignments
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="ProductionSchedule" asp-action="Index">
                                        <i class="bi bi-calendar-week-fill me-2 text-primary"></i> Production Schedules
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2 text-danger fw-semibold" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <!-- Main Layout with Sidebar -->
        <div class="admin-layout-wrapper flex-grow-1">
            <!-- Left Sidebar -->
            <aside class="admin-sidebar" id="adminSidebar">
                <!-- User Profile Summary in Sidebar -->
                <div class="sidebar-profile">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary bg-opacity-25 p-2 text-primary border border-primary border-opacity-25 me-3">
                            <i class="bi bi-person-badge fs-4"></i>
                        </div>
                        <div class="overflow-hidden">
                            <h6 class="fw-bold mb-0 text-white text-truncate">@sessionName</h6>
                            <span class="badge @getRoleBadgeClass(sessionRole) rounded-pill px-2 py-1 fs-7 mt-1">@sessionRole</span>
                        </div>
                    </div>
                </div>

                <!-- Navigation Menu -->
                <div class="sidebar-menu">
                    @if (sessionRole == "Production Manager")
                    {
                        <!-- Production Manager Dedicated Navigation Sidebar -->
                        <div class="sidebar-section-title">Production Navigation</div>
                        <ul class="sidebar-nav">
                            <li>
                                <a class="sidebar-link @(currentController == "Account" && currentAction == "ProductionManagerDashboard" ? "active" : "")" asp-controller="Account" asp-action="ProductionManagerDashboard">
                                    <i class="bi bi-speedometer2 text-primary"></i> Manager Dashboard
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door text-info"></i> Home Page
                                </a>
                            </li>
                        </ul>

                        <div class="sidebar-section-title mt-3">Production Control</div>
                        <ul class="sidebar-nav">
                            <li>
                                <a class="sidebar-link @(currentController == "ProductionManagement" && currentAction == "Index" ? "active" : "")" asp-controller="ProductionManagement" asp-action="Index">
                                    <i class="bi bi-gear-wide-connected text-primary"></i> Production Orders
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "ProductionManagement" && currentAction == "Create" ? "active" : "")" asp-controller="ProductionManagement" asp-action="Create">
                                    <i class="bi bi-plus-circle-fill text-success"></i> New Production Order
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "MachineAssignment" && currentAction == "Index" ? "active" : "")" asp-controller="MachineAssignment" asp-action="Index">
                                    <i class="bi bi-cpu-fill text-warning"></i> Machine Assignments
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "MachineAssignment" && currentAction == "Create" ? "active" : "")" asp-controller="MachineAssignment" asp-action="Create">
                                    <i class="bi bi-plus-circle-fill text-success"></i> Assign Machine
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "OperatorAssignment" && currentAction == "Index" ? "active" : "")" asp-controller="OperatorAssignment" asp-action="Index">
                                    <i class="bi bi-person-badge-fill text-info"></i> Operator Assignments
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "OperatorAssignment" && currentAction == "Create" ? "active" : "")" asp-controller="OperatorAssignment" asp-action="Create">
                                    <i class="bi bi-person-plus-fill text-success"></i> Assign Operator
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "ProductionSchedule" && currentAction == "Index" ? "active" : "")" asp-controller="ProductionSchedule" asp-action="Index">
                                    <i class="bi bi-calendar-week-fill text-primary"></i> Production Schedules
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "ProductionSchedule" && currentAction == "Create" ? "active" : "")" asp-controller="ProductionSchedule" asp-action="Create">
                                    <i class="bi bi-calendar-plus-fill text-success"></i> Add Production Schedule
                                </a>
                            </li>
                        </ul>

                        <div class="sidebar-section-title mt-3">Equipment Directory</div>
                        <ul class="sidebar-nav">
                            <li>
                                <a class="sidebar-link @(currentController == "Machine" && currentAction == "Index" ? "active" : "")" asp-controller="Machine" asp-action="Index">
                                    <i class="bi bi-cpu-fill text-info"></i> Machine Directory
                                </a>
                            </li>
                        </ul>

                        <div class="sidebar-section-title mt-3">Shift Operations</div>
                        <ul class="sidebar-nav">
                            <li>
                                <a class="sidebar-link @(currentController == "Shift" && currentAction == "Index" ? "active" : "")" asp-controller="Shift" asp-action="Index">
                                    <i class="bi bi-clock-history text-info"></i> Shift Roster
                                </a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <!-- Admin & Master Navigation Sidebar -->
                        <div class="sidebar-section-title">Main Navigation</div>
                        <ul class="sidebar-nav">
                            <li>
                                <a class="sidebar-link @(currentController == "Account" && currentAction == "Dashboard" ? "active" : "")" asp-controller="Account" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 text-primary"></i> Admin Dashboard
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door text-info"></i> Home Page
                                </a>
                            </li>
                        </ul>

                        <div class="sidebar-section-title mt-3">Production Operations</div>
                        <ul class="sidebar-nav">
                            <li>
                                <a class="sidebar-link @(currentController == "ProductionManagement" && currentAction == "Index" ? "active" : "")" asp-controller="ProductionManagement" asp-action="Index">
                                    <i class="bi bi-gear-wide-connected text-primary"></i> Production Orders
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "ProductionManagement" && currentAction == "Create" ? "active" : "")" asp-controller="ProductionManagement" asp-action="Create">
                                    <i class="bi bi-plus-circle-fill text-success"></i> New Production Order
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "MachineAssignment" && currentAction == "Index" ? "active" : "")" asp-controller="MachineAssignment" asp-action="Index">
                                    <i class="bi bi-cpu-fill text-warning"></i> Machine Assignments
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "MachineAssignment" && currentAction == "Create" ? "active" : "")" asp-controller="MachineAssignment" asp-action="Create">
                                    <i class="bi bi-plus-circle-fill text-success"></i> New Machine Assignment
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "OperatorAssignment" && currentAction == "Index" ? "active" : "")" asp-controller="OperatorAssignment" asp-action="Index">
                                    <i class="bi bi-person-badge-fill text-info"></i> Operator Assignments
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "OperatorAssignment" && currentAction == "Create" ? "active" : "")" asp-controller="OperatorAssignment" asp-action="Create">
                                    <i class="bi bi-person-plus-fill text-success"></i> New Operator Assignment
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "ProductionSchedule" && currentAction == "Index" ? "active" : "")" asp-controller="ProductionSchedule" asp-action="Index">
                                    <i class="bi bi-calendar-week-fill text-primary"></i> Production Schedules
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "ProductionSchedule" && currentAction == "Create" ? "active" : "")" asp-controller="ProductionSchedule" asp-action="Create">
                                    <i class="bi bi-calendar-plus-fill text-success"></i> New Production Schedule
                                </a>
                            </li>
                        </ul>

                        <div class="sidebar-section-title mt-3">Employee & HR Management</div>
                        <ul class="sidebar-nav">
                            <li>
                                <a class="sidebar-link @(currentController == "Employee" && currentAction == "Index" ? "active" : "")" asp-controller="Employee" asp-action="Index">
                                    <i class="bi bi-person-badge-fill text-indigo" style="color: #818cf8;"></i> Employee Directory
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "Employee" && currentAction == "Create" ? "active" : "")" asp-controller="Employee" asp-action="Create">
                                    <i class="bi bi-person-plus-fill text-success"></i> Add New Employee
                                </a>
                            </li>
                        </ul>

                        <div class="sidebar-section-title mt-3">Department & Organization</div>
                        <ul class="sidebar-nav">
                            <li>
                                <a class="sidebar-link @(currentController == "Department" && currentAction == "Index" ? "active" : "")" asp-controller="Department" asp-action="Index">
                                    <i class="bi bi-building-gear text-success"></i> Department Directory
                                </a>
                            </li>
                        </ul>

                        <div class="sidebar-section-title mt-3">Shift & Roster Management</div>
                        <ul class="sidebar-nav">
                            <li>
                                <a class="sidebar-link @(currentController == "Shift" && currentAction == "Index" ? "active" : "")" asp-controller="Shift" asp-action="Index">
                                    <i class="bi bi-clock-history text-info"></i> Shift Management
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "Shift" && currentAction == "Create" ? "active" : "")" asp-controller="Shift" asp-action="Create">
                                    <i class="bi bi-plus-circle-fill text-success"></i> Add New Shift
                                </a>
                            </li>
                        </ul>

                        <div class="sidebar-section-title mt-3">Machine & Equipment</div>
                        <ul class="sidebar-nav">
                            <li>
                                <a class="sidebar-link @(currentController == "Machine" && currentAction == "Index" ? "active" : "")" asp-controller="Machine" asp-action="Index">
                                    <i class="bi bi-cpu-fill text-info"></i> Machine Directory
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "Machine" && currentAction == "Create" ? "active" : "")" asp-controller="Machine" asp-action="Create">
                                    <i class="bi bi-plus-circle-fill text-success"></i> Add New Machine
                                </a>
                            </li>
                        </ul>

                        <div class="sidebar-section-title mt-3">Raw Material Inventory</div>
                        <ul class="sidebar-nav">
                            <li>
                                <a class="sidebar-link @(currentController == "RawMaterial" && currentAction == "Index" ? "active" : "")" asp-controller="RawMaterial" asp-action="Index">
                                    <i class="bi bi-boxes text-warning"></i> Raw Materials List
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "RawMaterial" && currentAction == "Create" ? "active" : "")" asp-controller="RawMaterial" asp-action="Create">
                                    <i class="bi bi-box-seam-fill text-success"></i> Add Raw Material
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "RawMaterial" && currentAction == "LowStock" ? "active" : "")" asp-controller="RawMaterial" asp-action="LowStock">
                                    <i class="bi bi-exclamation-triangle-fill text-danger"></i> Low Stock Alerts
                                </a>
                            </li>
                        </ul>

                        <div class="sidebar-section-title mt-3">User Administration</div>
                        <ul class="sidebar-nav">
                            <li>
                                <a class="sidebar-link @(currentController == "User" && currentAction == "Index" ? "active" : "")" asp-controller="User" asp-action="Index">
                                    <i class="bi bi-people-fill text-warning"></i> Manage Users
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentController == "User" && currentAction == "Create" ? "active" : "")" asp-controller="User" asp-action="Create">
                                    <i class="bi bi-person-plus-fill text-success"></i> Add New User
                                </a>
                            </li>
                        </ul>

                        <div class="sidebar-section-title mt-3">Account & Access</div>
                        <ul class="sidebar-nav">
                            <li>
                                <a class="sidebar-link @(currentController == "Account" && currentAction == "Register" ? "active" : "")" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-badge-fill text-indigo"></i> Register Account
                                </a>
                            </li>
                        </ul>
                    }
                </div>

                <!-- Sidebar Footer -->
                <div class="sidebar-footer">
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm w-100 rounded-pill py-2 fw-semibold">
                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                    </a>
                </div>
            </aside>

            <!-- Main Page Content -->
            <main class="admin-main-content flex-grow-1 p-3 p-md-4">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <!-- Top Navbar for Non-Logged-in Guest Users -->
        <header>
            <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3 py-3">
                <div class="container-fluid px-4">
                    <a class="navbar-brand fw-bold text-white fs-4 d-flex align-items-center" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-gear-fill text-primary me-2 fs-3"></i> Manufacturing Portal
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door me-1"></i> Home
                                </a>
                            </li>
                        </ul>
                        <ul class="navbar-nav align-items-center">
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light rounded-pill px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary rounded-pill px-3" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <div class="container-fluid px-4 flex-grow-1">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container-fluid px-4 text-center">
            &copy; 2026 - Manufacturing Management Portal - Dynamic Role-Based System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var sidebarToggle = document.getElementById('sidebarToggle');
            var adminSidebar = document.getElementById('adminSidebar');
            var sidebarOverlay = document.getElementById('sidebarOverlay');

            if (sidebarToggle && adminSidebar) {
                sidebarToggle.addEventListener('click', function () {
                    adminSidebar.classList.toggle('show');
                    if (sidebarOverlay) sidebarOverlay.classList.toggle('show');
                });
            }

            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', function () {
                    adminSidebar.classList.remove('show');
                    sidebarOverlay.classList.remove('show');
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
