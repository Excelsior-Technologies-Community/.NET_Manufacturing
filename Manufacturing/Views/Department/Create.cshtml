@model Manufacturing.Models.Department

@{
    ViewData["Title"] = "Create Department";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-9 col-lg-8">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                <h3 class="fw-bold mb-1"><i class="bi bi-building-plus me-2 text-info"></i>Add New Department</h3>
                <p class="mb-0 text-white-50 fs-6">Create a new organizational department and set leadership & status</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DepartmentCode" class="form-label fw-semibold">Department Code <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-barcode"></i></span>
                                <input asp-for="DepartmentCode" class="form-control form-control-lg" placeholder="e.g. DP-001" required />
                            </div>
                            <span asp-validation-for="DepartmentCode" class="text-danger fs-7"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="DepartmentName" class="form-label fw-semibold">Department Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-building"></i></span>
                                <input asp-for="DepartmentName" class="form-control form-control-lg" placeholder="e.g. Quality Assurance" required />
                            </div>
                            <span asp-validation-for="DepartmentName" class="text-danger fs-7"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DepartmentHead" class="form-label fw-semibold">Department Head</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person-badge-fill"></i></span>
                                <input asp-for="DepartmentHead" class="form-control form-control-lg" placeholder="e.g. Rahul Patel" />
                            </div>
                            <span asp-validation-for="DepartmentHead" class="text-danger fs-7"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">Status <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-activity"></i></span>
                                <select asp-for="Status" class="form-select form-select-lg" required>
                                    <option value="Active" selected>Active</option>
                                    <option value="Inactive">Inactive</option>
                                    <option value="Pending">Pending</option>
                                </select>
                            </div>
                            <span asp-validation-for="Status" class="text-danger fs-7"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-file-text-fill"></i></span>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter department scope, responsibilities, or notes..."></textarea>
                        </div>
                        <span asp-validation-for="Description" class="text-danger fs-7"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-3 px-4">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg rounded-3 px-5 fw-bold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Save Department
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
