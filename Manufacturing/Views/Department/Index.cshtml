@model List<Manufacturing.Models.Department>

@{
    ViewData["Title"] = "Department Directory";

    var departments = Model ?? new List<Manufacturing.Models.Department>();
    int totalCount = departments.Count;
    int activeCount = departments.Count(d => (d.Status ?? "").Equals("Active", StringComparison.OrdinalIgnoreCase));
    int inactiveCount = departments.Count(d => !(d.Status ?? "").Equals("Active", StringComparison.OrdinalIgnoreCase));
    int headCount = departments.Count(d => !string.IsNullOrWhiteSpace(d.DepartmentHead));
}

<style>
    .header-banner {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .stat-card {
        transition: all 0.25s ease-in-out;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px -6px rgba(0, 0, 0, 0.08) !important;
    }

    .dept-avatar-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.15rem;
        background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
        color: #0284c7;
        border: 1px solid rgba(2, 132, 199, 0.2);
    }

    .table-custom standard-thead {
        background-color: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
    }

    .table-custom tbody tr {
        transition: background-color 0.15s ease;
    }

    .table-custom tbody tr:hover {
        background-color: #f1f5f9 !important;
    }

    .badge-active {
        background-color: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .badge-inactive {
        background-color: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .badge-pending {
        background-color: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
    }

    .filter-btn-group .btn {
        border-radius: 20px;
        padding: 4px 16px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .filter-btn-group .btn.active {
        background-color: #0284c7 !important;
        color: #ffffff !important;
        border-color: #0284c7 !important;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .action-btn:hover {
        transform: scale(1.08);
    }
</style>

<div class="container-fluid px-4 py-4">

    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white header-banner position-relative overflow-hidden">
        <div class="mb-3 mb-md-0 z-1">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-primary bg-opacity-25 text-info border border-info border-opacity-25 px-3 py-1 rounded-pill fw-semibold fs-7">
                    <i class="bi bi-shield-check me-1"></i> Admin Operations
                </span>
                <span class="text-white-50 fs-7">• Manufacturing System</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-diagram-3-fill text-info"></i> Department Directory
            </h2>
            <p class="text-white-50 mb-0 fs-6">
                Manage organizational divisions, unit managers, operational status, and manufacturing facility teams.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center z-1">
            <a asp-action="Create" class="btn btn-info text-dark rounded-pill px-4 py-2 shadow-sm fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle-fill fs-5"></i>
                <span>Add Department</span>
            </a>
            <button class="btn btn-outline-light rounded-pill px-3 py-2 fw-medium d-flex align-items-center gap-2" onclick="exportToCSV()">
                <i class="bi bi-file-earmark-spreadsheet-fill text-success fs-6"></i>
                <span>Export CSV</span>
            </button>
            <a asp-controller="Account" asp-action="Dashboard" class="btn btn-outline-light rounded-pill px-3 py-2 fw-medium d-flex align-items-center gap-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- KPI Summary Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 stat-card bg-white h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-uppercase text-muted fw-bold fs-8 d-block mb-1">Total Units</span>
                            <h3 class="fw-bold mb-0 text-dark">@totalCount</h3>
                            <small class="text-muted fs-8">Registered departments</small>
                        </div>
                        <div class="p-3 rounded-4 bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-buildings-fill fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 stat-card bg-white h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-uppercase text-muted fw-bold fs-8 d-block mb-1">Active Operations</span>
                            <h3 class="fw-bold mb-0 text-success">@activeCount</h3>
                            <small class="text-muted fs-8">Operational departments</small>
                        </div>
                        <div class="p-3 rounded-4 bg-success bg-opacity-10 text-success">
                            <i class="bi bi-check-circle-fill fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 stat-card bg-white h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-uppercase text-muted fw-bold fs-8 d-block mb-1">Inactive / Standby</span>
                            <h3 class="fw-bold mb-0 text-danger">@inactiveCount</h3>
                            <small class="text-muted fs-8">Standby units</small>
                        </div>
                        <div class="p-3 rounded-4 bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-pause-circle-fill fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 stat-card bg-white h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-uppercase text-muted fw-bold fs-8 d-block mb-1">Assigned Leaders</span>
                            <h3 class="fw-bold mb-0 text-warning">@headCount</h3>
                            <small class="text-muted fs-8">Department heads</small>
                        </div>
                        <div class="p-3 rounded-4 bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-person-badge-fill fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table Container Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <!-- Table Control Header -->
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-3 border-bottom">
            <div class="d-flex align-items-center gap-3">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-list-nested text-info"></i> Department Records
                </h5>
                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold" id="tableBadgeCount">
                    Showing @totalCount Departments
                </span>
            </div>

            <div class="d-flex align-items-center gap-3 flex-wrap ms-auto">
                <!-- Status Filter Pills -->
                <div class="btn-group filter-btn-group p-1 bg-light border rounded-pill" role="group" id="statusFilterGroup">
                    <button type="button" class="btn filter-btn active rounded-pill px-3 py-1" data-status="ALL">All</button>
                    <button type="button" class="btn filter-btn rounded-pill px-3 py-1 text-muted" data-status="Active">Active</button>
                    <button type="button" class="btn filter-btn rounded-pill px-3 py-1 text-muted" data-status="Inactive">Inactive</button>
                </div>

                <!-- Search Box -->
                <div class="input-group input-group-sm" style="width: 280px;">
                    <span class="input-group-text bg-light border-end-0 text-muted ps-3 rounded-start-pill"><i class="bi bi-search"></i></span>
                    <input type="text" id="deptSearchInput" class="form-control bg-light border-start-0 ps-0 rounded-end-pill py-2" placeholder="Search code, name, head..." />
                </div>
            </div>
        </div>

        <!-- Table View -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0" id="deptTable">
                    <thead class="bg-light text-muted text-uppercase fs-7 fw-bold border-bottom">
                        <tr>
                            <th class="ps-4 py-3" style="width: 90px;"># ID</th>
                            <th class="py-3" style="width: 250px;">Department Info</th>
                            <th class="py-3" style="width: 220px;">Department Head</th>
                            <th class="py-3">Description</th>
                            <th class="py-3" style="width: 150px;">Created Date</th>
                            <th class="py-3 text-center" style="width: 130px;">Status</th>
                            <th class="py-3 text-end pe-4" style="width: 160px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="deptTableBody">
                        @if (departments.Count > 0)
                        {
                            @foreach (var d in departments)
                            {
                                var initial = string.IsNullOrWhiteSpace(d.DepartmentName) ? "D" : d.DepartmentName.Substring(0, 1).ToUpper();
                                var isStatusActive = (d.Status ?? "").Equals("Active", StringComparison.OrdinalIgnoreCase);
                                var badgeClass = isStatusActive ? "badge-active" : "badge-inactive";

                                <tr class="dept-row" data-id="@d.DepartmentId" data-code="@d.DepartmentCode" data-name="@d.DepartmentName" data-head="@d.DepartmentHead" data-status="@d.Status" data-date="@d.CreatedDate.ToString("yyyy-MM-dd")" data-desc="@d.Description">
                                    <td class="ps-4 fw-bold text-secondary">#@d.DepartmentId</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-3 py-1">
                                            <div class="dept-avatar-box">
                                                @initial
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark fs-6 dept-name-text">@d.DepartmentName</div>
                                                <span class="badge bg-light text-primary border rounded-pill px-2 py-1 fs-8 fw-semibold dept-code-text">
                                                    <i class="bi bi-barcode me-1"></i>@d.DepartmentCode
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(d.DepartmentHead))
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle bg-light text-dark p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                    <i class="bi bi-person-fill text-primary"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-semibold text-dark fs-7 dept-head-text">@d.DepartmentHead</div>
                                                    <small class="text-muted fs-8">Unit Lead</small>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic fs-7"><i class="bi bi-person-x me-1"></i>Unassigned</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="text-truncate text-secondary fs-7 dept-desc-text" style="max-width: 300px;" title="@d.Description">
                                            @(string.IsNullOrWhiteSpace(d.Description) ? "No description provided." : d.Description)
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-secondary fs-7">
                                            <i class="bi bi-calendar3 me-1 text-primary"></i>
                                            @d.CreatedDate.ToString("dd MMM yyyy")
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Status" asp-route-id="@d.DepartmentId" class="badge @badgeClass rounded-pill px-3 py-2 fw-semibold text-decoration-none text-center" title="Click to toggle status">
                                            <i class="bi bi-circle-fill me-1 fs-8"></i>@(string.IsNullOrEmpty(d.Status) ? "Active" : d.Status)
                                        </a>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            <button type="button" class="btn btn-light text-info action-btn" title="View Details" onclick="viewDetails(@d.DepartmentId)">
                                                <i class="bi bi-eye-fill"></i>
                                            </button>
                                            <a asp-action="Edit" asp-route-id="@d.DepartmentId" class="btn btn-light text-primary action-btn" title="Edit Department">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@d.DepartmentId" class="btn btn-light text-danger action-btn" title="Delete Department" onclick="return confirm('Are you sure you want to delete department \'@d.DepartmentName\'?');">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="noRecordsRow">
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-building-x fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                    <h5 class="fw-bold text-dark">No Departments Found</h5>
                                    <p class="mb-3 text-muted">No department records are currently available in the database.</p>
                                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                                        <i class="bi bi-plus-circle-fill me-1"></i> Create Department
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2 border-top">
            <small class="text-muted" id="footerText">Showing @totalCount department records</small>
            <span class="badge bg-light text-muted border px-3 py-2 rounded-pill fs-8">
                <i class="bi bi-shield-check text-success me-1"></i> Connected to Manufacturing DB
            </span>
        </div>
    </div>
</div>

<!-- View Department Details Modal -->
<div class="modal fade" id="viewDeptModal" tabindex="-1" aria-labelledby="viewDeptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white rounded-top-4 py-3 px-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="viewDeptModalLabel">
                    <i class="bi bi-info-circle-fill text-info"></i> Department Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4 pb-3 border-bottom">
                    <div class="dept-avatar-box mx-auto mb-2 shadow-sm" id="viewAvatar" style="width: 60px; height: 60px; font-size: 1.6rem;">
                        D
                    </div>
                    <h4 class="fw-bold mb-1 text-dark" id="viewName">-</h4>
                    <span class="badge bg-light text-primary border rounded-pill px-3 py-1 fs-7" id="viewCode">-</span>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-uppercase text-muted fw-bold fs-8 d-block mb-1">Department ID</small>
                            <span class="fw-bold text-dark fs-6" id="viewId">-</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-uppercase text-muted fw-bold fs-8 d-block mb-1">Status</small>
                            <span class="badge bg-success rounded-pill px-3 py-1" id="viewStatus">-</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-uppercase text-muted fw-bold fs-8 d-block mb-1">Department Head</small>
                            <span class="fw-semibold text-dark fs-6 d-flex align-items-center gap-2" id="viewHead">
                                <i class="bi bi-person-fill text-primary"></i> -
                            </span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-uppercase text-muted fw-bold fs-8 d-block mb-1">Created Date</small>
                            <span class="text-dark fs-6" id="viewDate">-</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-uppercase text-muted fw-bold fs-8 d-block mb-1">Description</small>
                            <p class="text-secondary mb-0 fs-7" id="viewDesc">-</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light rounded-bottom-4 px-4 py-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById('deptSearchInput');
            const filterBtns = document.querySelectorAll('.filter-btn');

            let currentStatusFilter = 'ALL';

            if (searchInput) {
                searchInput.addEventListener('keyup', filterTable);
            }

            filterBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    filterBtns.forEach(b => {
                        b.classList.remove('active');
                        b.classList.add('text-muted');
                    });
                    this.classList.add('active');
                    this.classList.remove('text-muted');

                    currentStatusFilter = this.getAttribute('data-status');
                    filterTable();
                });
            });

            function filterTable() {
                const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
                const rows = document.querySelectorAll('.dept-row');
                let visibleCount = 0;

                rows.forEach(row => {
                    const code = (row.getAttribute('data-code') || '').toLowerCase();
                    const name = (row.getAttribute('data-name') || '').toLowerCase();
                    const head = (row.getAttribute('data-head') || '').toLowerCase();
                    const status = (row.getAttribute('data-status') || '').toLowerCase();

                    const matchesSearch = code.includes(query) || name.includes(query) || head.includes(query);
                    const matchesStatus = (currentStatusFilter === 'ALL') || (status === currentStatusFilter.toLowerCase());

                    if (matchesSearch && matchesStatus) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                const badge = document.getElementById('tableBadgeCount');
                if (badge) {
                    badge.innerText = `Showing ${visibleCount} Departments`;
                }

                const footerText = document.getElementById('footerText');
                if (footerText) {
                    footerText.innerText = `Showing ${visibleCount} department records`;
                }
            }
        });

        function viewDetails(id) {
            const row = document.querySelector(`.dept-row[data-id="${id}"]`);
            if (!row) return;

            const code = row.getAttribute('data-code');
            const name = row.getAttribute('data-name');
            const head = row.getAttribute('data-head') || 'Unassigned';
            const status = row.getAttribute('data-status') || 'Active';
            const date = row.getAttribute('data-date');
            const desc = row.getAttribute('data-desc') || 'No description provided.';
            const initial = name ? name.charAt(0).toUpperCase() : 'D';

            document.getElementById('viewAvatar').innerText = initial;
            document.getElementById('viewName').innerText = name;
            document.getElementById('viewCode').innerText = code;
            document.getElementById('viewId').innerText = `#${id}`;
            document.getElementById('viewStatus').innerText = status;
            document.getElementById('viewHead').innerHTML = `<i class="bi bi-person-fill text-primary"></i> ${head}`;
            document.getElementById('viewDate').innerText = date;
            document.getElementById('viewDesc').innerText = desc;

            const modal = new bootstrap.Modal(document.getElementById('viewDeptModal'));
            modal.show();
        }

        function exportToCSV() {
            const rows = document.querySelectorAll('.dept-row');
            if (rows.length === 0) {
                alert('No department data to export.');
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,ID,Code,Name,Head,Status,CreatedDate,Description\n";

            rows.forEach(r => {
                const id = r.getAttribute('data-id');
                const code = `"${r.getAttribute('data-code')}"`;
                const name = `"${r.getAttribute('data-name')}"`;
                const head = `"${r.getAttribute('data-head') || ''}"`;
                const status = `"${r.getAttribute('data-status')}"`;
                const date = `"${r.getAttribute('data-date')}"`;
                const desc = `"${(r.getAttribute('data-desc') || '').replace(/"/g, '""')}"`;

                csvContent += `${id},${code},${name},${head},${status},${date},${desc}\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Department_Export_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
}
