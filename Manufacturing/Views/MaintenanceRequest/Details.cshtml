@model Manufacturing.Models.MaintenanceRequest

@{
    ViewData["Title"] = $"Request Details REQ-{Model?.RequestId.ToString("D4")} - Machine Manager Portal";

    string getPriorityBadge(string? priority)
    {
        switch (priority?.Trim().ToLower())
        {
            case "critical":
            case "urgent":
                return "bg-danger text-white";
            case "high":
                return "bg-warning text-dark";
            case "medium":
                return "bg-info text-dark";
            case "low":
                return "bg-secondary text-white";
            default:
                return "bg-light text-dark border";
        }
    }

    string getStatusBadge(string? status)
    {
        switch (status?.Trim().ToLower())
        {
            case "completed":
            case "resolved":
                return "bg-success text-white";
            case "in progress":
                return "bg-primary text-white";
            case "pending":
                return "bg-warning text-dark";
            case "on hold":
                return "bg-info text-dark";
            case "cancelled":
            case "rejected":
                return "bg-danger text-white";
            default:
                return "bg-secondary text-white";
        }
    }
}

<div class="container-fluid px-4 py-4">
    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #b91c1c 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger text-white px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Machine Manager Audit</span>
                <span class="badge bg-white bg-opacity-25 text-white px-3 py-1 rounded-pill fs-7">Maintenance Ticket Ledger</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-info-circle-fill text-info me-2 fs-2"></i> Maintenance Ticket Details
            </h2>
            <p class="text-slate-300 mb-0 opacity-85">
                Audit record for Maintenance Request REQ-@Model?.RequestId.ToString("D4")
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.RequestId" class="btn btn-warning rounded-pill px-4 py-2 shadow-sm fw-bold text-dark">
                <i class="bi bi-pencil-square me-1"></i> Edit Ticket
            </a>
            <button type="button" onclick="window.print()" class="btn btn-light rounded-pill px-3 py-2 shadow-sm fw-semibold text-dark">
                <i class="bi bi-printer me-1 text-primary"></i> Print
            </button>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 shadow-sm fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Requests
            </a>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row g-4">
        <!-- Overview Card -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center">
                        <i class="bi bi-cpu-fill text-primary me-2"></i> Machine & Priority Specifications
                    </h5>
                    <div class="d-flex gap-2">
                        <span class="badge @getPriorityBadge(Model?.Priority) rounded-pill px-3 py-2 fs-7 fw-semibold">
                            Priority: @Model?.Priority
                        </span>
                        <span class="badge @getStatusBadge(Model?.Status) rounded-pill px-3 py-2 fs-7 fw-semibold">
                            Status: @Model?.Status
                        </span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <!-- Machine Info -->
                        <div class="col-md-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-uppercase text-muted fw-bold fs-7 d-block mb-1">
                                    <i class="bi bi-cpu text-info me-1"></i> Target Equipment
                                </small>
                                <h3 class="fw-bold text-dark mb-1">
                                    @(string.IsNullOrEmpty(Model?.MachineName) ? $"Machine #{Model?.MachineId}" : Model.MachineName)
                                </h3>
                                <span class="badge bg-white text-dark border px-2 py-1 fs-7 font-monospace">
                                    Machine ID: @Model?.MachineId
                                </span>
                            </div>
                        </div>

                        <!-- Problem Description Card -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-uppercase text-muted fw-bold fs-7 d-block mb-2">
                                    <i class="bi bi-exclamation-octagon text-danger me-1"></i> Problem Description & Breakdown Symptoms
                                </small>
                                <div class="fs-6 text-dark fw-medium" style="white-space: pre-line;">
                                    @Model?.ProblemDescription
                                </div>
                            </div>
                        </div>

                        <!-- Requested By -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100 border">
                                <small class="text-uppercase text-muted fw-bold fs-7 d-block mb-1">
                                    <i class="bi bi-person-badge text-secondary me-1"></i> Requested By
                                </small>
                                <div class="fs-5 fw-bold text-dark">
                                    @(string.IsNullOrEmpty(Model?.RequestedBy) ? "Machine Manager" : Model.RequestedBy)
                                </div>
                            </div>
                        </div>

                        <!-- Assigned Technician -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100 border">
                                <small class="text-uppercase text-muted fw-bold fs-7 d-block mb-1">
                                    <i class="bi bi-wrench text-primary me-1"></i> Assigned Technician / Engineer
                                </small>
                                <div class="fs-5 fw-bold text-dark">
                                    @(string.IsNullOrEmpty(Model?.AssignedTo) ? "Unassigned" : Model.AssignedTo)
                                </div>
                            </div>
                        </div>

                        <!-- Request Date -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100 border">
                                <small class="text-uppercase text-muted fw-bold fs-7 d-block mb-1">
                                    <i class="bi bi-calendar-event text-success me-1"></i> Request Date & Time
                                </small>
                                <div class="fs-5 fw-bold text-dark">
                                    @Model?.RequestDate.ToString("dd MMMM yyyy")
                                </div>
                                <div class="text-muted small">
                                    Time: @Model?.RequestDate.ToString("hh:mm:ss tt")
                                </div>
                            </div>
                        </div>

                        <!-- Completion Date -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100 border">
                                <small class="text-uppercase text-muted fw-bold fs-7 d-block mb-1">
                                    <i class="bi bi-calendar-check text-primary me-1"></i> Completion Date & Time
                                </small>
                                @if (Model != null && Model.CompletionDate.HasValue)
                                {
                                    <div class="fs-5 fw-bold text-dark">
                                        @Model.CompletionDate.Value.ToString("dd MMMM yyyy")
                                    </div>
                                    <div class="text-muted small">
                                        Time: @Model.CompletionDate.Value.ToString("hh:mm:ss tt")
                                    </div>
                                }
                                else
                                {
                                    <div class="fs-5 fw-bold text-warning">
                                        <i class="bi bi-hourglass-split me-1"></i> Pending / In Progress
                                    </div>
                                    <div class="text-muted small">
                                        No completion timestamp logged yet
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Remarks & Resolution Notes Card -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center">
                        <i class="bi bi-chat-left-text text-info me-2"></i> Remarks & Repair Resolution Notes
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrWhiteSpace(Model?.Remarks))
                    {
                        <div class="p-3 bg-light rounded-3 border text-dark fs-6" style="white-space: pre-line;">
                            @Model.Remarks
                        </div>
                    }
                    else
                    {
                        <div class="text-muted fst-italic p-3 bg-light rounded-3 border text-center">
                            No additional technician remarks or resolution notes recorded for this ticket.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar Audit Summary Card -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-dark text-white py-3 px-4 rounded-top-4">
                    <h5 class="fw-bold mb-0 d-flex align-items-center">
                        <i class="bi bi-shield-check text-success me-2"></i> Audit Control Summary
                    </h5>
                </div>
                <div class="card-body p-4">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                            <span class="text-muted fw-medium"><i class="bi bi-hash me-1"></i> Ticket ID</span>
                            <span class="fw-bold font-monospace text-dark">REQ-@Model?.RequestId.ToString("D4")</span>
                        </li>

                        <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                            <span class="text-muted fw-medium"><i class="bi bi-exclamation-triangle me-1"></i> Priority</span>
                            <span class="badge @getPriorityBadge(Model?.Priority) rounded-pill px-3 py-1 fs-7 fw-semibold">
                                @Model?.Priority
                            </span>
                        </li>

                        <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                            <span class="text-muted fw-medium"><i class="bi bi-activity me-1"></i> Ticket Status</span>
                            <span class="badge @getStatusBadge(Model?.Status) rounded-pill px-3 py-1 fs-7 fw-semibold">
                                @Model?.Status
                            </span>
                        </li>

                        <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                            <span class="text-muted fw-medium"><i class="bi bi-clock me-1"></i> Ticket Logged Date</span>
                            <span class="fw-bold text-dark">
                                @(Model != null && Model.CreatedDate != default && Model.CreatedDate != DateTime.MinValue ? Model.CreatedDate.ToString("dd MMM yyyy HH:mm") : (Model != null ? Model.RequestDate.ToString("dd MMM yyyy HH:mm") : "-"))
                            </span>
                        </li>
                    </ul>

                    <hr class="my-4" />

                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model?.RequestId" class="btn btn-warning text-dark rounded-pill py-2 fw-bold">
                            <i class="bi bi-pencil-square me-1"></i> Modify Ticket
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model?.RequestId" onclick="return confirm('Are you sure you want to delete this maintenance request ticket?');" class="btn btn-outline-danger rounded-pill py-2 fw-semibold">
                            <i class="bi bi-trash me-1"></i> Delete Ticket
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold">
                            <i class="bi bi-arrow-left me-1"></i> Back to Roster
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
