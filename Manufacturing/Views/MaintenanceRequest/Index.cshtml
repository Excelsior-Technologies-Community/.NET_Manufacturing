@model List<Manufacturing.Models.MaintenanceRequest>

@{
    ViewData["Title"] = "Maintenance Requests - Machine Manager Portal";

    var requests = Model ?? new List<Manufacturing.Models.MaintenanceRequest>();

    int totalRequests = requests.Count;
    int pendingCount = requests.Count(r => string.Equals(r.Status, "Pending", StringComparison.OrdinalIgnoreCase));
    int inProgressCount = requests.Count(r => string.Equals(r.Status, "In Progress", StringComparison.OrdinalIgnoreCase) ||
                                               string.Equals(r.Status, "On Hold", StringComparison.OrdinalIgnoreCase));
    int completedCount = requests.Count(r => string.Equals(r.Status, "Completed", StringComparison.OrdinalIgnoreCase) ||
                                                string.Equals(r.Status, "Resolved", StringComparison.OrdinalIgnoreCase));

    string getPriorityBadge(string? priority)
    {
        switch (priority?.Trim().ToLower())
        {
            case "critical":
            case "urgent":
                return "bg-danger text-white";
            case "high":
                return "bg-warning text-dark";
            case "medium":
                return "bg-info text-dark";
            case "low":
                return "bg-secondary text-white";
            default:
                return "bg-light text-dark border";
        }
    }

    string getStatusBadge(string? status)
    {
        switch (status?.Trim().ToLower())
        {
            case "completed":
            case "resolved":
                return "bg-success text-white";
            case "in progress":
                return "bg-primary text-white";
            case "pending":
                return "bg-warning text-dark";
            case "on hold":
                return "bg-info text-dark";
            case "cancelled":
            case "rejected":
                return "bg-danger text-white";
            default:
                return "bg-secondary text-white";
        }
    }
}

<div class="container-fluid px-4 py-4">
    <!-- TempData Success Alert -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Top Navigation Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #b91c1c 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger text-white px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Machine Manager Portal</span>
                <span class="badge bg-white bg-opacity-25 text-white px-3 py-1 rounded-pill fs-7">Equipment Repair & Maintenance</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-tools text-danger me-2 fs-2"></i> Maintenance Request Management
            </h2>
            <p class="text-slate-300 mb-0 opacity-85">
                Machine Manager Control Hub: Log equipment breakdowns, assign technicians, track repair priorities, and monitor resolution status.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-danger rounded-pill px-4 py-2 shadow-sm fw-bold text-white">
                <i class="bi bi-plus-circle-fill me-1"></i> New Request
            </a>
            <button type="button" onclick="exportMaintenanceCSV()" class="btn btn-light rounded-pill px-4 py-2 shadow-sm fw-semibold text-dark">
                <i class="bi bi-file-earmark-spreadsheet me-1 text-success"></i> Export CSV
            </button>
            <a asp-controller="Account" asp-action="ProductionManagerDashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Machine Manager KPI Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-danger">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Requests</div>
                        <div class="fs-3 fw-bold text-danger mb-0" id="statTotal">@totalRequests</div>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-tools fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Pending Review</div>
                        <div class="fs-3 fw-bold text-warning mb-0" id="statPending">@pendingCount</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">In Repair</div>
                        <div class="fs-3 fw-bold text-primary mb-0" id="statInProgress">@inProgressCount</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-wrench-adjustable fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Resolved / Completed</div>
                        <div class="fs-3 fw-bold text-success mb-0" id="statCompleted">@completedCount</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter and Search Controls -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-5 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="maintenanceSearchInput" class="form-control bg-light border-start-0 rounded-end-pill py-2" placeholder="Search machine, issue description, personnel..." />
                    </div>
                </div>

                <div class="col-6 col-md-3 col-lg-3">
                    <select id="statusFilter" class="form-select rounded-pill py-2">
                        <option value="">All Statuses</option>
                        <option value="Pending">Pending</option>
                        <option value="In Progress">In Progress</option>
                        <option value="On Hold">On Hold</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>

                <div class="col-6 col-md-2 col-lg-3">
                    <select id="priorityFilter" class="form-select rounded-pill py-2">
                        <option value="">All Priorities</option>
                        <option value="Critical">Critical</option>
                        <option value="High">High</option>
                        <option value="Medium">Medium</option>
                        <option value="Low">Low</option>
                    </select>
                </div>

                <div class="col-12 col-md-2 col-lg-2 text-end">
                    <button type="button" onclick="resetFilters()" class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm w-100">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
            <h5 class="fw-bold mb-0 text-dark d-flex align-items-center">
                <i class="bi bi-table text-danger me-2"></i> Maintenance Service Tickets
            </h5>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fs-7 fw-normal" id="recordCountBadge">
                Showing @totalRequests entries
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="maintenanceTable">
                <thead class="bg-light text-uppercase fs-7 text-muted border-top">
                    <tr>
                        <th class="ps-4 py-3">Request ID</th>
                        <th class="py-3">Machine</th>
                        <th class="py-3">Problem Description</th>
                        <th class="py-3 text-center">Priority</th>
                        <th class="py-3">Requested By</th>
                        <th class="py-3">Assigned Technician</th>
                        <th class="py-3 text-center">Status</th>
                        <th class="py-3">Request Date</th>
                        <th class="pe-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (requests.Any())
                    {
                        foreach (var item in requests)
                        {
                            <tr class="request-row">
                                <td class="ps-4 fw-bold text-dark">
                                    <span class="badge bg-light text-dark border px-2 py-1 font-monospace">
                                        REQ-@item.RequestId.ToString("D4")
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark d-flex align-items-center">
                                        <i class="bi bi-cpu text-info me-2"></i> @(string.IsNullOrEmpty(item.MachineName) ? $"Machine #{item.MachineId}" : item.MachineName)
                                    </div>
                                    <small class="text-muted">Machine ID: @item.MachineId</small>
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block fw-medium text-dark" style="max-width: 220px;" title="@item.ProblemDescription">
                                        @item.ProblemDescription
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @getPriorityBadge(item.Priority) rounded-pill px-3 py-1 fs-7 fw-semibold">
                                        @item.Priority
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">
                                        <i class="bi bi-person-circle me-1 text-secondary"></i> @(string.IsNullOrEmpty(item.RequestedBy) ? "Machine Manager" : item.RequestedBy)
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">
                                        <i class="bi bi-wrench me-1 text-primary"></i> @(string.IsNullOrEmpty(item.AssignedTo) ? "Unassigned" : item.AssignedTo)
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge @getStatusBadge(item.Status) rounded-pill px-3 py-2 fs-7 fw-semibold">
                                        @item.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="text-dark small">
                                        <i class="bi bi-calendar-event me-1 text-success"></i> @item.RequestDate.ToString("dd MMM yyyy")
                                    </div>
                                    <small class="text-muted">@item.RequestDate.ToString("hh:mm tt")</small>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.RequestId" class="btn btn-outline-info rounded-start-pill px-3" title="View Details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.RequestId" class="btn btn-outline-warning px-3" title="Edit Ticket">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.RequestId" onclick="return confirm('Are you sure you want to delete maintenance request REQ-@item.RequestId.ToString("D4")?');" class="btn btn-outline-danger rounded-end-pill px-3" title="Delete Ticket">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 text-secondary opacity-50 d-block mb-3"></i>
                                    <h5 class="fw-bold">No Maintenance Requests Found</h5>
                                    <p class="small mb-3">There are no equipment maintenance tickets logged in the system yet.</p>
                                    <a asp-action="Create" class="btn btn-danger btn-sm rounded-pill px-4 py-2 text-white fw-bold">
                                        <i class="bi bi-plus-circle-fill me-1"></i> Log First Request
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-light py-3 border-0">
            <div class="d-flex justify-content-between align-items-center text-muted small">
                <div>
                    <i class="bi bi-shield-check text-success me-1"></i> Machine Manager Control System | Maintenance Ticket Roster
                </div>
                <div>
                    Updated: @DateTime.Now.ToString("dd MMM yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('maintenanceSearchInput');
            const statusFilter = document.getElementById('statusFilter');
            const priorityFilter = document.getElementById('priorityFilter');

            if (searchInput && statusFilter && priorityFilter) {
                searchInput.addEventListener('keyup', filterTable);
                statusFilter.addEventListener('change', filterTable);
                priorityFilter.addEventListener('change', filterTable);
            }
        });

        function filterTable() {
            const search = document.getElementById('maintenanceSearchInput').value.toLowerCase();
            const status = document.getElementById('statusFilter').value.toLowerCase();
            const priority = document.getElementById('priorityFilter').value.toLowerCase();
            const rows = document.querySelectorAll('.request-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const matchesSearch = text.includes(search);
                const matchesStatus = status === '' || text.includes(status);
                const matchesPriority = priority === '' || text.includes(priority);

                if (matchesSearch && matchesStatus && matchesPriority) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const badge = document.getElementById('recordCountBadge');
            if (badge) {
                badge.textContent = `Showing ${visibleCount} entries`;
            }
        }

        function resetFilters() {
            document.getElementById('maintenanceSearchInput').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('priorityFilter').value = '';
            filterTable();
        }

        function exportMaintenanceCSV() {
            const rows = document.querySelectorAll('#maintenanceTable tr');
            let csv = [];

            rows.forEach(row => {
                let cols = row.querySelectorAll('td, th');
                let rowData = [];
                cols.forEach((col, idx) => {
                    if (idx < cols.length - 1) { // Skip actions column
                        let text = col.innerText.replace(/(\r\n|\n|\r)/gm, ' ').trim();
                        text = text.replace(/"/g, '""');
                        rowData.push(`"${text}"`);
                    }
                });
                if (rowData.length > 0) {
                    csv.push(rowData.join(','));
                }
            });

            const csvFile = new Blob([csv.join('\n')], { type: 'text/csv' });
            const downloadLink = document.createElement('a');
            downloadLink.download = `Maintenance_Requests_${new Date().toISOString().slice(0, 10)}.csv`;
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = 'none';
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}
