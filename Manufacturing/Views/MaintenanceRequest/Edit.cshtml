@model Manufacturing.Models.MaintenanceRequest

@{
    ViewData["Title"] = $"Edit Maintenance Request REQ-{Model?.RequestId.ToString("D4")} - Machine Manager Portal";

    var machineList = ViewBag.MachineList as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container-fluid px-4 py-4">
    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #d97706 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Machine Manager Portal</span>
                <span class="badge bg-white bg-opacity-25 text-white px-3 py-1 rounded-pill fs-7">Edit Ticket REQ-@Model?.RequestId.ToString("D4")</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-pencil-square text-warning me-2 fs-2"></i> Edit Maintenance Request
            </h2>
            <p class="text-slate-300 mb-0 opacity-85">
                Update maintenance ticket status, technician assignment, priority, or resolution notes.
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 shadow-sm fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Requests
            </a>
        </div>
    </div>

    <!-- Main Form Container -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center">
                        <i class="bi bi-sliders text-warning me-2"></i> Update Maintenance Ticket Parameters
                    </h5>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill font-monospace">
                        REQ-@Model?.RequestId.ToString("D4")
                    </span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" id="editMaintenanceForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                        <!-- Primary Key & Display Property Hidden Fields -->
                        <input type="hidden" asp-for="RequestId" />
                        <input type="hidden" asp-for="MachineName" value="@(Model?.MachineName ?? "N/A")" />

                        <div class="row g-4">
                            <!-- Machine Selection -->
                            <div class="col-md-6">
                                <label asp-for="MachineId" class="form-label fw-semibold text-dark">
                                    Machine <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-cpu text-info"></i>
                                    </span>
                                    <select asp-for="MachineId" asp-items="machineList" class="form-select border-start-0 py-2">
                                        <option value="">-- Select Machine --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="MachineId" class="text-danger fs-7"></span>
                            </div>

                            <!-- Priority Level -->
                            <div class="col-md-6">
                                <label asp-for="Priority" class="form-label fw-semibold text-dark">
                                    Priority Level
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-exclamation-triangle text-warning"></i>
                                    </span>
                                    <select asp-for="Priority" class="form-select border-start-0 py-2">
                                        <option value="Medium">Medium</option>
                                        <option value="High">High</option>
                                        <option value="Critical">Critical</option>
                                        <option value="Low">Low</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Priority" class="text-danger fs-7"></span>
                            </div>

                            <!-- Request Date & Time -->
                            <div class="col-md-6">
                                <label asp-for="RequestDate" class="form-label fw-semibold text-dark">
                                    Request Date & Time <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-calendar-event text-success"></i>
                                    </span>
                                    <input asp-for="RequestDate" type="datetime-local" class="form-control border-start-0 py-2" value="@(Model != null && Model.RequestDate != default ? Model.RequestDate.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))" />
                                </div>
                                <span asp-validation-for="RequestDate" class="text-danger fs-7"></span>
                            </div>

                            <!-- Completion Date & Time (Optional) -->
                            <div class="col-md-6">
                                <label asp-for="CompletionDate" class="form-label fw-semibold text-dark">
                                    Completion Date (Optional)
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-calendar-check text-primary"></i>
                                    </span>
                                    <input asp-for="CompletionDate" type="datetime-local" class="form-control border-start-0 py-2" value="@(Model != null && Model.CompletionDate.HasValue ? Model.CompletionDate.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                                </div>
                                <span asp-validation-for="CompletionDate" class="text-danger fs-7"></span>
                            </div>

                            <!-- Requested By -->
                            <div class="col-md-6">
                                <label asp-for="RequestedBy" class="form-label fw-semibold text-dark">
                                    Requested By (Manager / Operator)
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-person-badge text-secondary"></i>
                                    </span>
                                    <input asp-for="RequestedBy" type="text" class="form-control border-start-0 py-2" placeholder="e.g. Machine Manager" />
                                </div>
                                <span asp-validation-for="RequestedBy" class="text-danger fs-7"></span>
                            </div>

                            <!-- Assigned Technician -->
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold text-dark">
                                    Assigned Technician / Engineer
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-wrench text-primary"></i>
                                    </span>
                                    <input asp-for="AssignedTo" type="text" class="form-control border-start-0 py-2" placeholder="e.g. Maintenance Engineer" />
                                </div>
                                <span asp-validation-for="AssignedTo" class="text-danger fs-7"></span>
                            </div>

                            <!-- Ticket Status -->
                            <div class="col-md-12">
                                <label asp-for="Status" class="form-label fw-semibold text-dark">
                                    Ticket Status
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-shield-check text-success"></i>
                                    </span>
                                    <select asp-for="Status" class="form-select border-start-0 py-2">
                                        <option value="Pending">Pending</option>
                                        <option value="In Progress">In Progress</option>
                                        <option value="On Hold">On Hold</option>
                                        <option value="Completed">Completed</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Status" class="text-danger fs-7"></span>
                            </div>

                            <!-- Problem Description -->
                            <div class="col-12">
                                <label asp-for="ProblemDescription" class="form-label fw-semibold text-dark">
                                    Problem Description <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="ProblemDescription" rows="4" class="form-control py-2" placeholder="Describe the fault, breakdown symptoms, warning codes, or maintenance requirements..."></textarea>
                                <span asp-validation-for="ProblemDescription" class="text-danger fs-7"></span>
                            </div>

                            <!-- Remarks -->
                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold text-dark">
                                    Remarks / Repair Notes
                                </label>
                                <textarea asp-for="Remarks" rows="3" class="form-control py-2" placeholder="Enter spare parts required, technician notes, or repair resolution summary..."></textarea>
                                <span asp-validation-for="Remarks" class="text-danger fs-7"></span>
                            </div>
                        </div>

                        <!-- Form Actions Footer -->
                        <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-warning text-dark rounded-pill px-5 py-2 fw-bold shadow-sm">
                                <i class="bi bi-save-fill me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
