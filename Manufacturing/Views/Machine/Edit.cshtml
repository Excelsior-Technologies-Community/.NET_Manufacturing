@model Manufacturing.Models.Machine

@{
    ViewData["Title"] = "Edit Machine Record";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-9 col-lg-8">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white text-center py-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                <h3 class="fw-bold mb-1"><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Machine Record</h3>
                <p class="mb-0 text-white-50 fs-6">Update machine specifications, operational status, maintenance logs, and allocation details</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="MachineId" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MachineCode" class="form-label fw-semibold">Machine Code <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-barcode"></i></span>
                                <input asp-for="MachineCode" class="form-control form-control-lg" placeholder="e.g. MCH-CNC-001" required />
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="MachineName" class="form-label fw-semibold">Machine Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-cpu"></i></span>
                                <input asp-for="MachineName" class="form-control form-control-lg" placeholder="e.g. High-Precision CNC Router" required />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MachineType" class="form-label fw-semibold">Machine Type</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-tags"></i></span>
                                <select asp-for="MachineType" class="form-select form-select-lg">
                                    <option value="">-- Select Machine Type --</option>
                                    <option value="CNC Machine">CNC Machine</option>
                                    <option value="Lathe Machine">Lathe Machine</option>
                                    <option value="Milling Machine">Milling Machine</option>
                                    <option value="Drilling Machine">Drilling Machine</option>
                                    <option value="Injection Molding">Injection Molding</option>
                                    <option value="Stamping Press">Stamping Press</option>
                                    <option value="Assembly Line">Assembly Line</option>
                                    <option value="Packaging Machine">Packaging Machine</option>
                                    <option value="Inspection & Testing">Inspection & Testing</option>
                                    <option value="Other Heavy Equipment">Other Heavy Equipment</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Manufacturer" class="form-label fw-semibold">Manufacturer / Brand</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-building"></i></span>
                                <input asp-for="Manufacturer" class="form-control form-control-lg" placeholder="e.g. Siemens / Haas Automation" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="PurchaseDate" class="form-label fw-semibold">Purchase Date</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-calendar-check"></i></span>
                                <input asp-for="PurchaseDate" type="date" class="form-control form-control-lg" value="@(Model?.PurchaseDate?.ToString("yyyy-MM-dd"))" />
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="LastMaintenanceDate" class="form-label fw-semibold">Last Maintenance Date</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-tools"></i></span>
                                <input asp-for="LastMaintenanceDate" type="date" class="form-control form-control-lg" value="@(Model?.LastMaintenanceDate?.ToString("yyyy-MM-dd"))" />
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="NextMaintenanceDate" class="form-label fw-semibold">Next Scheduled Maintenance</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="NextMaintenanceDate" type="date" class="form-control form-control-lg" value="@(Model?.NextMaintenanceDate?.ToString("yyyy-MM-dd"))" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">Operational Status</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-activity"></i></span>
                                <select asp-for="Status" class="form-select form-select-lg">
                                    <option value="Available">Available</option>
                                    <option value="In Use">In Use</option>
                                    <option value="Under Maintenance">Under Maintenance</option>
                                    <option value="Breakdown">Breakdown</option>
                                    <option value="Retired">Retired</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="AllocationStatus" class="form-label fw-semibold">Allocation Status</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-shield-check"></i></span>
                                <select asp-for="AllocationStatus" class="form-select form-select-lg">
                                    <option value="Pending">Pending</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Rejected">Rejected</option>
                                    <option value="Unallocated">Unallocated</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="AllocatedTo" class="form-label fw-semibold">Allocated To (Operator / Shift)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="AllocatedTo" class="form-control form-control-lg" placeholder="e.g. Shift-A Operator John Doe" />
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ApprovedBy" class="form-label fw-semibold">Approved By (Supervisor / Admin)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person-check"></i></span>
                                <input asp-for="ApprovedBy" class="form-control form-control-lg" placeholder="e.g. Admin / Supervisor Name" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Remarks" class="form-label fw-semibold">Remarks & Technical Notes</label>
                        <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Add operational instructions, maintenance logs, or special notes..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-3 px-4">
                            <i class="bi bi-arrow-left me-1"></i> Back to Machine List
                        </a>
                        <button type="submit" class="btn btn-warning btn-lg rounded-3 px-5 fw-bold shadow-sm text-dark">
                            <i class="bi bi-check-circle me-1"></i> Update Machine Record
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
