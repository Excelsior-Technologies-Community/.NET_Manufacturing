@{
    ViewData["Title"] = "Allocation Approved";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4 text-center overflow-hidden">
            <div class="card-body p-5">
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center mb-4" style="width: 90px; height: 90px;">
                    <i class="bi bi-check-circle-fill fs-1"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Allocation Approved!</h3>
                <p class="text-muted mb-4 fs-6">The machine allocation request has been successfully approved and updated in the system database.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> Back to Machines List
                    </a>
                    <a asp-controller="Account" asp-action="Dashboard" class="btn btn-outline-dark rounded-pill px-4 py-2">
                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
