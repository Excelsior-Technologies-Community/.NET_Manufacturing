@model List<Manufacturing.Models.Machine>

@{
    ViewData["Title"] = "Machine Management";

    var machines = Model ?? new List<Manufacturing.Models.Machine>();
    int totalCount = machines.Count;
    int availableCount = machines.Count(m => m.Status == "Available" || m.Status == "In Use");
    int maintenanceCount = machines.Count(m => m.Status == "Under Maintenance" || m.Status == "Breakdown");
    int pendingCount = machines.Count(m => m.AllocationStatus == "Pending");

    string getStatusBadge(string status)
    {
        switch (status)
        {
            case "Available": return "bg-success text-white";
            case "In Use": return "bg-primary text-white";
            case "Under Maintenance": return "bg-warning text-dark";
            case "Breakdown": return "bg-danger text-white";
            case "Retired": return "bg-secondary text-white";
            default: return "bg-info text-dark";
        }
    }

    string getAllocationBadge(string allocStatus)
    {
        switch (allocStatus)
        {
            case "Approved": return "bg-success bg-opacity-10 text-success border border-success";
            case "Pending": return "bg-warning bg-opacity-10 text-warning border border-warning";
            case "Rejected": return "bg-danger bg-opacity-10 text-danger border border-danger";
            case "Unallocated": return "bg-secondary bg-opacity-10 text-secondary border border-secondary";
            default: return "bg-light text-dark border";
        }
    }
}

<div class="container-fluid px-3 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-cpu-fill text-info me-2"></i>Machine Management & Allocation</h2>
            <p class="text-slate-300 mb-0 opacity-75">Admin Operations: Track machinery, schedule maintenance, and approve allocation requests</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-semibold">
                <i class="bi bi-plus-circle-fill me-1"></i> Add New Machine
            </a>
            <a asp-controller="Account" asp-action="Dashboard" class="btn btn-outline-light rounded-pill px-3 py-2 ms-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Total Machines</div>
                            <h3 class="fw-bold mb-0 text-primary" id="kpiTotal">@totalCount</h3>
                        </div>
                        <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3">
                            <i class="bi bi-cpu fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Active / Available</div>
                            <h3 class="fw-bold mb-0 text-success" id="kpiActive">@availableCount</h3>
                        </div>
                        <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                            <i class="bi bi-check-circle-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Maintenance / Repair</div>
                            <h3 class="fw-bold mb-0 text-warning" id="kpiMaintenance">@maintenanceCount</h3>
                        </div>
                        <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3">
                            <i class="bi bi-tools fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-danger">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-semibold fs-7 mb-1">Pending Allocations</div>
                            <h3 class="fw-bold mb-0 text-danger" id="kpiPending">@pendingCount</h3>
                        </div>
                        <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-3">
                            <i class="bi bi-hourglass-split fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-gear-wide-connected me-2 text-primary"></i>Equipment & Machinery Directory</h5>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 rounded-pill fw-semibold" id="tableBadgeCount">
                    Total Listed: @totalCount
                </span>
            </div>
            <div class="input-group" style="max-width: 320px;">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="machineSearchInput" class="form-control bg-light border-start-0 ps-0" placeholder="Search machine by name, code, type..." />
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="machineTable">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4"># ID</th>
                            <th>Code & Name</th>
                            <th>Type / Mfr</th>
                            <th>Maintenance Dates</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Allocation</th>
                            <th>Allocated To</th>
                            <th>Approved By</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="machineTableBody">
                        @if (machines.Count > 0)
                        {
                            @foreach (var m in machines)
                            {
                                <tr class="machine-row">
                                    <td class="ps-4 fw-bold text-muted">#@m.MachineId</td>
                                    <td>
                                        <div class="fw-bold text-dark fs-6 machine-name">@m.MachineName</div>
                                        <small class="text-primary fw-semibold machine-code"><i class="bi bi-barcode me-1"></i>@m.MachineCode</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark machine-type">@(string.IsNullOrEmpty(m.MachineType) ? "Standard" : m.MachineType)</div>
                                        <small class="text-muted">@(string.IsNullOrEmpty(m.Manufacturer) ? "N/A" : m.Manufacturer)</small>
                                    </td>
                                    <td>
                                        <small class="d-block text-muted">
                                            <i class="bi bi-calendar-check me-1 text-success"></i>Last: @(m.LastMaintenanceDate.HasValue ? m.LastMaintenanceDate.Value.ToString("dd MMM yyyy") : "N/A")
                                        </small>
                                        <small class="d-block text-muted">
                                            <i class="bi bi-calendar-event me-1 text-warning"></i>Next: @(m.NextMaintenanceDate.HasValue ? m.NextMaintenanceDate.Value.ToString("dd MMM yyyy") : "N/A")
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @getStatusBadge(m.Status) rounded-pill px-3 py-1 fw-medium machine-status">
                                            @m.Status
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @getAllocationBadge(m.AllocationStatus) rounded-pill px-3 py-1 fw-medium machine-alloc">
                                            @m.AllocationStatus
                                        </span>
                                    </td>
                                    <td class="fw-medium text-dark">
                                        @(string.IsNullOrEmpty(m.AllocatedTo) ? "-" : m.AllocatedTo)
                                    </td>
                                    <td class="fw-medium text-dark">
                                        @(string.IsNullOrEmpty(m.ApprovedBy) ? "-" : m.ApprovedBy)
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@m.MachineId" class="btn btn-outline-primary" title="Edit Machine">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            @if (m.AllocationStatus != "Approved")
                                            {
                                                <a asp-action="ApproveAllocation" asp-route-id="@m.MachineId" class="btn btn-outline-success" title="Approve Allocation">
                                                    <i class="bi bi-check-circle-fill"></i> Approve
                                                </a>
                                            }
                                            <a asp-action="Delete" asp-route-id="@m.MachineId" class="btn btn-outline-danger" title="Delete Machine" onclick="return confirm('Are you sure you want to delete machine @m.MachineName (@m.MachineCode)?');">
                                                <i class="bi bi-trash-fill"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="noRecordsRow">
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-cpu fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    <h5>No Machines Found</h5>
                                    <p class="mb-3">Start by registering your first industrial machine or equipment.</p>
                                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
                                        <i class="bi bi-plus-circle-fill me-1"></i> Add New Machine
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('machineSearchInput');
            const tableRows = document.querySelectorAll('.machine-row');

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const query = this.value.toLowerCase().trim();
                    tableRows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        if (text.includes(query)) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            }
        });
    </script>
}
