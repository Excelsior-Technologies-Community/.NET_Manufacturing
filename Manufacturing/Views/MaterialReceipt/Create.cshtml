@model Manufacturing.Models.MaterialReceipt

@{
    ViewData["Title"] = "Log Material Receipt (GRN) - Inventory Manager";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">
            <!-- Navigation Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-warning text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Inventory Manager Portal</span>
                        <span class="badge bg-emerald text-white px-3 py-1 rounded-pill fs-7" style="background-color: #10b981;">New Shipment</span>
                    </div>
                    <h3 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-plus-circle-fill text-success me-2"></i> Log Material Receipt (GRN)
                    </h3>
                    <p class="text-muted mb-0 small">Log inbound raw material shipment details into the manufacturing inventory database.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Back to Roster
                </a>
            </div>

            <!-- Form Card -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="card-header text-white p-4" style="background: linear-gradient(135deg, #064e3b 0%, #047857 100%);">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h5 class="fw-bold mb-1"><i class="bi bi-box-seam me-2 text-warning"></i> Goods Receipt Note Specification</h5>
                            <p class="mb-0 opacity-85 small">Please fill out all receipt attributes accurately for audit compliance.</p>
                        </div>
                        <i class="bi bi-receipt-cutoff fs-1 opacity-50"></i>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post" id="createReceiptForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>

                        <!-- Hidden Required Model Fields to Ensure ModelState.IsValid Passes -->
                        <input type="hidden" asp-for="ReceiptNumber" id="ReceiptNumber" value="@(string.IsNullOrEmpty(Model?.ReceiptNumber) ? ("GRN-" + DateTime.Now.ToString("yyyyMMddHHmmss")) : Model.ReceiptNumber)" />
                        <input type="hidden" asp-for="ReceiptDate" id="ReceiptDate" value="@(Model?.ReceiptDate != DateTime.MinValue ? Model?.ReceiptDate.ToString("yyyy-MM-ddTHH:mm:ss") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss"))" />

                        <div class="row g-3">
                            <!-- Raw Material Selection -->
                            <div class="col-12 col-md-6">
                                <label asp-for="MaterialId" class="form-label fw-semibold text-dark">Select Raw Material <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-boxes"></i></span>
                                    <select asp-for="MaterialId" asp-items="@ViewBag.MaterialList" class="form-select border-start-0 py-2 rounded-end-3" id="materialSelect">
                                        <option value="">-- Choose Raw Material --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="MaterialId" class="text-danger small"></span>
                            </div>

                            <!-- Supplier Name -->
                            <div class="col-12 col-md-6">
                                <label asp-for="SupplierName" class="form-label fw-semibold text-dark">Supplier Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-truck"></i></span>
                                    <input asp-for="SupplierName" class="form-control border-start-0 py-2 rounded-end-3" placeholder="e.g. Apex Alloy & Steel Supplies" />
                                </div>
                                <span asp-validation-for="SupplierName" class="text-danger small"></span>
                            </div>

                            <!-- Reference / PO Number -->
                            <div class="col-12 col-md-6">
                                <label asp-for="ReferenceNo" class="form-label fw-semibold text-dark">Reference / PO / Invoice No</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-file-earmark-code"></i></span>
                                    <input asp-for="ReferenceNo" class="form-control border-start-0 py-2 rounded-end-3" placeholder="e.g. REF-88902 / PO-4401" />
                                </div>
                                <span asp-validation-for="ReferenceNo" class="text-danger small"></span>
                            </div>

                            <!-- Received Quantity -->
                            <div class="col-12 col-md-6">
                                <label asp-for="ReceivedQuantity" class="form-label fw-semibold text-dark">Received Quantity <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-123"></i></span>
                                    <input asp-for="ReceivedQuantity" type="number" min="1" class="form-control border-start-0 py-2 rounded-end-3" placeholder="Enter received quantity" id="receivedQtyInput" />
                                </div>
                                <span asp-validation-for="ReceivedQuantity" class="text-danger small"></span>
                            </div>

                            <!-- Receive Date -->
                            <div class="col-12 col-md-6">
                                <label asp-for="ReceiveDate" class="form-label fw-semibold text-dark">Receive Date <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-calendar-check"></i></span>
                                    <input asp-for="ReceiveDate" id="ReceiveDate" type="date" class="form-control border-start-0 py-2 rounded-end-3" value="@(Model?.ReceiveDate != DateTime.MinValue ? Model?.ReceiveDate.ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd"))" onchange="syncCreateDates(this.value)" />
                                </div>
                                <span asp-validation-for="ReceiveDate" class="text-danger small"></span>
                            </div>

                            <!-- Received By (Inventory Manager) -->
                            <div class="col-12 col-md-6">
                                <label asp-for="ReceivedBy" class="form-label fw-semibold text-dark">Received By (Officer/Manager)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person-badge"></i></span>
                                    <input asp-for="ReceivedBy" class="form-control border-start-0 py-2 rounded-end-3" value="@(string.IsNullOrEmpty(Model?.ReceivedBy) ? "Robert Chen (Inventory Manager)" : Model.ReceivedBy)" />
                                </div>
                                <span asp-validation-for="ReceivedBy" class="text-danger small"></span>
                            </div>

                            <!-- Status -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold text-dark">Receipt Status</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-shield-check"></i></span>
                                    <select asp-for="Status" class="form-select border-start-0 py-2 rounded-end-3">
                                        <option value="Received" selected>Received</option>
                                        <option value="Verified">Verified & Stock Added</option>
                                        <option value="Pending">Pending Inspection</option>
                                        <option value="Rejected">Rejected</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <!-- Remarks -->
                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold text-dark">Inspection Remarks & Notes</label>
                                <textarea asp-for="Remarks" class="form-control rounded-3" rows="3" placeholder="Enter physical inspection notes, batch numbers, storage location..."></textarea>
                                <span asp-validation-for="Remarks" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Live Summary Widget -->
                        <div class="p-3 bg-light rounded-4 border mt-4 border-start border-4 border-success">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-info-circle-fill text-success fs-5"></i>
                                    <span class="fw-semibold text-dark">Inventory Stock Impact:</span>
                                </div>
                                <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-1 rounded-pill">Inbound GRN Logging</span>
                            </div>
                            <small class="text-muted d-block mt-1">
                                Upon saving, this Material Receipt will be logged into the inventory database under Inventory Manager supervision.
                            </small>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4 py-2 text-secondary fw-semibold border">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-success rounded-pill px-5 py-2 fw-bold shadow">
                                <i class="bi bi-check-circle-fill me-1"></i> Save Material Receipt (GRN)
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function syncCreateDates(dateVal) {
            if (dateVal) {
                document.getElementById('ReceiptDate').value = dateVal + 'T00:00:00';
            }
        }
    </script>
}
