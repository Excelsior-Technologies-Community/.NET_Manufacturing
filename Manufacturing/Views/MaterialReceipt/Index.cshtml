@model List<Manufacturing.Models.MaterialReceipt>

@{
    ViewData["Title"] = "Material Receipts (GRN) - Inventory Manager Portal";

    var receipts = Model ?? new List<Manufacturing.Models.MaterialReceipt>();

    int totalReceipts = receipts.Count;
    long totalQty = receipts.Sum(r => (long)r.ReceivedQuantity);
    int verifiedCount = receipts.Count(r => string.Equals(r.Status, "Verified", StringComparison.OrdinalIgnoreCase) || string.Equals(r.Status, "Passed", StringComparison.OrdinalIgnoreCase));
    int pendingCount = receipts.Count(r => string.Equals(r.Status, "Pending", StringComparison.OrdinalIgnoreCase) || string.Equals(r.Status, "Received", StringComparison.OrdinalIgnoreCase));
    int rejectedCount = receipts.Count(r => string.Equals(r.Status, "Rejected", StringComparison.OrdinalIgnoreCase));

    string getStatusBadgeClass(string? status)
    {
        switch (status?.Trim().ToLower())
        {
            case "verified":
            case "passed":
            case "approved":
                return "bg-success text-white";
            case "pending":
            case "received":
            case "under review":
                return "bg-warning text-dark";
            case "rejected":
            case "failed":
                return "bg-danger text-white";
            default:
                return "bg-info text-white";
        }
    }
}

<div class="container-fluid px-4 py-4">
    <!-- TempData Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Top Navigation Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow text-white" style="background: linear-gradient(135deg, #064e3b 0%, #047857 50%, #059669 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Inventory Manager Portal</span>
                <span class="badge bg-white bg-opacity-25 text-white px-3 py-1 rounded-pill fs-7">Goods Receipt Note (GRN)</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-box-arrow-in-down text-warning me-2 fs-2"></i> Material Receipt Management
            </h2>
            <p class="text-emerald-100 mb-0 opacity-85">
                Inventory Manager Control Hub: Log inbound raw material deliveries, perform stock verifications, and audit Goods Receipt Notes (GRN).
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="MaterialReceipt" asp-action="Create" class="btn btn-light rounded-pill px-4 py-2 shadow-sm fw-semibold text-emerald-900">
                <i class="bi bi-plus-circle-fill me-1 text-success"></i> Log Material Receipt
            </a>
            <button type="button" onclick="exportReceiptsCSV()" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
            </button>
            <a asp-controller="Account" asp-action="Dashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Inventory Manager KPI Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Inbound Receipts</div>
                        <div class="fs-3 fw-bold text-success mb-0" id="statTotalReceipts">@totalReceipts</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-receipt fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Inbound Quantity</div>
                        <div class="fs-3 fw-bold text-primary mb-0" id="statTotalQty">@totalQty.ToString("N0")</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-boxes fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Verified / Approved</div>
                        <div class="fs-3 fw-bold text-warning mb-0" id="statVerified">@verifiedCount</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-check2-square fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Pending Review</div>
                        <div class="fs-3 fw-bold text-info mb-0" id="statPending">@pendingCount</div>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Inventory Manager Control Panel & Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <!-- Filter & Search Bar Header -->
        <div class="card-header bg-white border-bottom py-3 px-4">
            <div class="row g-3 align-items-center justify-content-between">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="receiptSearchInput" class="form-control bg-light border-start-0 rounded-end-pill py-2" placeholder="Search by Material, Supplier, Ref No, Receiver..." onkeyup="filterReceipts()">
                    </div>
                </div>
                <div class="col-12 col-md-7 d-flex flex-wrap align-items-center justify-content-md-end gap-2">
                    <div class="btn-group rounded-pill p-1 bg-light border" role="group" id="statusFilterGroup">
                        <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 active" onclick="filterByStatus('all', this)">All (@totalReceipts)</button>
                        <button type="button" class="btn btn-sm btn-light rounded-pill px-3" onclick="filterByStatus('Verified', this)">Verified (@verifiedCount)</button>
                        <button type="button" class="btn btn-sm btn-light rounded-pill px-3" onclick="filterByStatus('Pending', this)">Pending (@pendingCount)</button>
                        <button type="button" class="btn btn-sm btn-light rounded-pill px-3" onclick="filterByStatus('Rejected', this)">Rejected (@rejectedCount)</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inbound Material Receipt Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="receiptsTable">
                <thead class="table-dark text-white text-uppercase fs-7">
                    <tr>
                        <th class="ps-4 py-3">Receipt ID</th>
                        <th class="py-3">Material Name</th>
                        <th class="py-3">Supplier Name</th>
                        <th class="py-3">Ref / PO Number</th>
                        <th class="py-3 text-center">Received Qty</th>
                        <th class="py-3">Receive Date</th>
                        <th class="py-3">Received By</th>
                        <th class="py-3 text-center">Status</th>
                        <th class="pe-4 py-3 text-end">Inventory Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (receipts != null && receipts.Any())
                    {
                        foreach (var item in receipts)
                        {
                            <tr class="receipt-row" 
                                data-status="@(item.Status ?? "Pending")" 
                                data-search="@(item.ReceiptId) @(item.MaterialName) @(item.SupplierName) @(item.ReferenceNo) @(item.ReceivedBy)">
                                <td class="ps-4 fw-bold text-success">
                                    <i class="bi bi-hash text-muted"></i>@item.ReceiptId
                                </td>
                                <td>
                                    <div class="fw-bold text-dark fs-6">@(string.IsNullOrEmpty(item.MaterialName) ? "Raw Material #" + item.MaterialId : item.MaterialName)</div>
                                    <small class="text-muted">Material ID: @item.MaterialId</small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-secondary">
                                        <i class="bi bi-truck me-1 text-primary"></i>@(string.IsNullOrEmpty(item.SupplierName) ? "Standard Supplier" : item.SupplierName)
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">
                                        @(string.IsNullOrEmpty(item.ReferenceNo) ? "N/A" : item.ReferenceNo)
                                    </span>
                                </td>
                                <td class="text-center fw-bold fs-6 text-emerald-700">
                                    @item.ReceivedQuantity.ToString("N0")
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark">
                                        <i class="bi bi-calendar3 me-1 text-muted"></i>@item.ReceiveDate.ToString("yyyy-MM-dd")
                                    </div>
                                </td>
                                <td>
                                    <div class="small fw-medium text-dark">
                                        <i class="bi bi-person-circle me-1 text-success"></i>@(string.IsNullOrEmpty(item.ReceivedBy) ? "Inventory Manager" : item.ReceivedBy)
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill px-3 py-2 fw-semibold @getStatusBadgeClass(item.Status)">
                                        @(string.IsNullOrEmpty(item.Status) ? "Received" : item.Status)
                                    </span>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.ReceiptId" class="btn btn-sm btn-outline-info rounded-start-pill" title="View GRN Voucher">
                                            <i class="bi bi-eye-fill me-1"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.ReceiptId" class="btn btn-sm btn-outline-warning" title="Edit Receipt Record">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ReceiptId" class="btn btn-sm btn-outline-danger rounded-end-pill" title="Delete Receipt" onclick="return confirm('Are you sure you want to delete Material Receipt #@item.ReceiptId?');">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3 opacity-50"></i>
                                <h5>No Material Receipts Logged Yet</h5>
                                <p class="mb-3">Click below to record the first inbound raw material delivery.</p>
                                <a asp-action="Create" class="btn btn-success rounded-pill px-4 py-2">
                                    <i class="bi bi-plus-circle-fill me-2"></i> Log New Material Receipt
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer Audit Summary -->
        <div class="card-footer bg-light border-top py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center small text-muted">
            <div>
                <i class="bi bi-shield-check text-success me-1"></i> Inventory Manager Control Panel | Goods Receipt Note (GRN) Management
            </div>
            <div>
                Total Logged Volume: <strong class="text-dark">@totalQty.ToString("N0") Units</strong>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterReceipts() {
            var input = document.getElementById('receiptSearchInput').value.toLowerCase();
            var rows = document.querySelectorAll('.receipt-row');
            
            rows.forEach(function(row) {
                var searchText = row.getAttribute('data-search').toLowerCase();
                if (searchText.indexOf(input) > -1) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function filterByStatus(status, btn) {
            // Highlight button
            var buttons = document.querySelectorAll('#statusFilterGroup button');
            buttons.forEach(b => {
                b.classList.remove('btn-dark', 'active');
                b.classList.add('btn-light');
            });
            btn.classList.remove('btn-light');
            btn.classList.add('btn-dark', 'active');

            var rows = document.querySelectorAll('.receipt-row');
            rows.forEach(function(row) {
                var rowStatus = row.getAttribute('data-status').toLowerCase();
                if (status === 'all' || rowStatus.indexOf(status.toLowerCase()) > -1) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function exportReceiptsCSV() {
            var table = document.getElementById('receiptsTable');
            var rows = table.querySelectorAll('tr');
            var csv = [];
            
            for (var i = 0; i < rows.length; i++) {
                var row = [], cols = rows[i].querySelectorAll('td, th');
                for (var j = 0; j < cols.length - 1; j++) {
                    var text = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/^\s+|\s+$/g, '');
                    text = '"' + text.replace(/"/g, '""') + '"';
                    row.push(text);
                }
                csv.push(row.join(','));
            }

            var csvFile = new Blob([csv.join('\n')], { type: 'text/csv' });
            var downloadLink = document.createElement('a');
            downloadLink.download = 'Material_Receipts_GRN_Report.csv';
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = 'none';
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}
