@model Manufacturing.Models.RawMaterial

@{
    ViewData["Title"] = "Edit Raw Material - Admin Portal";

    string getApprovalBadgeClass(string status)
    {
        switch (status?.Trim())
        {
            case "Approved": return "bg-success text-white";
            case "Pending": return "bg-warning bg-opacity-10 text-warning border border-warning";
            case "Rejected": return "bg-danger bg-opacity-10 text-danger border border-danger";
            default: return "bg-secondary bg-opacity-10 text-secondary border border-secondary";
        }
    }
}

<div class="container-fluid px-3 py-3">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="text-warning text-decoration-none fw-semibold"><i class="bi bi-arrow-left me-1"></i> Back to Raw Materials</a>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-pencil-square text-primary me-2 fs-2"></i> Update Raw Material Details
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Modify material specifications, stock levels, pricing, or approval status for ID #@Model.MaterialId</p>
        </div>
        <div class="mt-3 mt-md-0">
            <span class="badge @getApprovalBadgeClass(Model.ApprovalStatus) rounded-pill px-3 py-2 fs-6">
                Status: @(string.IsNullOrEmpty(Model.ApprovalStatus) ? "Pending" : Model.ApprovalStatus)
            </span>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-sliders text-primary me-2"></i> Edit Record: @Model.MaterialCode - @Model.MaterialName
                    </h5>
                    <code>Material ID: @Model.MaterialId</code>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="MaterialId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="MaterialCode" class="form-label fw-semibold text-dark">Material Code <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-qr-code text-primary"></i></span>
                                    <input asp-for="MaterialCode" class="form-control" placeholder="e.g. RM-STEEL-101" required />
                                </div>
                                <span asp-validation-for="MaterialCode" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MaterialName" class="form-label fw-semibold text-dark">Material Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-box text-primary"></i></span>
                                    <input asp-for="MaterialName" class="form-control" placeholder="e.g. Stainless Steel Sheet 2mm" required />
                                </div>
                                <span asp-validation-for="MaterialName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label fw-semibold text-dark">Category</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-tags text-primary"></i></span>
                                    <select asp-for="Category" class="form-select">
                                        <option value="">Select Category</option>
                                        <option value="Metals & Alloys">Metals & Alloys</option>
                                        <option value="Polymers & Plastics">Polymers & Plastics</option>
                                        <option value="Chemicals & Solvents">Chemicals & Solvents</option>
                                        <option value="Electrical & Wiring">Electrical & Wiring</option>
                                        <option value="Packaging Materials">Packaging Materials</option>
                                        <option value="Fasteners & Hardware">Fasteners & Hardware</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Unit" class="form-label fw-semibold text-dark">Measurement Unit</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-rulers text-primary"></i></span>
                                    <select asp-for="Unit" class="form-select">
                                        <option value="">Select Unit</option>
                                        <option value="Kg">Kg (Kilograms)</option>
                                        <option value="Liters">Liters</option>
                                        <option value="Meters">Meters</option>
                                        <option value="Pieces">Pieces</option>
                                        <option value="Tons">Tons</option>
                                        <option value="Boxes">Boxes</option>
                                        <option value="Rolls">Rolls</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Unit" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="CurrentStock" class="form-label fw-semibold text-dark">Current Stock Quantity</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-stack text-primary"></i></span>
                                    <input asp-for="CurrentStock" type="number" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="CurrentStock" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="MinimumStock" class="form-label fw-semibold text-dark">Minimum Threshold Stock</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-exclamation-triangle text-danger"></i></span>
                                    <input asp-for="MinimumStock" type="number" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="MinimumStock" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="PurchasePrice" class="form-label fw-semibold text-dark">Purchase Price (Per Unit)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-currency-rupee text-success"></i></span>
                                    <input asp-for="PurchasePrice" type="number" step="0.01" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                            </div>

                            <!-- Supplier Name -->
                            <div class="col-md-6">
                                <label asp-for="SupplierName" class="form-label fw-semibold text-dark">Supplier Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-building text-primary"></i></span>
                                    <input asp-for="SupplierName" class="form-control" />
                                </div>
                                <span asp-validation-for="SupplierName" class="text-danger small"></span>
                            </div>

                            <!-- Purchase Date -->
                            <div class="col-md-6">
                                <label asp-for="PurchaseDate" class="form-label fw-semibold text-dark">Purchase Date</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-calendar-event text-primary"></i></span>
                                    <input asp-for="PurchaseDate" type="date" value="@(Model.PurchaseDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                                </div>
                                <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
                            </div>

                            <!-- Issue Quantity -->
                            <div class="col-md-4">
                                <label asp-for="IssueQuantity" class="form-label fw-semibold text-dark">Issued Quantity</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-box-arrow-up-right text-primary"></i></span>
                                    <input asp-for="IssueQuantity" type="number" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="IssueQuantity" class="text-danger small"></span>
                            </div>

                            <!-- Approved By -->
                            <div class="col-md-4">
                                <label asp-for="ApprovedBy" class="form-label fw-semibold text-dark">Approved By</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person-check text-primary"></i></span>
                                    <input asp-for="ApprovedBy" class="form-control" />
                                </div>
                                <span asp-validation-for="ApprovedBy" class="text-danger small"></span>
                            </div>

                            <!-- Approval Status -->
                            <div class="col-md-4">
                                <label asp-for="ApprovalStatus" class="form-label fw-semibold text-dark">Approval Status</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-shield-check text-primary"></i></span>
                                    <select asp-for="ApprovalStatus" class="form-select">
                                        <option value="Pending">Pending</option>
                                        <option value="Approved">Approved</option>
                                        <option value="Rejected">Rejected</option>
                                    </select>
                                </div>
                                <span asp-validation-for="ApprovalStatus" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold text-dark">Remarks / Storage Location Notes</label>
                                <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Remarks" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-action="Apporve" asp-route-id="@Model.MaterialId" class="btn btn-outline-success rounded-pill px-4 @(Model.ApprovalStatus == "Approved" ? "disabled" : "")">
                                <i class="bi bi-check-circle-fill me-1"></i> Quick Approve Material
                            </a>
                            <div class="d-flex gap-2">
                                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                    <i class="bi bi-x-circle me-1"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm fw-semibold">
                                    <i class="bi bi-save me-1"></i> Save Changes
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
