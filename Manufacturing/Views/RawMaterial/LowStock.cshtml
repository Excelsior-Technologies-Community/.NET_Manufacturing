@model List<Manufacturing.Models.RawMaterial>

@{
    ViewData["Title"] = "Low Stock Alerts - Raw Material Inventory";

    int lowStockCount = Model != null ? Model.Count : 0;
}

<div class="container-fluid px-3 py-3">
    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 50%, #b91c1c 100%);">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="text-warning text-decoration-none fw-semibold"><i class="bi bi-arrow-left me-1"></i> Back to Raw Materials List</a>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill text-warning me-2 fs-2"></i> Low Stock Critical Alerts
            </h2>
            <p class="text-slate-200 mb-0 opacity-75">Raw materials currently at or below minimum threshold capacity requiring immediate replenishment</p>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-warning text-dark rounded-pill px-4 py-2 shadow-sm fw-bold">
                <i class="bi bi-plus-circle-fill me-1"></i> Add Material
            </a>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-boxes me-1"></i> View All Materials
            </a>
        </div>
    </div>

    <!-- Alert Banner -->
    @if (lowStockCount > 0)
    {
        <div class="alert alert-danger rounded-4 shadow-sm border-0 d-flex align-items-center p-3 mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill fs-2 text-danger me-3"></i>
            <div>
                <h5 class="fw-bold mb-0 text-danger">Inventory Warning: @lowStockCount Item(s) Require Reordering</h5>
                <small class="text-dark opacity-75">Stock level has fallen below the safety threshold. Contact suppliers to raise purchase requisitions.</small>
            </div>
        </div>
    }

    <!-- Low Stock Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
            <h5 class="fw-bold mb-0 text-danger">
                <i class="bi bi-exclamation-diamond text-danger me-2"></i> Low Stock Requisition List
            </h5>
            <span class="badge bg-danger text-white rounded-pill px-3 py-2">@lowStockCount Critical Alerts</span>
        </div>
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <div class="display-1 text-success opacity-50 mb-3"><i class="bi bi-shield-check"></i></div>
                    <h4 class="fw-bold text-success mb-2">All Inventory Thresholds Healthy!</h4>
                    <p class="text-muted mb-4">No raw materials are currently under low stock minimum levels.</p>
                    <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 py-2">
                        <i class="bi bi-arrow-left me-1"></i> Return to Master List
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-4">Code</th>
                                <th>Material Name & Category</th>
                                <th>Unit</th>
                                <th class="text-end text-warning">Current Stock</th>
                                <th class="text-end">Min Stock</th>
                                <th class="text-end text-danger">Stock Deficit</th>
                                <th>Supplier</th>
                                <th>Purchase Price</th>
                                <th class="text-center pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                int deficit = item.MinimumStock - item.CurrentStock;
                                <tr class="table-danger bg-danger bg-opacity-10">
                                    <td class="ps-4 fw-bold text-dark">
                                        <code>@item.MaterialCode</code>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.MaterialName</div>
                                        <small class="badge bg-danger bg-opacity-10 text-danger rounded-pill">@(string.IsNullOrEmpty(item.Category) ? "General" : item.Category)</small>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(item.Unit) ? "N/A" : item.Unit)</span></td>
                                    <td class="text-end fw-bold fs-5 text-danger">
                                        @item.CurrentStock <i class="bi bi-arrow-down-right-circle-fill text-danger ms-1"></i>
                                    </td>
                                    <td class="text-end text-muted fw-semibold">@item.MinimumStock</td>
                                    <td class="text-end fw-bold text-danger">
                                        +@(deficit < 0 ? 0 : deficit) @item.Unit
                                    </td>
                                    <td>@(string.IsNullOrEmpty(item.SupplierName) ? "-" : item.SupplierName)</td>
                                    <td class="text-end fw-semibold text-success">₹@item.PurchasePrice.ToString("N2")</td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm rounded-pill overflow-hidden" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.MaterialId" class="btn btn-outline-primary px-3">
                                                <i class="bi bi-pencil-square"></i> Restock / Edit
                                            </a>
                                            @if (item.ApprovalStatus != "Approved")
                                            {
                                                <a asp-action="Apporve" asp-route-id="@item.MaterialId" class="btn btn-outline-success px-3">
                                                    <i class="bi bi-check-circle-fill"></i> Approve
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
