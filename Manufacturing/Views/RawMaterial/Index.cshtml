@model List<Manufacturing.Models.RawMaterial>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Raw Material Inventory - Admin Portal";

    var sessionRole = HttpContextAccessor.HttpContext?.Session.GetString("Role") ?? "Admin";

    string getApprovalBadgeClass(string status)
    {
        switch (status?.Trim())
        {
            case "Approved": return "bg-success text-white";
            case "Pending": return "bg-warning bg-opacity-10 text-warning border border-warning";
            case "Rejected": return "bg-danger bg-opacity-10 text-danger border border-danger";
            default: return "bg-secondary bg-opacity-10 text-secondary border border-secondary";
        }
    }

    int totalMaterials = Model != null ? Model.Count : 0;
    int lowStockCount = Model != null ? Model.Count(m => m.CurrentStock <= m.MinimumStock) : 0;
    int pendingCount = Model != null ? Model.Count(m => m.ApprovalStatus == "Pending" || string.IsNullOrEmpty(m.ApprovalStatus)) : 0;
    decimal totalValue = Model != null ? Model.Sum(m => m.CurrentStock * m.PurchasePrice) : 0;
}

<div class="container-fluid px-3 py-3">
    <!-- TempData Success Alert -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Admin Inventory</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Raw Materials</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-boxes text-warning me-2 fs-2"></i> Raw Material Inventory Management
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Track raw material stock, supplier pricing, approval statuses, and low stock thresholds</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-success rounded-pill px-4 py-2 shadow-sm fw-semibold">
                <i class="bi bi-plus-circle-fill me-1"></i> Add Raw Material
            </a>
            <a asp-action="LowStock" class="btn btn-outline-danger rounded-pill px-3 py-2 text-white">
                <i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i> Low Stock Alerts (@lowStockCount)
            </a>
            <a asp-controller="Account" asp-action="Dashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Inventory KPI Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Items</div>
                        <div class="fs-3 fw-bold text-dark mb-0">@totalMaterials</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Low Stock Alert</div>
                        <div class="fs-3 fw-bold text-danger mb-0">@lowStockCount</div>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-exclamation-diamond-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Pending Approval</div>
                        <div class="fs-3 fw-bold text-warning mb-0">@pendingCount</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Inventory Value</div>
                        <div class="fs-4 fw-bold text-success mb-0">₹@totalValue.ToString("N2")</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-currency-rupee fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Inventory Filter & Search Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 rounded-start-pill"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="searchInput" class="form-control bg-light border-start-0 rounded-end-pill" placeholder="Search by material code, name, category, supplier...">
                    </div>
                </div>
                <div class="col-md-4">
                    <select id="statusFilter" class="form-select bg-light rounded-pill">
                        <option value="">All Approval Statuses</option>
                        <option value="Approved">Approved</option>
                        <option value="Pending">Pending</option>
                    </select>
                </div>
                <div class="col-md-3 text-md-end">
                    <button type="button" id="resetFilter" class="btn btn-outline-secondary rounded-pill w-100">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Materials Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-list-columns-reverse text-warning me-2"></i> Raw Material Stock Master
            </h5>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">Total: @totalMaterials Items</span>
        </div>
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <div class="display-1 text-muted opacity-25 mb-3"><i class="bi bi-inbox"></i></div>
                    <h4 class="fw-bold text-secondary mb-2">No Raw Materials Found</h4>
                    <p class="text-muted mb-4">Click below to record a new raw material in the system.</p>
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2">
                        <i class="bi bi-plus-lg me-1"></i> Add First Raw Material
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="materialsTable">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-4">Code</th>
                                <th>Material Name & Category</th>
                                <th>Unit</th>
                                <th class="text-end">Current Stock</th>
                                <th class="text-end">Min Stock</th>
                                <th class="text-end">Purchase Price</th>
                                <th>Supplier</th>
                                <th>Approval Status</th>
                                <th class="text-center pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                bool isLowStock = item.CurrentStock <= item.MinimumStock;
                                <tr class="@(isLowStock ? "table-danger bg-danger bg-opacity-10" : "")">
                                    <td class="ps-4 fw-bold text-dark">
                                        <code>@item.MaterialCode</code>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.MaterialName</div>
                                        <small class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill">@(string.IsNullOrEmpty(item.Category) ? "General" : item.Category)</small>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(item.Unit) ? "N/A" : item.Unit)</span></td>
                                    <td class="text-end fw-bold fs-6 @(isLowStock ? "text-danger" : "text-dark")">
                                        @item.CurrentStock
                                        @if (isLowStock)
                                        {
                                            <i class="bi bi-exclamation-circle-fill text-danger ms-1" title="Low Stock Warning"></i>
                                        }
                                    </td>
                                    <td class="text-end text-muted">@item.MinimumStock</td>
                                    <td class="text-end fw-semibold text-success">₹@item.PurchasePrice.ToString("N2")</td>
                                    <td>@(string.IsNullOrEmpty(item.SupplierName) ? "-" : item.SupplierName)</td>
                                    <td>
                                        <span class="badge @getApprovalBadgeClass(item.ApprovalStatus) rounded-pill px-3 py-1 fs-7">
                                            @(string.IsNullOrEmpty(item.ApprovalStatus) ? "Pending" : item.ApprovalStatus)
                                        </span>
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm rounded-pill overflow-hidden" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.MaterialId" class="btn btn-outline-primary px-3" title="Edit Raw Material">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>

                                            @if (item.ApprovalStatus != "Approved")
                                            {
                                                <a asp-action="Apporve" asp-route-id="@item.MaterialId" class="btn btn-outline-success px-3" title="Approve Material">
                                                    <i class="bi bi-check-circle-fill"></i> Approve
                                                </a>
                                            }

                                            <a asp-action="Delete" asp-route-id="@item.MaterialId" class="btn btn-outline-danger px-3" onclick="return confirm('Are you sure you want to delete material @item.MaterialCode - @item.MaterialName?');" title="Delete Material">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const statusFilter = document.getElementById('statusFilter');
            const resetFilter = document.getElementById('resetFilter');
            const tableRows = document.querySelectorAll('#materialsTable tbody tr');

            function filterTable() {
                const searchVal = searchInput ? searchInput.value.toLowerCase().trim() : '';
                const statusVal = statusFilter ? statusFilter.value.toLowerCase().trim() : '';

                tableRows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    const statusText = row.children[7] ? row.children[7].innerText.toLowerCase() : '';

                    const matchesSearch = !searchVal || text.includes(searchVal);
                    const matchesStatus = !statusVal || statusText.includes(statusVal);

                    if (matchesSearch && matchesStatus) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            if (searchInput) searchInput.addEventListener('input', filterTable);
            if (statusFilter) statusFilter.addEventListener('change', filterTable);
            if (resetFilter) {
                resetFilter.addEventListener('click', function () {
                    if (searchInput) searchInput.value = '';
                    if (statusFilter) statusFilter.value = '';
                    filterTable();
                });
            }
        });
    </script>
}
