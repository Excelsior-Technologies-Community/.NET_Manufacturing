@model Manufacturing.Models.MachineAllocation

@{
    ViewData["Title"] = $"Machine Allocation Ticket ALLOC-{Model.AllocationId.ToString("D4")} Details";

    string getStatusBadgeClass(string? status)
    {
        switch (status?.Trim().ToLower())
        {
            case "allocated":
            case "scheduled":
                return "bg-primary text-white";
            case "in progress":
            case "running":
            case "active":
                return "bg-warning text-dark";
            case "completed":
            case "released":
                return "bg-success text-white";
            case "cancelled":
            case "rejected":
                return "bg-danger text-white";
            default:
                return "bg-secondary text-white";
        }
    }

    var statusBadgeClass = getStatusBadgeClass(Model.Status);
    var machineNameDisplay = string.IsNullOrEmpty(Model.MachineName) ? $"Machine #{Model.MachineId}" : Model.MachineName;
    var orderNoDisplay = string.IsNullOrEmpty(Model.OrderNo) ? $"PO-#{Model.ProductionOrderId}" : Model.OrderNo;
    var allocatedByDisplay = string.IsNullOrEmpty(Model.AllocatedBy) ? "Machine Supervisor" : Model.AllocatedBy;
    var startTimeText = DateTime.Today.Add(Model.StartTime).ToString("hh:mm tt");
    var endTimeText = Model.EndTime.HasValue ? DateTime.Today.Add(Model.EndTime.Value).ToString("hh:mm tt") : "Ongoing / Open";
    var remarksDisplay = string.IsNullOrEmpty(Model.Remarks) ? "No operational notes recorded for this allocation ticket." : Model.Remarks;
}

<div class="container-fluid px-4 py-4">
    <!-- Top Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0284c7 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-info text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Machine Supervisor Audit</span>
                <span class="badge bg-white bg-opacity-25 text-white px-3 py-1 rounded-pill fs-7">Allocation Ticket #ALLOC-@Model.AllocationId.ToString("D4")</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-cpu text-info me-2 fs-2"></i> Machine Allocation Specifications
            </h2>
            <p class="text-slate-300 mb-0 opacity-85">
                Detailed record of equipment time schedule, production order binding, and shift allocation log.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model.AllocationId" class="btn btn-light rounded-pill px-3 py-2 shadow-sm text-dark fw-semibold">
                <i class="bi bi-pencil-square me-1 text-primary"></i> Edit Ticket
            </a>
            <a asp-action="Delete" asp-route-id="@Model.AllocationId" onclick="return confirm('Are you sure you want to delete this machine allocation record?');" class="btn btn-outline-danger btn-light rounded-pill px-3 py-2">
                <i class="bi bi-trash me-1"></i> Delete
            </a>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Roster
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Details Card -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-receipt-cutoff text-info fs-5"></i>
                        <h5 class="fw-bold text-dark mb-0">Ticket Overview: ALLOC-@Model.AllocationId.ToString("D4")</h5>
                    </div>
                    <span class="badge @statusBadgeClass rounded-pill px-3 py-2 fs-7">
                        <i class="bi bi-tag-fill me-1"></i>@(string.IsNullOrEmpty(Model.Status) ? "Allocated" : Model.Status)
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <!-- Equipment / Machine Info -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Equipment / Machine</small>
                                <div class="fs-5 fw-bold text-dark">
                                    <i class="bi bi-cpu me-2 text-primary"></i>@machineNameDisplay
                                </div>
                                <div class="small text-muted mt-1">Machine ID: #@Model.MachineId</div>
                            </div>
                        </div>

                        <!-- Production Order -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Production Order Reference</small>
                                <div class="fs-5 fw-bold text-primary">
                                    <i class="bi bi-gear-wide me-2"></i>@orderNoDisplay
                                </div>
                                <div class="small text-muted mt-1">Order ID: #@Model.ProductionOrderId</div>
                            </div>
                        </div>

                        <!-- Allocation Date -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Allocation Date</small>
                                <div class="fs-6 fw-bold text-dark">
                                    <i class="bi bi-calendar-check me-1 text-primary"></i>@Model.AllocationDate.ToString("MMM dd, yyyy")
                                </div>
                            </div>
                        </div>

                        <!-- Shift Timings -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Allocated Shift Time Range</small>
                                <div class="fs-6 fw-bold text-info">
                                    <i class="bi bi-clock me-1"></i>@startTimeText - @endTimeText
                                </div>
                            </div>
                        </div>

                        <!-- Allocated By -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Allocated By (Authorizer)</small>
                                <div class="fs-6 fw-semibold text-dark">
                                    <i class="bi bi-person-check me-2 text-success"></i>@allocatedByDisplay
                                </div>
                            </div>
                        </div>

                        <!-- System Creation Timestamp -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">System Audit Timestamp</small>
                                <div class="fs-6 fw-semibold text-dark">
                                    <i class="bi bi-clock-history me-2 text-info"></i>
                                    @(Model.CreatedDate != DateTime.MinValue ? Model.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss") : "N/A")
                                </div>
                            </div>
                        </div>

                        <!-- Remarks & Notes -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Remarks & Operational Notes</small>
                                <div class="text-dark">@remarksDisplay</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light py-3 px-4 border-top d-flex justify-content-between align-items-center text-muted small">
                    <div>
                        <i class="bi bi-shield-check text-success me-1"></i> Machine Supervisor Control System Audit Roster
                    </div>
                    <button type="button" onclick="window.print();" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-printer me-1"></i> Print Ticket
                    </button>
                </div>
            </div>
        </div>

        <!-- Sidebar / Action Card -->
        <div class="col-lg-4">
            <!-- Quick Actions Panel -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Ticket Actions
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.AllocationId" class="btn btn-primary rounded-pill py-2 text-start px-3 fw-semibold">
                            <i class="bi bi-pencil-square me-2"></i> Modify Ticket Details
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.AllocationId" onclick="return confirm('Are you sure you want to delete this machine allocation record?');" class="btn btn-outline-danger rounded-pill py-2 text-start px-3 fw-semibold">
                            <i class="bi bi-trash me-2"></i> Delete Allocation Ticket
                        </a>
                        <a asp-action="Create" class="btn btn-outline-info rounded-pill py-2 text-start px-3 fw-semibold text-dark">
                            <i class="bi bi-plus-circle me-2"></i> Allocate New Machine
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2 text-start px-3">
                            <i class="bi bi-list-columns me-2"></i> Return to Allocation Roster
                        </a>
                    </div>
                </div>
            </div>

            <!-- Summary Meta -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-info-square me-2 text-info"></i> Allocation Metadata</h6>
                <ul class="list-unstyled mb-0 text-muted small">
                    <li class="mb-2 d-flex justify-content-between">
                        <span>Allocation ID:</span>
                        <strong class="text-dark">#@Model.AllocationId</strong>
                    </li>
                    <li class="mb-2 d-flex justify-content-between">
                        <span>Machine ID:</span>
                        <strong class="text-dark">#@Model.MachineId</strong>
                    </li>
                    <li class="mb-2 d-flex justify-content-between">
                        <span>Production Order ID:</span>
                        <strong class="text-dark">#@Model.ProductionOrderId</strong>
                    </li>
                    <li class="d-flex justify-content-between">
                        <span>Status:</span>
                        <strong class="text-dark">@(string.IsNullOrEmpty(Model.Status) ? "Allocated" : Model.Status)</strong>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
