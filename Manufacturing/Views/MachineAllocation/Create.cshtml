@model Manufacturing.Models.MachineAllocation

@{
    ViewData["Title"] = "Allocate Machine - Machine Supervisor Portal";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">
            <!-- Navigation Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-info text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Machine Supervisor Portal</span>
                        <span class="badge bg-primary text-white px-3 py-1 rounded-pill fs-7">New Time Allocation</span>
                    </div>
                    <h3 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-plus-circle-fill text-info me-2"></i> Allocate Equipment to Order
                    </h3>
                    <p class="text-muted mb-0 small">Schedule equipment time allocation for active manufacturing production orders.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Back to Roster
                </a>
            </div>

            <!-- Form Card -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="card-header text-white p-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0284c7 100%);">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h5 class="fw-bold mb-1"><i class="bi bi-cpu me-2 text-info"></i> Machine Allocation Specification</h5>
                            <p class="mb-0 opacity-85 small">Please specify machine, production order, shift date and operation time range.</p>
                        </div>
                        <i class="bi bi-calendar-event fs-1 opacity-50"></i>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post" id="createAllocationForm">
                        <div asp-validation-summary="All" class="alert alert-danger rounded-3 mb-4"></div>

                        <!-- Hidden Required Model Fields to Ensure ModelState.IsValid Passes -->
                        <input type="hidden" asp-for="MachineName" value="@(string.IsNullOrEmpty(Model?.MachineName) ? "N/A" : Model.MachineName)" />
                        <input type="hidden" asp-for="OrderNo" value="@(string.IsNullOrEmpty(Model?.OrderNo) ? "N/A" : Model.OrderNo)" />
                        <input type="hidden" asp-for="CreatedDate" value="@(Model?.CreatedDate != DateTime.MinValue ? Model?.CreatedDate.ToString("yyyy-MM-ddTHH:mm:ss") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss"))" />

                        <div class="row g-3">
                            <!-- Machine Selection -->
                            <div class="col-12 col-md-6">
                                <label asp-for="MachineId" class="form-label fw-semibold text-dark">Select Equipment / Machine <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-cpu"></i></span>
                                    <select asp-for="MachineId" asp-items="@ViewBag.MachineList" class="form-select border-start-0 py-2 rounded-end-3" id="machineSelect" required>
                                        <option value="">-- Choose Machine --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="MachineId" class="text-danger small"></span>
                            </div>

                            <!-- Production Order Selection -->
                            <div class="col-12 col-md-6">
                                <label asp-for="ProductionOrderId" class="form-label fw-semibold text-dark">Production Order <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-gear-wide"></i></span>
                                    <select asp-for="ProductionOrderId" asp-items="@ViewBag.OrderList" class="form-select border-start-0 py-2 rounded-end-3" id="orderSelect" required>
                                        <option value="">-- Choose Production Order --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="ProductionOrderId" class="text-danger small"></span>
                            </div>

                            <!-- Allocation Date -->
                            <div class="col-12 col-md-4">
                                <label asp-for="AllocationDate" class="form-label fw-semibold text-dark">Allocation Date <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-calendar-check"></i></span>
                                    <input asp-for="AllocationDate" type="date" class="form-control border-start-0 py-2 rounded-end-3" value="@(Model?.AllocationDate != DateTime.MinValue ? Model?.AllocationDate.ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd"))" required />
                                </div>
                                <span asp-validation-for="AllocationDate" class="text-danger small"></span>
                            </div>

                            <!-- Start Time -->
                            <div class="col-12 col-md-4">
                                <label asp-for="StartTime" class="form-label fw-semibold text-dark">Start Time <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-clock"></i></span>
                                    <input asp-for="StartTime" type="time" class="form-control border-start-0 py-2 rounded-end-3" value="@(Model?.StartTime != TimeSpan.Zero ? Model?.StartTime.ToString(@"hh\:mm") : "08:00")" required />
                                </div>
                                <span asp-validation-for="StartTime" class="text-danger small"></span>
                            </div>

                            <!-- End Time -->
                            <div class="col-12 col-md-4">
                                <label asp-for="EndTime" class="form-label fw-semibold text-dark">End Time (Optional)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-clock-history"></i></span>
                                    <input asp-for="EndTime" type="time" class="form-control border-start-0 py-2 rounded-end-3" value="@(Model?.EndTime.HasValue == true ? Model?.EndTime.Value.ToString(@"hh\:mm") : "16:00")" />
                                </div>
                                <span asp-validation-for="EndTime" class="text-danger small"></span>
                            </div>

                            <!-- Allocated By -->
                            <div class="col-12 col-md-6">
                                <label asp-for="AllocatedBy" class="form-label fw-semibold text-dark">Allocated By (Authorizer)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="AllocatedBy" class="form-control border-start-0 py-2 rounded-end-3" placeholder="e.g. Machine Supervisor" value="@(string.IsNullOrEmpty(Model?.AllocatedBy) ? "Machine Supervisor" : Model.AllocatedBy)" />
                                </div>
                                <span asp-validation-for="AllocatedBy" class="text-danger small"></span>
                            </div>

                            <!-- Status -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold text-dark">Allocation Status</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-tag"></i></span>
                                    <select asp-for="Status" class="form-select border-start-0 py-2 rounded-end-3">
                                        <option value="Allocated" selected>Allocated</option>
                                        <option value="In Progress">In Progress</option>
                                        <option value="Completed">Completed</option>
                                        <option value="Pending">Pending</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <!-- Remarks -->
                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold text-dark">Remarks / Operational Notes</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-chat-left-text"></i></span>
                                    <textarea asp-for="Remarks" class="form-control border-start-0 py-2 rounded-end-3" rows="3" placeholder="Add operational notes or instructions...">@(string.IsNullOrEmpty(Model?.Remarks) ? "N/A" : Model.Remarks)</textarea>
                                </div>
                                <span asp-validation-for="Remarks" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Form Submit / Cancel Buttons -->
                        <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4 py-2 border">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-info rounded-pill px-4 py-2 shadow-sm fw-semibold text-dark">
                                <i class="bi bi-check-circle me-1"></i> Save Machine Allocation
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
