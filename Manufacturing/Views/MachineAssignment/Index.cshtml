@model List<Manufacturing.Models.MachineAssignment>

@{
    ViewData["Title"] = "Machine Assignment Roster";

    var assignments = Model ?? new List<Manufacturing.Models.MachineAssignment>();
    int totalAssignments = assignments.Count;
    int assignedCount = assignments.Count(a => a.Status == "Assigned");
    int inProgressCount = assignments.Count(a => a.Status == "In Progress" || a.Status == "Running");
    int completedCount = assignments.Count(a => a.Status == "Completed");

    string getStatusBadgeClass(string status)
    {
        switch (status?.Trim())
        {
            case "Assigned": return "bg-primary text-white";
            case "In Progress": case "Running": return "bg-info text-dark";
            case "Completed": return "bg-success text-white";
            case "Maintenance": return "bg-warning text-dark";
            case "Cancelled": return "bg-danger text-white";
            default: return "bg-secondary text-white";
        }
    }
}

<div class="container-fluid px-3 py-3">
    <!-- TempData Success Alert -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0284c7 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-info text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Production Operations</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Manager Portal</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-cpu-fill text-info me-2 fs-2"></i> Machine Assignment Roster
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Production Manager Control: Assign equipment to production orders, monitor allocations, and update job status</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-light rounded-pill px-4 py-2 shadow-sm fw-semibold text-primary">
                <i class="bi bi-plus-circle-fill me-1"></i> New Machine Assignment
            </a>
            <a asp-controller="Account" asp-action="Dashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Assignments</div>
                        <div class="fs-3 fw-bold text-primary mb-0">@totalAssignments</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-cpu fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Active Assigned</div>
                        <div class="fs-3 fw-bold text-info mb-0">@assignedCount</div>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-play-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">In Progress</div>
                        <div class="fs-3 fw-bold text-warning mb-0">@inProgressCount</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-gear-wide-connected fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Completed</div>
                        <div class="fs-3 fw-bold text-success mb-0">@completedCount</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Machine Assignments Data Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-table me-2 text-primary"></i> Current Equipment Assignments
            </h5>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">Total: @totalAssignments Records</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th># ID</th>
                            <th>Production Order</th>
                            <th>Assigned Machine</th>
                            <th>Assigned Date</th>
                            <th class="text-center">Status</th>
                            <th>Remarks</th>
                            <th>Created Date</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (assignments.Count > 0)
                        {
                            @foreach (var item in assignments)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">#@item.AssignmentId</td>
                                    <td class="fw-semibold text-primary">
                                        <i class="bi bi-hash"></i>@(string.IsNullOrEmpty(item.OrderNo) ? item.ProductionOrderId.ToString() : item.OrderNo)
                                    </td>
                                    <td class="fw-semibold text-dark">
                                        <i class="bi bi-cpu me-1 text-info"></i>@(string.IsNullOrEmpty(item.MachineName) ? item.MachineId.ToString() : item.MachineName)
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar-event me-1"></i>@item.AssignedDate.ToString("dd-MMM-yyyy")
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @getStatusBadgeClass(item.Status) rounded-pill px-3 py-1">@item.Status</span>
                                    </td>
                                    <td>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 200px;" title="@item.Remarks">
                                            @(string.IsNullOrEmpty(item.Remarks) ? "-" : item.Remarks)
                                        </small>
                                    </td>
                                    <td>
                                        <small class="text-muted">@item.CreatedDate.ToString("dd-MMM-yyyy")</small>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.AssignmentId" class="btn btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.AssignmentId" class="btn btn-outline-primary" title="Edit Assignment">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.AssignmentId" class="btn btn-outline-danger" title="Delete Assignment" onclick="return confirm('Are you sure you want to delete this machine assignment?');">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-cpu fs-1 d-block mb-2 text-opacity-50"></i>
                                    <p class="mb-0 fs-6">No machine assignments found in database.</p>
                                    <a asp-action="Create" class="btn btn-sm btn-primary rounded-pill mt-3">
                                        <i class="bi bi-plus-circle me-1"></i> Create First Assignment
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
