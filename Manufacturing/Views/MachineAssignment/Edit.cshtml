@model Manufacturing.Models.MachineAssignment

@{
    ViewData["Title"] = "Edit Machine Assignment";
}

<div class="container-fluid px-3 py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0284c7 100%);">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Update Assignment</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-pencil-square text-warning me-2 fs-2"></i> Edit Machine Assignment #@Model.AssignmentId
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Production Manager: Modify machine allocation details, shift dates, or operational status</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Roster
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-sliders me-2 text-primary"></i> Edit Assignment Details
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="AssignmentId" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ProductionOrderId" class="form-label fw-semibold">Production Order <span class="text-danger">*</span></label>
                                <select asp-for="ProductionOrderId" asp-items="@ViewBag.OrderList" class="form-select rounded-3 py-2" required>
                                    <option value="">-- Select Production Order --</option>
                                </select>
                                <span asp-validation-for="ProductionOrderId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MachineId" class="form-label fw-semibold">Manufacturing Machine <span class="text-danger">*</span></label>
                                <select asp-for="MachineId" asp-items="@ViewBag.MachineList" class="form-select rounded-3 py-2" required>
                                    <option value="">-- Select Machine --</option>
                                </select>
                                <span asp-validation-for="MachineId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="AssignedDate" class="form-label fw-semibold">Assignment Date <span class="text-danger">*</span></label>
                                <input asp-for="AssignedDate" type="date" class="form-control rounded-3 py-2" value="@Model.AssignedDate.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="AssignedDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold">Assignment Status</label>
                                <select asp-for="Status" class="form-select rounded-3 py-2">
                                    <option value="Assigned">Assigned</option>
                                    <option value="In Progress">In Progress</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Maintenance">Maintenance</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold">Assignment Remarks & Instructions</label>
                                <textarea asp-for="Remarks" class="form-control rounded-3" rows="3" maxlength="500"></textarea>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">Cancel</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                                <i class="bi bi-save-fill me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
