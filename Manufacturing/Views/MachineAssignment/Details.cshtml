@model Manufacturing.Models.MachineAssignment

@{
    ViewData["Title"] = "Machine Assignment Details";

    string getStatusBadgeClass(string status)
    {
        switch (status?.Trim())
        {
            case "Assigned": return "bg-primary text-white";
            case "In Progress": case "Running": return "bg-info text-dark";
            case "Completed": return "bg-success text-white";
            case "Maintenance": return "bg-warning text-dark";
            case "Cancelled": return "bg-danger text-white";
            default: return "bg-secondary text-white";
        }
    }
}

<div class="container-fluid px-3 py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0284c7 100%);">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-info text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Assignment Overview</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-cpu-fill text-info me-2 fs-2"></i> Machine Assignment #@Model.AssignmentId
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Production Manager View: Comprehensive details of equipment allocation</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model.AssignmentId" class="btn btn-warning rounded-pill px-4 py-2 fw-semibold text-dark">
                <i class="bi bi-pencil-square me-1"></i> Edit Assignment
            </a>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Roster
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-info-circle me-2 text-primary"></i> Assignment Summary Card
                    </h5>
                    <span class="badge @getStatusBadgeClass(Model.Status) rounded-pill px-4 py-2 fs-6">
                        @Model.Status
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Assignment ID</small>
                                <div class="fs-5 fw-bold text-dark">#@Model.AssignmentId</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Production Order</small>
                                <div class="fs-5 fw-bold text-primary">
                                    <i class="bi bi-hash me-1"></i>@(string.IsNullOrEmpty(Model.OrderNo) ? Model.ProductionOrderId.ToString() : Model.OrderNo)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Assigned Machine</small>
                                <div class="fs-5 fw-bold text-info">
                                    <i class="bi bi-cpu me-1"></i>@(string.IsNullOrEmpty(Model.MachineName) ? Model.MachineId.ToString() : Model.MachineName)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Assignment Date</small>
                                <div class="fs-5 fw-bold text-dark">
                                    <i class="bi bi-calendar-event me-1 text-primary"></i>@Model.AssignedDate.ToString("dd-MMM-yyyy")
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Created Date</small>
                                <div class="fs-6 fw-semibold text-muted">
                                    <i class="bi bi-clock-history me-1"></i>@Model.CreatedDate.ToString("dd-MMM-yyyy hh:mm tt")
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Status</small>
                                <div>
                                    <span class="badge @getStatusBadgeClass(Model.Status) rounded-pill px-3 py-1 fs-7">
                                        @Model.Status
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1">Remarks & Operational Notes</small>
                                <p class="mb-0 text-dark fs-6" style="white-space: pre-line;">
                                    @(string.IsNullOrEmpty(Model.Remarks) ? "No remarks provided." : Model.Remarks)
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Delete" asp-route-id="@Model.AssignmentId" class="btn btn-outline-danger rounded-pill px-4" onclick="return confirm('Are you sure you want to delete this machine assignment?');">
                            <i class="bi bi-trash-fill me-1"></i> Delete Assignment
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back to Roster</a>
                            <a asp-action="Edit" asp-route-id="@Model.AssignmentId" class="btn btn-primary rounded-pill px-4 fw-semibold">
                                <i class="bi bi-pencil-square me-1"></i> Edit Assignment
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
