@model Manufacturing.Models.Employee

@{
    ViewData["Title"] = "Edit Employee - " + Model.FullName;

    var departmentList = ViewBag.DepartmentList as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var shiftList = ViewBag.ShiftList as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container-fluid px-4 py-4">

    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <a asp-action="Index" class="text-info text-decoration-none fs-7 fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Employee Directory
                </a>
                <span class="text-white-50 fs-7">• Profile Update (#@Model.EmployeeId)</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-pencil-square text-indigo" style="color: #a5b4fc;"></i> Edit Employee Profile
            </h2>
            <p class="text-white-50 mb-0 fs-6">
                Update employee profile details, designation, department transfer, shift roster, salary or employment status.
            </p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Directory
            </a>
        </div>
    </div>

    <!-- Form Container Card -->
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-white border-0 py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-person-gear text-primary"></i> Edit Information for @Model.FullName
                    </h5>
                    <span class="badge bg-light text-primary border rounded-pill px-3 py-1 fw-bold fs-7">
                        Code: @Model.EmployeeCode
                    </span>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="EmployeeId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>

                        <!-- Section 1: Basic Information -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-person-badge"></i> Basic Information
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="EmployeeCode" class="form-label fw-semibold text-dark">
                                        Employee Code <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-barcode"></i></span>
                                        <input asp-for="EmployeeCode" class="form-control" placeholder="e.g. EMP-101" required />
                                    </div>
                                    <span asp-validation-for="EmployeeCode" class="text-danger fs-8"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label fw-semibold text-dark">
                                        Full Name <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                        <input asp-for="FullName" class="form-control" placeholder="Enter full employee name" required />
                                    </div>
                                    <span asp-validation-for="FullName" class="text-danger fs-8"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="Gender" class="form-label fw-semibold text-dark">Gender</label>
                                    <select asp-for="Gender" class="form-select">
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger fs-8"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="Mobile" class="form-label fw-semibold text-dark">Mobile Number</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-phone"></i></span>
                                        <input asp-for="Mobile" class="form-control" placeholder="e.g. +1 555-0199" />
                                    </div>
                                    <span asp-validation-for="Mobile" class="text-danger fs-8"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="Email" class="form-label fw-semibold text-dark">Email Address</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                        <input asp-for="Email" type="email" class="form-control" placeholder="employee@factory.com" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger fs-8"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-25" />

                        <!-- Section 2: Organizational Details -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-success mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-building"></i> Department & Roster Assignment
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="DepartmentId" class="form-label fw-semibold text-dark">
                                        Department <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="DepartmentId" class="form-select" asp-items="departmentList" required>
                                        <option value="">-- Select Department --</option>
                                    </select>
                                    <span asp-validation-for="DepartmentId" class="text-danger fs-8"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="ShiftId" class="form-label fw-semibold text-dark">
                                        Shift Roster <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="ShiftId" class="form-select" asp-items="shiftList" required>
                                        <option value="">-- Select Shift --</option>
                                    </select>
                                    <span asp-validation-for="ShiftId" class="text-danger fs-8"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Designation" class="form-label fw-semibold text-dark">Designation / Role</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-briefcase"></i></span>
                                        <input asp-for="Designation" class="form-control" placeholder="e.g. Senior Technician, Operator" />
                                    </div>
                                    <span asp-validation-for="Designation" class="text-danger fs-8"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="JoinDate" class="form-label fw-semibold text-dark">Joining Date</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-calendar3"></i></span>
                                        <input asp-for="JoinDate" type="date" class="form-control" value="@(Model.JoinDate.HasValue ? Model.JoinDate.Value.ToString("yyyy-MM-dd") : "")" />
                                    </div>
                                    <span asp-validation-for="JoinDate" class="text-danger fs-8"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="Salary" class="form-label fw-semibold text-dark">Salary ($)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-currency-dollar"></i></span>
                                        <input asp-for="Salary" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="Salary" class="text-danger fs-8"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="AttendanceStatus" class="form-label fw-semibold text-dark">Attendance Status</label>
                                    <select asp-for="AttendanceStatus" class="form-select">
                                        <option value="Present">Present</option>
                                        <option value="Absent">Absent</option>
                                        <option value="On Leave">On Leave</option>
                                        <option value="Half Day">Half Day</option>
                                    </select>
                                    <span asp-validation-for="AttendanceStatus" class="text-danger fs-8"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="Status" class="form-label fw-semibold text-dark">Employment Status</label>
                                    <select asp-for="Status" class="form-select">
                                        <option value="Active">Active</option>
                                        <option value="Inactive">Inactive</option>
                                        <option value="Terminated">Terminated</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger fs-8"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-25" />

                        <!-- Section 3: Residential Address -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-info mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-geo-alt"></i> Address Information
                            </h6>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="Address" class="form-label fw-semibold text-dark">Residential Address</label>
                                    <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter complete home or contact address"></textarea>
                                    <span asp-validation-for="Address" class="text-danger fs-8"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Form Action Buttons -->
                        <div class="d-flex justify-content-end align-items-center gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light border rounded-pill px-4 py-2 fw-semibold text-dark">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" style="background-color: #6366f1; border-color: #6366f1;">
                                <i class="bi bi-save-fill me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
