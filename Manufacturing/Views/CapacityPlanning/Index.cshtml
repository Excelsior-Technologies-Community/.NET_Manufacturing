@model List<Manufacturing.Models.CapacityPlanning>

@{
    ViewData["Title"] = "Capacity Planning Roster";

    var plans = Model ?? new List<Manufacturing.Models.CapacityPlanning>();
    int totalPlans = plans.Count;
    int optimalCount = plans.Count(p => p.CapacityStatus == "Optimal" || p.CapacityStatus == "Balanced" || p.CapacityStatus == "Feasible");
    int deficitCount = plans.Count(p => p.CapacityStatus == "Under Capacity" || p.CapacityStatus == "Deficit");
    int overloadCount = plans.Count(p => p.CapacityStatus == "Over Capacity" || p.CapacityStatus == "Overloaded");

    string getStatusBadgeClass(string? status)
    {
        switch (status?.Trim())
        {
            case "Optimal":
            case "Balanced":
            case "Feasible":
                return "bg-success text-white";
            case "Under Capacity":
            case "Deficit":
                return "bg-warning text-dark";
            case "Over Capacity":
            case "Overloaded":
                return "bg-danger text-white";
            case "Pending":
                return "bg-info text-dark";
            default:
                return "bg-secondary text-white";
        }
    }
}

<div class="container-fluid px-3 py-3">
    <!-- TempData Success Alert -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #2563eb 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Resource Planning</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Production Manager Portal</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-bar-chart-steps text-primary me-2 fs-2"></i> Capacity Planning Roster
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Production Manager Control: Evaluate available machine capacity vs required order hours and balance factory workload</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-light rounded-pill px-4 py-2 shadow-sm fw-semibold text-primary">
                <i class="bi bi-plus-circle-fill me-1"></i> New Capacity Plan
            </a>
            <a asp-controller="Account" asp-action="ProductionManagerDashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Stat/KPI Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Plans</div>
                        <div class="fs-3 fw-bold text-primary mb-0">@totalPlans</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-diagram-3-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Optimal / Feasible</div>
                        <div class="fs-3 fw-bold text-success mb-0">@optimalCount</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Under Capacity</div>
                        <div class="fs-3 fw-bold text-warning mb-0">@deficitCount</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-danger">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Overloaded / Over</div>
                        <div class="fs-3 fw-bold text-danger mb-0">@overloadCount</div>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-speedometer fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Capacity Plans Data Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h5 class="fw-bold mb-0 text-dark d-flex align-items-center">
                <i class="bi bi-list-task text-primary me-2"></i> Factory Capacity Plans
            </h5>
            <div class="d-flex flex-wrap gap-2">
                <div class="input-group input-group-sm" style="width: 250px;">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="capacitySearchInput" class="form-control bg-light border-start-0" placeholder="Search order, machine..." />
                </div>
                <select id="statusFilter" class="form-select form-select-sm" style="width: 160px;">
                    <option value="">All Statuses</option>
                    <option value="Optimal">Optimal</option>
                    <option value="Balanced">Balanced</option>
                    <option value="Under Capacity">Under Capacity</option>
                    <option value="Over Capacity">Over Capacity</option>
                    <option value="Overloaded">Overloaded</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>
        </div>

        <div class="card-body p-0">
            @if (!plans.Any())
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-bar-chart text-muted" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="fw-bold text-dark">No Capacity Plans Found</h5>
                    <p class="text-muted mb-3">Create a new capacity plan to balance machine availability and workload demands.</p>
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2">
                        <i class="bi bi-plus-circle-fill me-1"></i> Add First Capacity Plan
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="capacityTable">
                        <thead class="bg-light text-muted small text-uppercase fw-bold">
                            <tr>
                                <th class="ps-4" style="width: 80px;">ID</th>
                                <th>Production Order</th>
                                <th>Machine Name</th>
                                <th class="text-end">Available Hrs</th>
                                <th class="text-end">Required Hrs</th>
                                <th class="text-end">Variance</th>
                                <th class="text-center">Status</th>
                                <th>Planning Date</th>
                                <th>Remarks</th>
                                <th class="text-end pe-4" style="width: 170px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in plans)
                            {
                                decimal variance = item.AvailableHours - item.RequiredHours;
                                string varianceClass = variance >= 0 ? "text-success fw-bold" : "text-danger fw-bold";
                                string variancePrefix = variance > 0 ? "+" : "";

                                <tr class="capacity-row">
                                    <td class="ps-4 fw-bold text-dark">
                                        #@item.CapacityPlanId
                                    </td>
                                    <td>
                                        <div class="fw-bold text-primary">
                                            <i class="bi bi-hash me-1"></i>@(string.IsNullOrEmpty(item.OrderNo) ? $"Order #{item.ProductionOrderId}" : item.OrderNo)
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">
                                            <i class="bi bi-cpu me-1 text-info"></i>@(string.IsNullOrEmpty(item.MachineName) ? $"Machine #{item.MachineId}" : item.MachineName)
                                        </div>
                                    </td>
                                    <td class="text-end fw-semibold text-dark">
                                        @item.AvailableHours.ToString("N1") hrs
                                    </td>
                                    <td class="text-end fw-semibold text-dark">
                                        @item.RequiredHours.ToString("N1") hrs
                                    </td>
                                    <td class="text-end @varianceClass">
                                        @variancePrefix@variance.ToString("N1") hrs
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @getStatusBadgeClass(item.CapacityStatus) rounded-pill px-3 py-1 fs-7">
                                            @(string.IsNullOrEmpty(item.CapacityStatus) ? "Pending" : item.CapacityStatus)
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar-event me-1"></i>@item.PlanningDate.ToString("dd-MMM-yyyy")
                                        </small>
                                    </td>
                                    <td>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 160px;" title="@item.Remarks">
                                            @(string.IsNullOrEmpty(item.Remarks) ? "-" : item.Remarks)
                                        </small>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm rounded-pill shadow-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.CapacityPlanId" class="btn btn-outline-info" title="View Details">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.CapacityPlanId" class="btn btn-outline-primary" title="Edit Plan">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.CapacityPlanId" class="btn btn-outline-danger" title="Delete Plan" onclick="return confirm('Are you sure you want to delete Capacity Plan #@item.CapacityPlanId?');">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('capacitySearchInput');
            const statusFilter = document.getElementById('statusFilter');
            const rows = document.querySelectorAll('#capacityTable tbody .capacity-row');

            function filterTable() {
                const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
                const selectedStatus = statusFilter ? statusFilter.value.toLowerCase().trim() : '';

                rows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    const statusCell = row.children[6].innerText.toLowerCase().trim();

                    const matchesSearch = text.includes(query);
                    const matchesStatus = !selectedStatus || statusCell.includes(selectedStatus);

                    if (matchesSearch && matchesStatus) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            if (searchInput) searchInput.addEventListener('keyup', filterTable);
            if (statusFilter) statusFilter.addEventListener('change', filterTable);
        });
    </script>
}
