@model Manufacturing.Models.CapacityPlanning

@{
    ViewData["Title"] = "New Capacity Plan";
}

<div class="container-fluid px-3 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #2563eb 100%);">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Resource Planning</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Production Manager Portal</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-plus-circle-fill text-primary me-2 fs-2"></i> Create Capacity Plan
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Production Manager: Map required order workload against available machine capacity</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Roster
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3 px-4 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-bar-chart-steps text-primary me-2"></i> Capacity Planning Details Form
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ProductionOrderId" class="form-label fw-semibold">Production Order <span class="text-danger">*</span></label>
                                <select asp-for="ProductionOrderId" asp-items="@(ViewBag.OrderList as List<SelectListItem>)" class="form-select rounded-3 py-2" required>
                                    <option value="">-- Select Production Order --</option>
                                </select>
                                <span asp-validation-for="ProductionOrderId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MachineId" class="form-label fw-semibold">Target Machine <span class="text-danger">*</span></label>
                                <select asp-for="MachineId" asp-items="@(ViewBag.MachineList as List<SelectListItem>)" class="form-select rounded-3 py-2" required>
                                    <option value="">-- Select Machine --</option>
                                </select>
                                <span asp-validation-for="MachineId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="AvailableHours" class="form-label fw-semibold">Available Machine Hours <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input asp-for="AvailableHours" id="availHours" type="number" step="0.1" min="0" class="form-control rounded-start-3 py-2" placeholder="e.g. 40.0" required />
                                    <span class="input-group-text bg-light">Hours</span>
                                </div>
                                <span asp-validation-for="AvailableHours" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="RequiredHours" class="form-label fw-semibold">Required Order Hours <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input asp-for="RequiredHours" id="reqHours" type="number" step="0.1" min="0" class="form-control rounded-start-3 py-2" placeholder="e.g. 32.5" required />
                                    <span class="input-group-text bg-light">Hours</span>
                                </div>
                                <span asp-validation-for="RequiredHours" class="text-danger small"></span>
                            </div>

                            <!-- Live Capacity Variance Helper Box -->
                            <div class="col-12">
                                <div class="alert alert-light border rounded-3 p-3 mb-0 d-flex align-items-center justify-content-between" id="calcBox">
                                    <div>
                                        <small class="text-muted text-uppercase fw-semibold d-block">Workload Utilization & Variance</small>
                                        <span id="varianceText" class="fw-bold fs-6 text-dark">Enter Available and Required Hours to calculate variance...</span>
                                    </div>
                                    <div id="utilBadgeContainer">
                                        <span class="badge bg-secondary rounded-pill px-3 py-2 fs-7" id="utilBadge">N/A</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CapacityStatus" class="form-label fw-semibold">Capacity Plan Status <span class="text-danger">*</span></label>
                                <select asp-for="CapacityStatus" id="capacityStatus" class="form-select rounded-3 py-2" required>
                                    <option value="Optimal">Optimal (Available >= Required)</option>
                                    <option value="Balanced">Balanced</option>
                                    <option value="Under Capacity">Under Capacity (Surplus available)</option>
                                    <option value="Over Capacity">Over Capacity (Overloaded)</option>
                                    <option value="Pending">Pending Evaluation</option>
                                </select>
                                <span asp-validation-for="CapacityStatus" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PlanningDate" class="form-label fw-semibold">Planning Date <span class="text-danger">*</span></label>
                                <input asp-for="PlanningDate" type="date" class="form-control rounded-3 py-2" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="PlanningDate" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold">Planning Remarks & Bottleneck Notes</label>
                                <textarea asp-for="Remarks" class="form-control rounded-3" rows="3" maxlength="500" placeholder="Enter notes on machine load, maintenance windows, shift availability or production constraints..."></textarea>
                                <span asp-validation-for="Remarks" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">Cancel</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                                <i class="bi bi-check-circle-fill me-1"></i> Save Capacity Plan
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const availInput = document.getElementById('availHours');
            const reqInput = document.getElementById('reqHours');
            const varianceText = document.getElementById('varianceText');
            const utilBadge = document.getElementById('utilBadge');
            const statusSelect = document.getElementById('capacityStatus');

            function updateCalc() {
                const avail = parseFloat(availInput.value);
                const req = parseFloat(reqInput.value);

                if (!isNaN(avail) && !isNaN(req) && avail > 0) {
                    const diff = avail - req;
                    const util = ((req / avail) * 100).toFixed(1);

                    if (diff >= 0) {
                        varianceText.innerHTML = `Surplus Capacity: <span class="text-success">+${diff.toFixed(1)} hrs</span> (${util}% load)`;
                        utilBadge.className = 'badge bg-success rounded-pill px-3 py-2 fs-7';
                        utilBadge.textContent = `${util}% Utilization (Optimal)`;
                        if (statusSelect.value === 'Pending' || statusSelect.value === 'Over Capacity') {
                            statusSelect.value = 'Optimal';
                        }
                    } else {
                        varianceText.innerHTML = `Capacity Deficit: <span class="text-danger">${diff.toFixed(1)} hrs</span> (${util}% load)`;
                        utilBadge.className = 'badge bg-danger rounded-pill px-3 py-2 fs-7';
                        utilBadge.textContent = `${util}% Utilization (Overloaded)`;
                        statusSelect.value = 'Over Capacity';
                    }
                } else {
                    varianceText.textContent = 'Enter Available and Required Hours to calculate variance...';
                    utilBadge.className = 'badge bg-secondary rounded-pill px-3 py-2 fs-7';
                    utilBadge.textContent = 'N/A';
                }
            }

            if (availInput && reqInput) {
                availInput.addEventListener('input', updateCalc);
                reqInput.addEventListener('input', updateCalc);
            }
        });
    </script>
}
