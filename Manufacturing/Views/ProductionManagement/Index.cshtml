@model List<Manufacturing.Models.ProductionOrder>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Production Orders - Admin Management";

    var sessionRole = HttpContextAccessor.HttpContext?.Session.GetString("Role") ?? "Admin";

    string getPriorityBadgeClass(string priority)
    {
        switch (priority?.Trim())
        {
            case "Critical": return "bg-danger text-white";
            case "High": return "bg-danger text-white bg-opacity-75";
            case "Medium": return "bg-warning text-dark";
            case "Low": return "bg-info text-dark";
            default: return "bg-secondary text-white";
        }
    }

    string getStatusBadgeClass(string status)
    {
        switch (status?.Trim())
        {
            case "Approved": return "bg-success text-white";
            case "Completed": return "bg-success bg-opacity-10 text-success border border-success";
            case "In Progress": return "bg-primary bg-opacity-10 text-primary border border-primary";
            case "Pending": return "bg-warning bg-opacity-10 text-warning border border-warning";
            case "Cancelled": return "bg-danger bg-opacity-10 text-danger border border-danger";
            default: return "bg-dark bg-opacity-10 text-dark border border-dark";
        }
    }

    int totalOrders = Model != null ? Model.Count : 0;
    int pendingOrders = Model != null ? Model.Count(o => o.Status == "Pending" || string.IsNullOrEmpty(o.Status)) : 0;
    int approvedOrders = Model != null ? Model.Count(o => o.Status == "Approved") : 0;
    int inProgressOrders = Model != null ? Model.Count(o => o.Status == "In Progress") : 0;
    int cancelledOrders = Model != null ? Model.Count(o => o.Status == "Cancelled") : 0;
}

<div class="container-fluid px-3 py-3">
    <!-- TempData Success Alert -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Admin Portal</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Production Operations</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-gear-wide-connected text-primary me-2 fs-2"></i> Production Orders Management
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Admin Control Panel: Schedule, approve, edit, and track manufacturing production orders</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-semibold">
                <i class="bi bi-plus-circle-fill me-1"></i> New Production Order
            </a>
            <a asp-controller="Account" asp-action="Dashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Admin KPI Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Orders</div>
                        <div class="fs-3 fw-bold text-dark mb-0">@totalOrders</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-boxes fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Pending Approval</div>
                        <div class="fs-3 fw-bold text-warning mb-0">@pendingOrders</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Approved Orders</div>
                        <div class="fs-3 fw-bold text-success mb-0">@approvedOrders</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-check2-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">In Progress</div>
                        <div class="fs-3 fw-bold text-info mb-0">@inProgressOrders</div>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-arrow-repeat fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Production Orders Data Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <!-- Header & Filter Bar -->
        <div class="card-header bg-white border-0 py-3 px-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h5 class="fw-bold mb-1 text-dark">
                        <i class="bi bi-list-task me-2 text-primary"></i>All Production Orders Directory
                    </h5>
                    <small class="text-muted">Admin Controls: Review specs, approve pending items, or modify active schedules.</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="input-group input-group-sm" style="max-width: 260px;">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="orderSearchInput" class="form-control border-start-0 ps-0" placeholder="Search order or product..." onkeyup="filterOrdersTable()" />
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 rounded-pill fw-semibold">
                        Count: @totalOrders
                    </span>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="ordersTable">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Order No</th>
                            <th>Product Name & Qty</th>
                            <th>Schedule</th>
                            <th>Priority</th>
                            <th class="text-center">Status</th>
                            <th>Approved By</th>
                            <th>Created By</th>
                            <th>Remarks</th>
                            <th class="text-end pe-4" style="min-width: 220px;">Admin Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <!-- Order Number -->
                                    <td class="ps-4 fw-bold">
                                        <span class="badge bg-light text-dark border px-2 py-1 fs-7">
                                            <i class="bi bi-hash text-primary"></i>@order.OrderNo
                                        </span>
                                    </td>

                                    <!-- Product Name & Quantity -->
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 me-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; flex-shrink: 0;">
                                                <i class="bi bi-box-seam-fill fs-6"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@order.ProductName</span>
                                                <small class="text-muted fw-semibold">
                                                    Quantity: <span class="text-primary fw-bold">@order.Quantity</span> @(string.IsNullOrEmpty(order.Unit) ? "Units" : order.Unit)
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Start & End Date -->
                                    <td>
                                        <small class="d-block text-muted">
                                            <i class="bi bi-calendar-event me-1 text-primary"></i>Start: @(order.StartDate.HasValue ? order.StartDate.Value.ToString("dd MMM yyyy") : "N/A")
                                        </small>
                                        <small class="d-block text-muted">
                                            <i class="bi bi-calendar-check me-1 text-success"></i>End: @(order.EndDate.HasValue ? order.EndDate.Value.ToString("dd MMM yyyy") : "N/A")
                                        </small>
                                    </td>

                                    <!-- Priority Badge -->
                                    <td>
                                        <span class="badge @getPriorityBadgeClass(order.Priority) rounded-pill px-3 py-1 fw-medium">
                                            @order.Priority
                                        </span>
                                    </td>

                                    <!-- Status Badge -->
                                    <td class="text-center">
                                        <span class="badge @getStatusBadgeClass(order.Status) rounded-pill px-3 py-1 fw-semibold">
                                            @(string.IsNullOrEmpty(order.Status) ? "Pending" : order.Status)
                                        </span>
                                    </td>

                                    <!-- Approved By & Date -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(order.ApprovedBy))
                                        {
                                            <small class="d-block fw-semibold text-success">
                                                <i class="bi bi-shield-check me-1"></i>@order.ApprovedBy
                                            </small>
                                            <small class="d-block text-muted" style="font-size: 0.75rem;">
                                                @(order.ApprovedDate.HasValue ? order.ApprovedDate.Value.ToString("dd MMM yyyy, HH:mm") : "-")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border px-2 py-1 fs-7">
                                                <i class="bi bi-clock me-1"></i>Not Approved
                                            </span>
                                        }
                                    </td>

                                    <!-- Created By & Date -->
                                    <td>
                                        <small class="d-block fw-semibold text-secondary">
                                            <i class="bi bi-person me-1"></i>@(string.IsNullOrEmpty(order.CreatedBy) ? "System" : order.CreatedBy)
                                        </small>
                                        <small class="d-block text-muted" style="font-size: 0.75rem;">
                                            @order.CreatedDate.ToString("dd MMM yyyy, HH:mm")
                                        </small>
                                    </td>

                                    <!-- Remarks -->
                                    <td class="text-truncate" style="max-width: 160px;" title="@order.Remarks">
                                        <small class="text-muted">@(string.IsNullOrEmpty(order.Remarks) ? "-" : order.Remarks)</small>
                                    </td>

                                    <!-- Admin Action Buttons -->
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Admin Order Actions">
                                            <!-- Approve Action Button -->
                                            @if (order.Status != "Approved" && order.Status != "Cancelled")
                                            {
                                                <a asp-action="Approve" asp-route-id="@order.ProductionOrderId" 
                                                   class="btn btn-outline-success" 
                                                   title="Approve Production Order"
                                                   onclick="return confirm('Confirm Admin approval for Order #@order.OrderNo?');">
                                                    <i class="bi bi-check-lg"></i> Approve
                                                </a>
                                            }

                                            <!-- Edit Action Button -->
                                            <a asp-action="Edit" asp-route-id="@order.ProductionOrderId" 
                                               class="btn btn-outline-primary" 
                                               title="Edit Order Details">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>

                                            <!-- Cancel Action Button -->
                                            @if (order.Status != "Cancelled" && order.Status != "Completed")
                                            {
                                                <a asp-action="Cancel" asp-route-id="@order.ProductionOrderId" 
                                                   class="btn btn-outline-danger" 
                                                   title="Cancel Order"
                                                   onclick="return confirm('Are you sure you want to cancel Order #@order.OrderNo?');">
                                                    <i class="bi bi-x-lg"></i> Cancel
                                                </a>
                                            }

                                            <!-- View Details Modal Trigger Button -->
                                            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#detailsModal-@order.ProductionOrderId" title="View Specifications">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>

                                        <!-- Order Details Modal -->
                                        <div class="modal fade text-start" id="detailsModal-@order.ProductionOrderId" tabindex="-1" aria-labelledby="detailsModalLabel-@order.ProductionOrderId" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow-lg rounded-4">
                                                    <div class="modal-header bg-dark text-white rounded-top-4">
                                                        <h5 class="modal-title fw-bold" id="detailsModalLabel-@order.ProductionOrderId">
                                                            <i class="bi bi-info-circle text-primary me-2"></i>Order Specifications: #@order.OrderNo
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <div class="row g-3">
                                                            <div class="col-6">
                                                                <small class="text-muted d-block">Order ID</small>
                                                                <span class="fw-bold">#@order.ProductionOrderId</span>
                                                            </div>
                                                            <div class="col-6">
                                                                <small class="text-muted d-block">Order Number</small>
                                                                <span class="fw-bold text-primary">@order.OrderNo</span>
                                                            </div>
                                                            <div class="col-12">
                                                                <small class="text-muted d-block">Product Name</small>
                                                                <span class="fw-bold text-dark fs-6">@order.ProductName</span>
                                                            </div>
                                                            <div class="col-6">
                                                                <small class="text-muted d-block">Quantity</small>
                                                                <span class="fw-bold">@order.Quantity @(string.IsNullOrEmpty(order.Unit) ? "Units" : order.Unit)</span>
                                                            </div>
                                                            <div class="col-6">
                                                                <small class="text-muted d-block">Priority Level</small>
                                                                <span class="badge @getPriorityBadgeClass(order.Priority) rounded-pill px-3 py-1">@order.Priority</span>
                                                            </div>
                                                            <div class="col-6">
                                                                <small class="text-muted d-block">Current Status</small>
                                                                <span class="badge @getStatusBadgeClass(order.Status) rounded-pill px-3 py-1">@(string.IsNullOrEmpty(order.Status) ? "Pending" : order.Status)</span>
                                                            </div>
                                                            <div class="col-6">
                                                                <small class="text-muted d-block">Approved By</small>
                                                                <span class="fw-semibold text-success">@(string.IsNullOrEmpty(order.ApprovedBy) ? "Not Approved" : order.ApprovedBy)</span>
                                                            </div>
                                                            <div class="col-6">
                                                                <small class="text-muted d-block">Start Date</small>
                                                                <span>@(order.StartDate.HasValue ? order.StartDate.Value.ToString("dd MMM yyyy") : "N/A")</span>
                                                            </div>
                                                            <div class="col-6">
                                                                <small class="text-muted d-block">Expected End Date</small>
                                                                <span>@(order.EndDate.HasValue ? order.EndDate.Value.ToString("dd MMM yyyy") : "N/A")</span>
                                                            </div>
                                                            <div class="col-6">
                                                                <small class="text-muted d-block">Created By</small>
                                                                <span>@(string.IsNullOrEmpty(order.CreatedBy) ? "System" : order.CreatedBy)</span>
                                                            </div>
                                                            <div class="col-6">
                                                                <small class="text-muted d-block">Created Date</small>
                                                                <span>@order.CreatedDate.ToString("dd MMM yyyy, HH:mm")</span>
                                                            </div>
                                                            <div class="col-12">
                                                                <small class="text-muted d-block">Remarks / Notes</small>
                                                                <div class="p-3 bg-light rounded-3 border text-secondary small">
                                                                    @(string.IsNullOrEmpty(order.Remarks) ? "No special instructions provided." : order.Remarks)
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-light rounded-bottom-4">
                                                        <a asp-action="Edit" asp-route-id="@order.ProductionOrderId" class="btn btn-primary rounded-pill px-4">
                                                            <i class="bi bi-pencil-square me-1"></i> Edit Order
                                                        </a>
                                                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                                    <h5>No Production Orders Found</h5>
                                    <p class="mb-3">Get started by creating your first manufacturing production order.</p>
                                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2">
                                        <i class="bi bi-plus-circle-fill me-1"></i> Create Production Order
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterOrdersTable() {
            var input = document.getElementById("orderSearchInput");
            var filter = input.value.toLowerCase();
            var table = document.getElementById("ordersTable");
            var tr = table.getElementsByTagName("tr");

            for (var i = 1; i < tr.length; i++) {
                var rowText = tr[i].textContent || tr[i].innerText;
                if (rowText.toLowerCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    </script>
}
