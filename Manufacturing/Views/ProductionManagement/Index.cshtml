@model List<Manufacturing.Models.ProductionOrder>

@{
    ViewData["Title"] = "Production Orders";

    string getPriorityBadgeClass(string priority)
    {
        switch (priority?.Trim())
        {
            case "Critical": return "bg-danger text-white";
            case "High": return "bg-danger text-white bg-opacity-75";
            case "Medium": return "bg-warning text-dark";
            case "Low": return "bg-info text-dark";
            default: return "bg-secondary text-white";
        }
    }

    string getStatusBadgeClass(string status)
    {
        switch (status?.Trim())
        {
            case "Completed": return "bg-success bg-opacity-10 text-success border border-success";
            case "In Progress": return "bg-primary bg-opacity-10 text-primary border border-primary";
            case "Pending": return "bg-warning bg-opacity-10 text-warning border border-warning";
            case "Cancelled": return "bg-secondary bg-opacity-10 text-secondary border border-secondary";
            default: return "bg-dark bg-opacity-10 text-dark border border-dark";
        }
    }
}

<div class="container-fluid px-3 py-3">
    <!-- Page Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
        <div class="mb-3 mb-md-0">
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-gear-wide-connected text-primary me-2 fs-2"></i> Production Orders
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Admin Operations: Track, manage, and schedule manufacturing orders</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-semibold me-2">
                <i class="bi bi-plus-circle-fill me-1"></i> New Production Order
            </a>
            <a asp-controller="Account" asp-action="Dashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Production Orders Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-list-task me-2 text-primary"></i>All Orders Directory
            </h5>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 rounded-pill fw-semibold">
                Total Orders: @(Model != null ? Model.Count : 0)
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Order No</th>
                            <th>Product Name</th>
                            <th>Quantity</th>
                            <th>Schedule</th>
                            <th>Priority</th>
                            <th class="text-center">Status</th>
                            <th>Created By</th>
                            <th>Created Date</th>
                            <th class="pe-4">Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">
                                        <span class="badge bg-light text-dark border px-2 py-1">
                                            <i class="bi bi-hash"></i>@order.OrderNo
                                        </span>
                                    </td>
                                    <td class="fw-semibold text-dark">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 me-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                                <i class="bi bi-box-seam-fill fs-6"></i>
                                            </div>
                                            <span>@order.ProductName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-bold">@order.Quantity</span>
                                        <small class="text-muted">@(string.IsNullOrEmpty(order.Unit) ? "Units" : order.Unit)</small>
                                    </td>
                                    <td>
                                        <small class="d-block text-muted">
                                            <i class="bi bi-calendar-event me-1 text-primary"></i>Start: @(order.StartDate.HasValue ? order.StartDate.Value.ToString("dd MMM yyyy") : "N/A")
                                        </small>
                                        <small class="d-block text-muted">
                                            <i class="bi bi-calendar-check me-1 text-success"></i>End: @(order.EndDate.HasValue ? order.EndDate.Value.ToString("dd MMM yyyy") : "N/A")
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge @getPriorityBadgeClass(order.Priority) rounded-pill px-3 py-1 fw-medium">
                                            @order.Priority
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @getStatusBadgeClass(order.Status) rounded-pill px-3 py-1 fw-semibold">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td>
                                        <small class="fw-semibold text-secondary">
                                            <i class="bi bi-person me-1"></i>@(string.IsNullOrEmpty(order.CreatedBy) ? "System" : order.CreatedBy)
                                        </small>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @order.CreatedDate.ToString("dd MMM yyyy, HH:mm")
                                        </small>
                                    </td>
                                    <td class="pe-4 text-truncate" style="max-width: 180px;" title="@order.Remarks">
                                        <small class="text-muted">@(string.IsNullOrEmpty(order.Remarks) ? "-" : order.Remarks)</small>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                                    <h5>No Production Orders Found</h5>
                                    <p class="mb-3">Get started by creating your first manufacturing production order.</p>
                                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2">
                                        <i class="bi bi-plus-circle-fill me-1"></i> Create Production Order
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
