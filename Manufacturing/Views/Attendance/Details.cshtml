@model Manufacturing.Models.Attendance

@{
    ViewData["Title"] = "Attendance Details";

    string getStatusBadge(string status)
    {
        switch (status?.Trim())
        {
            case "Present": return "bg-success text-white";
            case "Absent": return "bg-danger text-white";
            case "Late": return "bg-warning text-dark";
            case "On Leave": return "bg-info text-dark";
            case "Half Day": return "bg-primary text-white";
            default: return "bg-secondary text-white";
        }
    }
}

<div class="container-fluid px-3 py-3">
    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-indigo text-white px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold" style="background-color: #6366f1;">Attendance Roster</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Details View</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-info-circle text-indigo me-2 fs-2" style="color: #a5b4fc;"></i> Attendance Record #@Model.AttendanceId
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Detailed overview of attendance log for @Model.EmployeeName</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model.AttendanceId" class="btn btn-warning rounded-pill px-4 py-2 text-dark shadow-sm">
                <i class="bi bi-pencil-square me-1"></i> Edit Record
            </a>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Roster
            </a>
        </div>
    </div>

    <!-- Details Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-person-badge-fill me-2 text-indigo" style="color: #6366f1;"></i> Attendance Summary
                    </h5>
                    <span class="badge @getStatusBadge(Model.Status) px-3 py-2 rounded-pill fs-6">
                        @Model.Status
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Employee Name</small>
                                <div class="fs-5 fw-bold text-dark">
                                    <i class="bi bi-person-circle text-primary me-2"></i>@Model.EmployeeName
                                </div>
                                <small class="text-muted">Employee ID: #@Model.EmployeeId</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Attendance Date</small>
                                <div class="fs-5 fw-bold text-dark">
                                    <i class="bi bi-calendar3 text-indigo me-2" style="color: #6366f1;"></i>@Model.AttendanceDate.ToString("dd MMMM yyyy (dddd)")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Check-In Timestamp</small>
                                <div class="fs-5 fw-bold text-success">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>
                                    @(Model.CheckInTime.HasValue ? DateTime.Today.Add(Model.CheckInTime.Value).ToString("hh:mm tt") : "Not Logged")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Check-Out Timestamp</small>
                                <div class="fs-5 fw-bold text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    @(Model.CheckOutTime.HasValue ? DateTime.Today.Add(Model.CheckOutTime.Value).ToString("hh:mm tt") : "Not Logged")
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Remarks & Audit -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-chat-left-text me-2 text-indigo" style="color: #6366f1;"></i> Remarks & Shift Notes</h6>
                        <div class="p-3 bg-light rounded-3 text-secondary">
                            @(string.IsNullOrEmpty(Model.Remarks) ? "No remarks entered for this attendance entry." : Model.Remarks)
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top text-muted small">
                        <div>
                            <i class="bi bi-clock me-1"></i> Record Created: @Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")
                        </div>
                        <div>
                            <a asp-action="Delete" asp-route-id="@Model.AttendanceId" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Are you sure you want to delete this attendance record?');">
                                <i class="bi bi-trash-fill me-1"></i> Delete Record
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
