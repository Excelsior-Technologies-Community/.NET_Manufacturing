@model List<Manufacturing.Models.MaterialRequirementPlanning>

@{
    ViewData["Title"] = "Material Requirement Planning (MRP)";

    var plans = Model ?? new List<Manufacturing.Models.MaterialRequirementPlanning>();
    int totalPlans = plans.Count;
    int sufficientCount = plans.Count(p => p.Status == "Sufficient" || p.Status == "Sufficient Stock" || p.Status == "Approved" || p.ShortageQuantity <= 0);
    int shortageCount = plans.Count(p => p.Status == "Shortage" || p.Status == "Shortage Alert" || p.ShortageQuantity > 0);
    int pendingCount = plans.Count(p => p.Status == "Pending" || p.Status == "Draft");

    string getStatusBadgeClass(string? status, int shortage)
    {
        if (shortage > 0) return "bg-danger text-white";
        switch (status?.Trim())
        {
            case "Sufficient":
            case "Sufficient Stock":
            case "Approved":
            case "Completed":
                return "bg-success text-white";
            case "Shortage":
            case "Shortage Alert":
                return "bg-danger text-white";
            case "Pending":
            case "Under Review":
                return "bg-warning text-dark";
            default:
                return "bg-secondary text-white";
        }
    }
}

<div class="container-fluid px-3 py-3">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0d9488 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-teal px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold" style="background-color: #14b8a6;">Inventory & MRP</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Production Manager Portal</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-boxes text-info me-2 fs-2"></i> Material Requirement Planning (MRP)
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Production Manager Control: Evaluate raw material requirements, monitor stock availability, and identify material shortages</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-light rounded-pill px-4 py-2 shadow-sm fw-semibold text-teal" style="color: #0f766e;">
                <i class="bi bi-plus-circle-fill me-1"></i> New MRP Requirement
            </a>
            <a asp-controller="Account" asp-action="ProductionManagerDashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total MRP Plans</div>
                        <div class="fs-3 fw-bold text-info mb-0">@totalPlans</div>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-journal-text fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Sufficient Stock</div>
                        <div class="fs-3 fw-bold text-success mb-0">@sufficientCount</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-danger">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Shortage Alerts</div>
                        <div class="fs-3 fw-bold text-danger mb-0">@shortageCount</div>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Pending Evaluation</div>
                        <div class="fs-3 fw-bold text-warning mb-0">@pendingCount</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h5 class="fw-bold mb-0 text-dark d-flex align-items-center">
                <i class="bi bi-list-task text-teal me-2" style="color: #0d9488;"></i> Material Requirements Roster
            </h5>
            <div class="d-flex flex-wrap gap-2">
                <div class="input-group input-group-sm" style="width: 250px;">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="mrpSearchInput" class="form-control bg-light border-start-0" placeholder="Search order, material..." />
                </div>
                <select id="statusFilter" class="form-select form-select-sm" style="width: 160px;">
                    <option value="">All Statuses</option>
                    <option value="Sufficient">Sufficient</option>
                    <option value="Shortage">Shortage</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>
        </div>

        <div class="card-body p-0">
            @if (!plans.Any())
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-boxes text-muted" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="fw-bold text-dark">No Material Requirements Found</h5>
                    <p class="text-muted mb-3">Create your first material requirement plan to calculate inventory stock needs.</p>
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2">
                        <i class="bi bi-plus-circle-fill me-1"></i> Add First MRP Plan
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="mrpTable">
                        <thead class="bg-light text-muted small text-uppercase fw-bold">
                            <tr>
                                <th class="ps-4" style="width: 80px;">ID</th>
                                <th>Production Order</th>
                                <th>Raw Material</th>
                                <th class="text-end">Required Qty</th>
                                <th class="text-end">Available Qty</th>
                                <th class="text-end">Shortage Qty</th>
                                <th class="text-center">Status</th>
                                <th>Planning Date</th>
                                <th>Remarks</th>
                                <th class="text-end pe-4" style="width: 170px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in plans)
                            {
                                string shortageClass = item.ShortageQuantity > 0 ? "text-danger fw-bold" : "text-success fw-bold";

                                <tr class="mrp-row">
                                    <td class="ps-4 fw-bold text-dark">
                                        #@item.MaterialPlanId
                                    </td>
                                    <td>
                                        <div class="fw-bold text-primary">
                                            <i class="bi bi-hash me-1"></i>@(string.IsNullOrEmpty(item.OrderNo) ? $"Order #{item.ProductionOrderId}" : item.OrderNo)
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">
                                            <i class="bi bi-box-seam me-1 text-info"></i>@(string.IsNullOrEmpty(item.MaterialName) ? $"Material #{item.MaterialId}" : item.MaterialName)
                                        </div>
                                    </td>
                                    <td class="text-end fw-semibold text-dark">
                                        @item.RequiredQuantity.ToString("N0")
                                    </td>
                                    <td class="text-end fw-semibold text-dark">
                                        @item.AvailableQuantity.ToString("N0")
                                    </td>
                                    <td class="text-end @shortageClass">
                                        @(item.ShortageQuantity > 0 ? $"-{item.ShortageQuantity:N0}" : "0")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @getStatusBadgeClass(item.Status, item.ShortageQuantity) rounded-pill px-3 py-1 fs-7">
                                            @(string.IsNullOrEmpty(item.Status) ? "Pending" : item.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar-event me-1"></i>@item.PlanningDate.ToString("dd-MMM-yyyy")
                                        </small>
                                    </td>
                                    <td>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 160px;" title="@item.Remarks">
                                            @(string.IsNullOrEmpty(item.Remarks) ? "-" : item.Remarks)
                                        </small>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm rounded-pill shadow-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.MaterialPlanId" class="btn btn-outline-info" title="View Details">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.MaterialPlanId" class="btn btn-outline-primary" title="Edit Requirement">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.MaterialPlanId" class="btn btn-outline-danger" title="Delete Requirement" onclick="return confirm('Are you sure you want to delete Material Plan #@item.MaterialPlanId?');">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('mrpSearchInput');
            const statusFilter = document.getElementById('statusFilter');
            const rows = document.querySelectorAll('#mrpTable tbody .mrp-row');

            function filterTable() {
                const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
                const selectedStatus = statusFilter ? statusFilter.value.toLowerCase().trim() : '';

                rows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    const statusCell = row.children[6].innerText.toLowerCase().trim();

                    const matchesSearch = text.includes(query);
                    const matchesStatus = !selectedStatus || statusCell.includes(selectedStatus);

                    if (matchesSearch && matchesStatus) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            if (searchInput) searchInput.addEventListener('keyup', filterTable);
            if (statusFilter) statusFilter.addEventListener('change', filterTable);
        });
    </script>
}
