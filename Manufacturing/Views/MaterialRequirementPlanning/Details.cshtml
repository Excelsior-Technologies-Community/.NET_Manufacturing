@model Manufacturing.Models.MaterialRequirementPlanning

@{
    ViewData["Title"] = $"MRP Plan #{Model.MaterialPlanId} Details";

    double coveragePct = Model.RequiredQuantity > 0 ? Math.Min(100.0, ((double)Model.AvailableQuantity / Model.RequiredQuantity) * 100.0) : 0;
    string coverageBarClass = coveragePct switch
    {
        >= 100 => "bg-success",
        >= 75 => "bg-info",
        >= 50 => "bg-warning",
        _ => "bg-danger"
    };

    string getStatusBadgeClass(string? status, int shortage)
    {
        if (shortage > 0) return "bg-danger text-white";
        switch (status?.Trim())
        {
            case "Sufficient":
            case "Sufficient Stock":
            case "Approved":
            case "Completed":
                return "bg-success text-white";
            case "Shortage":
            case "Shortage Alert":
                return "bg-danger text-white";
            case "Pending":
                return "bg-warning text-dark";
            default:
                return "bg-secondary text-white";
        }
    }
}

<div class="container-fluid px-3 py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0d9488 100%);">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-teal px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold" style="background-color: #14b8a6;">MRP Details</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Plan #@Model.MaterialPlanId</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-boxes text-info me-2 fs-2"></i> Material Requirement Overview
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Production Manager Control: Comprehensive raw material stock coverage & requirement breakdown</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.MaterialPlanId" class="btn btn-light rounded-pill px-3 py-2 shadow-sm fw-semibold" style="color: #0f766e;">
                <i class="bi bi-pencil-square me-1"></i> Edit Plan
            </a>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Roster
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main MRP Summary Card -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-info-circle-fill me-2 text-teal" style="color: #0d9488;"></i> Material Specification Details
                    </h5>
                    <span class="badge @getStatusBadgeClass(Model.Status, Model.ShortageQuantity) rounded-pill px-3 py-2 fs-7">
                        @Model.Status
                    </span>
                </div>
                <div class="card-body p-4">
                    <!-- Stock Coverage Progress Bar -->
                    <div class="mb-4 p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold text-dark">Stock Fulfillment Coverage</span>
                            <span class="fw-bold text-dark">@coveragePct.ToString("F1")%</span>
                        </div>
                        <div class="progress rounded-pill" style="height: 12px;">
                            <div class="progress-bar @coverageBarClass progress-bar-striped progress-bar-animated" role="progressbar" style="width: @coveragePct%;" aria-valuenow="@coveragePct" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                            <span>Required: <strong>@Model.RequiredQuantity.ToString("N0") units</strong></span>
                            <span>Available: <strong>@Model.AvailableQuantity.ToString("N0") units</strong></span>
                            <span>
                                Shortage: 
                                <strong class="@(Model.ShortageQuantity > 0 ? "text-danger" : "text-success")">
                                    @(Model.ShortageQuantity > 0 ? $"-{Model.ShortageQuantity:N0} units" : "0 units")
                                </strong>
                            </span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Production Order No</small>
                                <span class="fs-5 fw-bold text-primary">
                                    <i class="bi bi-hash"></i>@(string.IsNullOrEmpty(Model.OrderNo) ? Model.ProductionOrderId.ToString() : Model.OrderNo)
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Raw Material Name</small>
                                <span class="fs-5 fw-bold text-dark">
                                    <i class="bi bi-box-seam me-1 text-info"></i>@(string.IsNullOrEmpty(Model.MaterialName) ? Model.MaterialId.ToString() : Model.MaterialName)
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Required Quantity</small>
                                <span class="fs-4 fw-bold text-dark">@Model.RequiredQuantity.ToString("N0")</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Available Quantity</small>
                                <span class="fs-4 fw-bold text-dark">@Model.AvailableQuantity.ToString("N0")</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Shortage Quantity</small>
                                <span class="fs-4 fw-bold @(Model.ShortageQuantity > 0 ? "text-danger" : "text-success")">
                                    @(Model.ShortageQuantity > 0 ? $"-{Model.ShortageQuantity:N0}" : "0")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Planning Date</small>
                                <span class="fs-6 fw-bold text-dark">
                                    <i class="bi bi-calendar-event me-2 text-primary"></i>@Model.PlanningDate.ToString("dd MMMM yyyy")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Creation Date</small>
                                <span class="fs-6 fw-bold text-dark">
                                    <i class="bi bi-clock-history me-2 text-muted"></i>@Model.CreatedDate.ToString("dd MMMM yyyy, hh:mm tt")
                                </span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Remarks & Instructions</small>
                                <p class="mb-0 text-dark">
                                    @(string.IsNullOrEmpty(Model.Remarks) ? "No remarks or reorder notes provided for this material requirement plan." : Model.Remarks)
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side Quick Info & Action Panel -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 px-4 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-gear-fill me-2 text-teal" style="color: #0d9488;"></i> Management Actions
                    </h5>
                </div>
                <div class="card-body p-4 d-flex flex-column gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.MaterialPlanId" class="btn btn-primary rounded-pill py-2 fw-semibold w-100" style="background-color: #0d9488; border-color: #0d9488;">
                        <i class="bi bi-pencil-square me-1"></i> Edit Plan Details
                    </a>
                    <a asp-action="Create" class="btn btn-outline-primary rounded-pill py-2 fw-semibold w-100" style="color: #0d9488; border-color: #0d9488;">
                        <i class="bi bi-plus-circle me-1"></i> New Material Requirement
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold w-100">
                        <i class="bi bi-list-task me-1"></i> Return to Roster
                    </a>
                    <hr class="my-2" />
                    <a asp-action="Delete" asp-route-id="@Model.MaterialPlanId" class="btn btn-outline-danger rounded-pill py-2 fw-semibold w-100" onclick="return confirm('Are you sure you want to delete this material requirement plan?');">
                        <i class="bi bi-trash-fill me-1"></i> Delete Material Plan
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
