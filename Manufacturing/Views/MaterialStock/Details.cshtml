@model Manufacturing.Models.MaterialStock

@{
    ViewData["Title"] = $"Material Stock #{Model.StockId} Details";

    double addedPct = Model.UpdatedStock > 0 ? Math.Min(100.0, ((double)Model.AddedStock / Model.UpdatedStock) * 100.0) : 0;
}

<div class="container-fluid px-3 py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #d97706 100%);">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Stock Details</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Record #@Model.StockId</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-box-seam-fill text-warning me-2 fs-2"></i> Stock Record Overview
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Production Manager Control: Detailed raw material inventory transaction and balance audit</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.StockId" class="btn btn-light rounded-pill px-3 py-2 shadow-sm fw-semibold text-dark">
                <i class="bi bi-pencil-square me-1"></i> Edit Record
            </a>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Roster
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Stock Summary Card -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-info-circle-fill me-2 text-warning"></i> Inventory Transaction Specification
                    </h5>
                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fs-7">
                        Stock Transaction #@Model.StockId
                    </span>
                </div>
                <div class="card-body p-4">
                    <!-- Added Stock Breakdown Progress Bar -->
                    <div class="mb-4 p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold text-dark">Replenishment Increase Ratio</span>
                            <span class="fw-bold text-success">+@addedPct.ToString("F1")%</span>
                        </div>
                        <div class="progress rounded-pill" style="height: 12px;">
                            <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" role="progressbar" style="width: @addedPct%;" aria-valuenow="@addedPct" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                            <span>Initial Stock: <strong>@Model.CurrentStock.ToString("N0") units</strong></span>
                            <span>Added Stock: <strong class="text-success">+@Model.AddedStock.ToString("N0") units</strong></span>
                            <span>Updated Stock: <strong class="text-primary">@Model.UpdatedStock.ToString("N0") units</strong></span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Raw Material Name</small>
                                <span class="fs-5 fw-bold text-primary">
                                    <i class="bi bi-box-seam me-1 text-warning"></i>@(string.IsNullOrEmpty(Model.MaterialName) ? Model.MaterialId.ToString() : Model.MaterialName)
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Updated By Operator</small>
                                <span class="fs-5 fw-bold text-dark">
                                    <i class="bi bi-person me-1 text-muted"></i>@(string.IsNullOrEmpty(Model.UpdatedBy) ? "System" : Model.UpdatedBy)
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Current Stock Qty</small>
                                <span class="fs-4 fw-bold text-dark">@Model.CurrentStock.ToString("N0")</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Added Stock Qty</small>
                                <span class="fs-4 fw-bold text-success">+@Model.AddedStock.ToString("N0")</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Total Updated Stock</small>
                                <span class="fs-4 fw-bold text-info">@Model.UpdatedStock.ToString("N0")</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Updated Date</small>
                                <span class="fs-6 fw-bold text-dark">
                                    <i class="bi bi-calendar-event me-2 text-warning"></i>@Model.UpdatedDate.ToString("dd MMMM yyyy")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Creation Date</small>
                                <span class="fs-6 fw-bold text-dark">
                                    <i class="bi bi-clock-history me-2 text-muted"></i>@Model.CreatedDate.ToString("dd MMMM yyyy, hh:mm tt")
                                </span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Stock Remarks & PO Reference</small>
                                <p class="mb-0 text-dark">
                                    @(string.IsNullOrEmpty(Model.Remarks) ? "No remarks or notes provided for this stock record." : Model.Remarks)
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side Quick Info & Action Panel -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 px-4 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-gear-fill me-2 text-warning"></i> Management Actions
                    </h5>
                </div>
                <div class="card-body p-4 d-flex flex-column gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.StockId" class="btn btn-warning rounded-pill py-2 fw-semibold w-100 text-dark">
                        <i class="bi bi-pencil-square me-1"></i> Edit Stock Details
                    </a>
                    <a asp-action="Create" class="btn btn-outline-warning text-dark rounded-pill py-2 fw-semibold w-100">
                        <i class="bi bi-plus-circle me-1"></i> Add New Stock Entry
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold w-100">
                        <i class="bi bi-list-task me-1"></i> Return to Roster
                    </a>
                    <hr class="my-2" />
                    <a asp-action="Delete" asp-route-id="@Model.StockId" class="btn btn-outline-danger rounded-pill py-2 fw-semibold w-100" onclick="return confirm('Are you sure you want to delete this material stock record?');">
                        <i class="bi bi-trash-fill me-1"></i> Delete Stock Record
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
