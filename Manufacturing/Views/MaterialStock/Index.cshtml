@model List<Manufacturing.Models.MaterialStock>

@{
    ViewData["Title"] = "Material Stock Management";

    var stocks = Model ?? new List<Manufacturing.Models.MaterialStock>();
    int totalEntries = stocks.Count;
    long sumCurrentStock = stocks.Sum(s => (long)s.CurrentStock);
    long sumAddedStock = stocks.Sum(s => (long)s.AddedStock);
    long sumUpdatedStock = stocks.Sum(s => (long)s.UpdatedStock);
}

<div class="container-fluid px-3 py-3">
    <!-- TempData Success Alert -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #d97706 100%);">
        <div class="mb-3 mb-md-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill text-uppercase fs-7 fw-bold">Inventory Control</span>
                <span class="badge bg-outline-light text-white-50 border border-white-50 px-2 py-1 rounded-pill fs-7">Production Manager Portal</span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-box-seam-fill text-warning me-2 fs-2"></i> Material Stock Inventory Roster
            </h2>
            <p class="text-slate-300 mb-0 opacity-75">Production Manager Control: Track raw material inventory levels, stock updates, and replenishment transactions</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-light rounded-pill px-4 py-2 shadow-sm fw-semibold text-warning">
                <i class="bi bi-plus-circle-fill me-1"></i> Add Stock Entry
            </a>
            <a asp-controller="Account" asp-action="ProductionManagerDashboard" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Stat/KPI Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Stock Records</div>
                        <div class="fs-3 fw-bold text-warning mb-0">@totalEntries</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-card-checklist fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Current Stock</div>
                        <div class="fs-3 fw-bold text-primary mb-0">@sumCurrentStock.ToString("N0")</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-boxes fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-success">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Added Stock</div>
                        <div class="fs-3 fw-bold text-success mb-0">+@sumAddedStock.ToString("N0")</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-plus-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-info">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Updated Stock</div>
                        <div class="fs-3 fw-bold text-info mb-0">@sumUpdatedStock.ToString("N0")</div>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-arrow-repeat fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Material Stock Data Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h5 class="fw-bold mb-0 text-dark d-flex align-items-center">
                <i class="bi bi-list-task text-warning me-2"></i> Inventory Stock Updates
            </h5>
            <div class="d-flex flex-wrap gap-2">
                <div class="input-group input-group-sm" style="width: 250px;">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="stockSearchInput" class="form-control bg-light border-start-0" placeholder="Search material, updated by..." />
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            @if (!stocks.Any())
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-box-seam text-muted" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="fw-bold text-dark">No Material Stock Records Found</h5>
                    <p class="text-muted mb-3">Add a stock entry to start tracking inventory additions and balances.</p>
                    <a asp-action="Create" class="btn btn-warning rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-plus-circle-fill me-1"></i> Add First Stock Entry
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="stockTable">
                        <thead class="bg-light text-muted small text-uppercase fw-bold">
                            <tr>
                                <th class="ps-4" style="width: 80px;">ID</th>
                                <th>Raw Material</th>
                                <th class="text-end">Current Stock</th>
                                <th class="text-end">Added Stock</th>
                                <th class="text-end">Updated Stock</th>
                                <th>Updated Date</th>
                                <th>Updated By</th>
                                <th>Remarks</th>
                                <th class="text-end pe-4" style="width: 170px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in stocks)
                            {
                                <tr class="stock-row">
                                    <td class="ps-4 fw-bold text-dark">
                                        #@item.StockId
                                    </td>
                                    <td>
                                        <div class="fw-bold text-primary">
                                            <i class="bi bi-box-seam me-1 text-warning"></i>@(string.IsNullOrEmpty(item.MaterialName) ? $"Material #{item.MaterialId}" : item.MaterialName)
                                        </div>
                                    </td>
                                    <td class="text-end fw-semibold text-dark">
                                        @item.CurrentStock.ToString("N0")
                                    </td>
                                    <td class="text-end fw-bold text-success">
                                        +@item.AddedStock.ToString("N0")
                                    </td>
                                    <td class="text-end fw-bold text-info">
                                        @item.UpdatedStock.ToString("N0")
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar-event me-1"></i>@item.UpdatedDate.ToString("dd-MMM-yyyy")
                                        </small>
                                    </td>
                                    <td>
                                        <small class="fw-semibold text-dark">
                                            <i class="bi bi-person me-1 text-muted"></i>@(string.IsNullOrEmpty(item.UpdatedBy) ? "System" : item.UpdatedBy)
                                        </small>
                                    </td>
                                    <td>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 160px;" title="@item.Remarks">
                                            @(string.IsNullOrEmpty(item.Remarks) ? "-" : item.Remarks)
                                        </small>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm rounded-pill shadow-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.StockId" class="btn btn-outline-info" title="View Details">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.StockId" class="btn btn-outline-primary" title="Edit Stock">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.StockId" class="btn btn-outline-danger" title="Delete Stock Record" onclick="return confirm('Are you sure you want to delete Material Stock Record #@item.StockId?');">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('stockSearchInput');
            const rows = document.querySelectorAll('#stockTable tbody .stock-row');

            function filterTable() {
                const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

                rows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    if (text.includes(query)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            if (searchInput) searchInput.addEventListener('keyup', filterTable);
        });
    </script>
}
